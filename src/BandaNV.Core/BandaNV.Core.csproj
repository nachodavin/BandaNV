<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BandaNV.Core</RootNamespace>
  </PropertyGroup>
  <!-- Flags exclusivas de paquetes de prueba. No afectan Release oficial. -->
  <PropertyGroup Condition="'$(BandaNVUpdaterE2EBase)' == 'true'">
    <DefineConstants>$(DefineConstants);BANDANV_UPDATER_E2E_BASE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BandaNVUpdaterE2ETarget)' == 'true'">
    <DefineConstants>$(DefineConstants);BANDANV_UPDATER_E2E_TARGET</DefineConstants>
  </PropertyGroup>
</Project>
