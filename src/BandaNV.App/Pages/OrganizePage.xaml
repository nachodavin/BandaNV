<Page
    x:Class="BandaNV.App.Pages.OrganizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BandaBackgroundBrush}">

    <Grid Padding="40,32,40,48">
        <StackPanel Spacing="18">
            <StackPanel Spacing="6">
                <TextBlock Text="Organizar" Style="{StaticResource BandaSectionTitleStyle}" />
                <TextBlock Text="La vista previa de v1.0 pasa a ser una sección completa." Style="{StaticResource BandaMutedTextStyle}" />
            </StackPanel>

            <Border Style="{StaticResource BandaCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Vista previa de organización" Foreground="{StaticResource BandaTextBrush}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Acá vamos a listar archivo, categoría y destino antes de confirmar el movimiento." Style="{StaticResource BandaMutedTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
