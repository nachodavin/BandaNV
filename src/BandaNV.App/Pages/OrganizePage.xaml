<Page
    x:Class="BandaNV.App.Pages.OrganizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BandaNV.App.Pages"
    Background="Transparent">

    <Page.Resources>
        <SolidColorBrush x:Key="OrganizeWarningBrush" Color="#F2B85B" />
        <SolidColorBrush x:Key="OrganizeWarningSoftBrush" Color="#24F2B85B" />
        <SolidColorBrush x:Key="OrganizeSuccessSoftBrush" Color="#244FE0C6" />

        <DataTemplate x:Key="UnassignedExtensionTemplate" x:DataType="local:UnassignedExtensionSummary">
            <Border
                Padding="14,12"
                Margin="0,0,0,8"
                CornerRadius="12"
                Background="{StaticResource BandaCardAltBrush}"
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="1">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Padding="10,5"
                        CornerRadius="10"
                        Background="{StaticResource OrganizeWarningSoftBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind Extension}"
                            Foreground="{StaticResource OrganizeWarningBrush}"
                            FontSize="14"
                            FontWeight="SemiBold" />
                    </Border>

                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind FilesText}"
                        Foreground="{StaticResource BandaTextBrush}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Grid.Column="2"
                        Text="{x:Bind SamplesText}"
                        Foreground="{StaticResource BandaMutedBrush}"
                        FontSize="13"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />

                    <Button
                        Grid.Column="3"
                        Tag="{x:Bind Extension}"
                        Content="Asignar"
                        Click="AssignExtensionButton_Click"
                        Padding="16,8"
                        MinWidth="92"
                        CornerRadius="10"
                        Background="{StaticResource BandaAccentSoftBrush}"
                        Foreground="{StaticResource BandaAccentBrush}"
                        BorderBrush="{StaticResource BandaBorderBrush}"
                        BorderThickness="1" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="UnassignedFolderTemplate" x:DataType="local:OrganizePreviewFile">
            <Border
                Padding="14,12"
                Margin="0,0,0,8"
                CornerRadius="12"
                Background="{StaticResource BandaCardAltBrush}"
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="1">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Padding="10,5"
                        CornerRadius="10"
                        Background="{StaticResource OrganizeWarningSoftBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="CARPETA"
                            Foreground="{StaticResource OrganizeWarningBrush}"
                            FontSize="12"
                            FontWeight="SemiBold" />
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        Spacing="2"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind FileName}"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind FolderIssueDisplay}"
                            Foreground="{StaticResource BandaMutedBrush}"
                            FontSize="12"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        Tag="{x:Bind ItemId}"
                        Content="Ver contenido"
                        Click="FolderDetailButton_Click"
                        Padding="14,8"
                        MinWidth="96"
                        CornerRadius="10"
                        Background="Transparent"
                        Foreground="{StaticResource BandaMutedStrongBrush}"
                        BorderBrush="{StaticResource BandaBorderBrush}"
                        BorderThickness="1" />

                    <Button
                        Grid.Column="3"
                        Tag="{x:Bind ItemId}"
                        Content="Asignar"
                        Click="PreviewCategorySelectorButton_Click"
                        IsEnabled="{x:Bind CanAssignFolder}"
                        Padding="16,8"
                        MinWidth="92"
                        CornerRadius="10"
                        Background="{StaticResource BandaAccentSoftBrush}"
                        Foreground="{StaticResource BandaAccentBrush}"
                        BorderBrush="{StaticResource BandaBorderBrush}"
                        BorderThickness="1" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FolderContentTemplate" x:DataType="local:FolderContentPreviewItem">
            <Border
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid
                    Padding="14,10"
                    ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.4*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="0.7*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Text="{x:Bind RelativePath}"
                        Foreground="{StaticResource BandaTextBrush}"
                        FontSize="13"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind ExtensionDisplay}"
                        Foreground="{StaticResource BandaMutedStrongBrush}"
                        FontSize="12"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Grid.Column="2"
                        Text="{x:Bind CategoryDisplay}"
                        Foreground="{StaticResource BandaMutedStrongBrush}"
                        FontSize="12"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Grid.Column="3"
                        Text="{x:Bind SizeDisplay}"
                        Foreground="{StaticResource BandaMutedStrongBrush}"
                        FontSize="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="OrganizeSideFolderContentTemplate" x:DataType="local:FolderContentPreviewItem">
            <Grid
                Padding="10,9"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.15*" />
                    <ColumnDefinition Width="0.75*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="1.35*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="{x:Bind FileName}"
                    Foreground="{StaticResource BandaTextBrush}"
                    FontSize="12"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />

                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind ExtensionDisplay}"
                    Foreground="{StaticResource BandaMutedStrongBrush}"
                    FontSize="11"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />

                <TextBlock
                    Grid.Column="2"
                    Text="{x:Bind SizeDisplay}"
                    Foreground="{StaticResource BandaMutedStrongBrush}"
                    FontSize="11"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />

                <TextBlock
                    Grid.Column="3"
                    Text="{x:Bind ModifiedDisplay}"
                    Foreground="{StaticResource BandaMutedBrush}"
                    FontSize="11"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ResolvedExtensionTemplate" x:DataType="local:ResolvedExtensionAssignment">
            <Border
                Padding="14,12"
                Margin="0,0,0,8"
                CornerRadius="12"
                Background="{StaticResource BandaAccentFaintBrush}"
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="1">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Padding="10,5"
                        CornerRadius="10"
                        Background="{StaticResource BandaAccentSoftBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind Extension}"
                            Foreground="{StaticResource BandaAccentBrush}"
                            FontSize="14"
                            FontWeight="SemiBold" />
                    </Border>

                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind FilesText}"
                        Foreground="{StaticResource BandaTextBrush}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />

                    <StackPanel
                        Grid.Column="2"
                        Spacing="2"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind DestinationText}"
                            Foreground="{StaticResource BandaAccentBrush}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind PersistenceText}"
                            Foreground="{StaticResource BandaMutedBrush}"
                            FontSize="12"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button
                        Grid.Column="3"
                        Tag="{x:Bind Extension}"
                        Content="Revertir"
                        Click="RevertExtensionAssignmentButton_Click"
                        Padding="14,8"
                        MinWidth="88"
                        CornerRadius="10"
                        Background="Transparent"
                        Foreground="{StaticResource BandaMutedStrongBrush}"
                        BorderBrush="{StaticResource BandaBorderBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PreviewFileTemplate" x:DataType="local:OrganizePreviewFile">
            <Grid Padding="12,10" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*" />
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="1.25*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind FileName}"
                        Foreground="{StaticResource BandaTextBrush}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Text="{x:Bind ExtensionDisplay}"
                        Foreground="{StaticResource BandaMutedBrush}"
                        FontSize="11" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="7"
                    VerticalAlignment="Center">
                    <Ellipse
                        Width="8"
                        Height="8"
                        Fill="{x:Bind CategoryBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind CategoryDisplay}"
                        Foreground="{x:Bind CategoryBrush}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock
                    Grid.Column="2"
                    Text="{x:Bind SizeDisplay}"
                    Foreground="{StaticResource BandaMutedStrongBrush}"
                    FontSize="13"
                    VerticalAlignment="Center" />

                <TextBlock
                    Grid.Column="3"
                    Text="{x:Bind ModifiedDisplay}"
                    Foreground="{StaticResource BandaMutedStrongBrush}"
                    FontSize="13"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SummaryCategoryTemplate" x:DataType="local:OrganizeCategorySummary">
            <Grid Padding="0,7" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="{x:Bind DisplayName}"
                    Foreground="{StaticResource BandaMutedStrongBrush}"
                    FontSize="13"
                    TextTrimming="CharacterEllipsis" />

                <Border
                    Grid.Column="1"
                    MinWidth="34"
                    Padding="8,3"
                    CornerRadius="10"
                    Background="{StaticResource BandaAccentFaintBrush}">
                    <TextBlock
                        Text="{x:Bind CountText}"
                        Foreground="{StaticResource BandaAccentBrush}"
                        FontSize="12"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center" />
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid Padding="34,32,34,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Spacing="5">
            <TextBlock
                Text="Organizar"
                Style="{StaticResource BandaSectionTitleStyle}"
                FontSize="32" />
            <TextBlock
                Text="Analizá archivos y carpetas pendientes, resolvé excepciones y confirmá cada destino antes de moverlos."
                Style="{StaticResource BandaMutedTextStyle}"
                FontSize="14" />
        </StackPanel>

        <!-- Estado inicial -->
        <Grid
            x:Name="InitialStatePanel"
            Grid.Row="1">
            <Border
                MaxWidth="820"
                Margin="0,92,0,0"
                Padding="34"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                CornerRadius="22"
                Background="{StaticResource BandaAccentCardBrush}"
                BorderBrush="{StaticResource BandaBorderStrongBrush}"
                BorderThickness="1">

                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="76"
                        Height="76"
                        CornerRadius="22"
                        Background="{StaticResource BandaAccentSoftBrush}"
                        VerticalAlignment="Top">
                        <TextBlock
                            Text="↻"
                            Foreground="{StaticResource BandaAccentBrush}"
                            FontSize="34"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="10">
                        <TextBlock
                            Text="Todo listo para analizar"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="23"
                            FontWeight="SemiBold" />

                        <TextBlock
                            x:Name="InitialAnalysisDescriptionText"
                            Text="BandaNV revisará los archivos pendientes y te mostrará la categoría y el destino de cada uno. Nada se moverá durante el análisis."
                            Foreground="{StaticResource BandaMutedStrongBrush}"
                            FontSize="14"
                            TextWrapping="Wrap"
                            MaxWidth="640" />

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="0,4,0,0">
                            <Border
                                Padding="10,5"
                                CornerRadius="10"
                                Background="{StaticResource BandaCardBrush}">
                                <TextBlock
                                    Text="Vista previa segura"
                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                    FontSize="12" />
                            </Border>
                            <Border
                                Padding="10,5"
                                CornerRadius="10"
                                Background="{StaticResource BandaCardBrush}">
                                <TextBlock
                                    Text="Asignación rápida"
                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                    FontSize="12" />
                            </Border>
                            <Border
                                Padding="10,5"
                                CornerRadius="10"
                                Background="{StaticResource BandaCardBrush}">
                                <TextBlock
                                    Text="Sin movimientos automáticos"
                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                    FontSize="12" />
                            </Border>
                        </StackPanel>

                        <Button
                            x:Name="AnalyzeButton"
                            Content="Analizar archivos"
                            Click="AnalyzeButton_Click"
                            Margin="0,10,0,0"
                            Padding="20,11"
                            HorizontalAlignment="Left"
                            MinWidth="170"
                            CornerRadius="12"
                            Background="{StaticResource BandaAccentBrush}"
                            Foreground="{StaticResource BandaActionForegroundBrush}"
                            BorderThickness="0"
                            FontWeight="SemiBold" />

                        <TextBlock
                            x:Name="AnalysisStatusText"
                            Visibility="Collapsed"
                            Foreground="{StaticResource BandaMutedStrongBrush}"
                            FontSize="12"
                            TextWrapping="Wrap"
                            MaxWidth="640" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Estado de vista previa -->
        <Grid
            x:Name="PreviewStatePanel"
            Grid.Row="1"
            Padding="0,16,0,0"
            RowSpacing="14"
            Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Métricas -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource BandaCardStyle}" Padding="18" MinHeight="108">
                    <StackPanel Spacing="5">
                        <TextBlock Text="ELEMENTOS DETECTADOS" Style="{StaticResource BandaLabelTextStyle}" />
                        <TextBlock
                            x:Name="FilesMetricText"
                            Text="0"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="28"
                            FontWeight="SemiBold" />
                        <TextBlock Text="Pendientes de revisión" Style="{StaticResource BandaMutedTextStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource BandaCardStyle}" Padding="18" MinHeight="108">
                    <StackPanel Spacing="5">
                        <TextBlock Text="CATEGORÍAS" Style="{StaticResource BandaLabelTextStyle}" />
                        <TextBlock
                            x:Name="CategoriesMetricText"
                            Text="0"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="28"
                            FontWeight="SemiBold" />
                        <TextBlock Text="Con archivos asignados" Style="{StaticResource BandaMutedTextStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource BandaCardStyle}" Padding="18" MinHeight="108">
                    <StackPanel Spacing="5">
                        <TextBlock Text="TAMAÑO TOTAL" Style="{StaticResource BandaLabelTextStyle}" />
                        <TextBlock
                            x:Name="SizeMetricText"
                            Text="0 MB"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="28"
                            FontWeight="SemiBold" />
                        <TextBlock Text="Entre todos los elementos" Style="{StaticResource BandaMutedTextStyle}" />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="UnclassifiedMetricCard"
                    Grid.Column="3"
                    Padding="18"
                    MinHeight="108"
                    CornerRadius="18"
                    Background="{StaticResource OrganizeWarningSoftBrush}"
                    BorderBrush="{StaticResource OrganizeWarningBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="5">
                        <TextBlock
                            x:Name="UnclassifiedMetricTitle"
                            Text="SIN ASIGNAR"
                            Foreground="{StaticResource OrganizeWarningBrush}"
                            FontSize="13"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="UnclassifiedMetricText"
                            Text="0"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="28"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="UnclassifiedMetricSubtitle"
                            Text="No se moverán sin asignación"
                            Foreground="{StaticResource OrganizeWarningBrush}"
                            FontSize="13" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Extensiones pendientes / resueltas -->
            <Border
                x:Name="UnassignedCard"
                Grid.Row="1"
                Padding="18"
                CornerRadius="18"
                Background="{StaticResource BandaCardBrush}"
                BorderBrush="{StaticResource OrganizeWarningBrush}"
                BorderThickness="1">

                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="UnassignedTitleText"
                                Text="Extensiones sin asignar"
                                Foreground="{StaticResource BandaTextBrush}"
                                FontSize="17"
                                FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="UnassignedDescriptionText"
                                Text="Estas extensiones todavía no pertenecen a ninguna categoría. Podés resolverlas ahora para incluir sus archivos en esta organización."
                                Foreground="{StaticResource BandaMutedBrush}"
                                FontSize="13"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Border
                            x:Name="UnassignedSummaryBadge"
                            Grid.Column="1"
                            Padding="12,6"
                            CornerRadius="12"
                            Background="{StaticResource OrganizeWarningSoftBrush}"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="UnassignedSummaryText"
                                Text="0 extensiones"
                                Foreground="{StaticResource OrganizeWarningBrush}"
                                FontSize="13"
                                FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <ItemsControl
                        x:Name="UnassignedExtensionsList"
                        ItemTemplate="{StaticResource UnassignedExtensionTemplate}"
                        HorizontalContentAlignment="Stretch" />

                    <StackPanel
                        x:Name="UnassignedFoldersPanel"
                        Spacing="8"
                        Visibility="Collapsed">
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="CARPETAS SIN ASIGNAR"
                                Style="{StaticResource BandaLabelTextStyle}"
                                FontSize="11" />

                            <TextBlock
                                Grid.Column="1"
                                Text="Asignación manual"
                                Foreground="{StaticResource OrganizeWarningBrush}"
                                FontSize="12"
                                FontWeight="SemiBold" />
                        </Grid>

                        <ItemsControl
                            x:Name="UnassignedFoldersList"
                            ItemTemplate="{StaticResource UnassignedFolderTemplate}"
                            HorizontalContentAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel
                        x:Name="ResolvedAssignmentsPanel"
                        Spacing="8"
                        Visibility="Collapsed">
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                x:Name="ResolvedAssignmentsTitle"
                                Text="Asignaciones realizadas"
                                Foreground="{StaticResource BandaMutedStrongBrush}"
                                FontSize="13"
                                FontWeight="SemiBold" />

                            <TextBlock
                                x:Name="ResolvedAssignmentsCountText"
                                Grid.Column="1"
                                Text="0 resueltas"
                                Foreground="{StaticResource BandaAccentBrush}"
                                FontSize="12"
                                FontWeight="SemiBold" />
                        </Grid>

                        <ItemsControl
                            x:Name="ResolvedAssignmentsList"
                            ItemTemplate="{StaticResource ResolvedExtensionTemplate}"
                            HorizontalContentAlignment="Stretch" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Vista previa + resumen: ocupa todo el alto libre -->
            <Grid
                Grid.Row="2"
                ColumnSpacing="14"
                MinHeight="300">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <Border
                    Style="{StaticResource BandaCardStyle}"
                    Padding="0"
                    MinHeight="300"
                    VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Padding="18,15" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="3">
                                <TextBlock
                                    Text="Vista previa"
                                    Foreground="{StaticResource BandaTextBrush}"
                                    FontSize="17"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Revisá qué va a pasar con cada elemento antes de confirmar."
                                    Style="{StaticResource BandaMutedTextStyle}" />
                            </StackPanel>

                            <Button
                                Grid.Column="1"
                                Content="Analizar nuevamente"
                                Click="AnalyzeAgainButton_Click"
                                Padding="13,7"
                                VerticalAlignment="Center"
                                CornerRadius="10"
                                Background="Transparent"
                                BorderBrush="{StaticResource BandaBorderBrush}"
                                BorderThickness="1"
                                Foreground="{StaticResource BandaMutedStrongBrush}" />
                        </Grid>

                        <Border
                            Grid.Row="1"
                            Background="{StaticResource BandaCardAltBrush}"
                            BorderBrush="{StaticResource BandaBorderBrush}"
                            BorderThickness="0,1,0,1">
                            <Grid Padding="14,10" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.1*" />
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="1.25*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="ELEMENTO" Style="{StaticResource BandaLabelTextStyle}" />
                                <TextBlock Grid.Column="1" Text="CATEGORÍA" Style="{StaticResource BandaLabelTextStyle}" />
                                <TextBlock Grid.Column="2" Text="TAMAÑO" Style="{StaticResource BandaLabelTextStyle}" />
                                <TextBlock Grid.Column="3" Text="FECHA DE MODIFICACIÓN" Style="{StaticResource BandaLabelTextStyle}" />
                            </Grid>
                        </Border>

                        <ListView
                            x:Name="PreviewFilesList"
                            Grid.Row="2"
                            ItemTemplate="{StaticResource PreviewFileTemplate}"
                            SelectionMode="Extended"
                            IsMultiSelectCheckBoxEnabled="False"
                            KeyboardAcceleratorPlacementMode="Hidden"
                            SelectionChanged="PreviewFilesList_SelectionChanged"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6,6,6,8"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <ListView.Resources>
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{StaticResource BandaSelectionColor}" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{StaticResource BandaSelectionHoverColor}" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#161F292D" />
                                <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#F5F8FA" />
                            </ListView.Resources>

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="CornerRadius" Value="8" />
                                    <Setter Property="MinHeight" Value="44" />
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.KeyboardAccelerators>
                                <KeyboardAccelerator
                                    Key="A"
                                    Modifiers="Control"
                                    Invoked="PreviewSelectAllAccelerator_Invoked" />
                            </ListView.KeyboardAccelerators>
                        </ListView>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    CornerRadius="14"
                    Background="{StaticResource BandaCardAltBrush}"
                    BorderBrush="{StaticResource BandaBorderBrush}"
                    BorderThickness="1"
                    Padding="18"
                    VerticalAlignment="Stretch">
                    <Grid>
                        <!-- Estado inicial: resumen general -->
                        <Grid x:Name="OrganizeSummaryPanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock
                                    Text="Resumen"
                                    Foreground="{StaticResource BandaTextBrush}"
                                    FontSize="17"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Distribución por categoría"
                                    Style="{StaticResource BandaMutedTextStyle}" />
                            </StackPanel>

                            <ScrollViewer
                                Grid.Row="1"
                                Margin="0,12,0,18"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl
                                    x:Name="SummaryCategoriesList"
                                    ItemTemplate="{StaticResource SummaryCategoryTemplate}" />
                            </ScrollViewer>

                            <StackPanel Grid.Row="2" Spacing="10">
                                <Border
                                    Height="1"
                                    Background="{StaticResource BandaBorderBrush}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Se moverán" Style="{StaticResource BandaMutedTextStyle}" />
                                    <TextBlock
                                        x:Name="SummaryMoveCountText"
                                        Grid.Column="1"
                                        Text="0"
                                        Foreground="{StaticResource BandaTextBrush}"
                                        FontSize="13"
                                        FontWeight="SemiBold" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="SummaryUnclassifiedLabel"
                                        Text="Quedarán sin mover"
                                        Style="{StaticResource BandaMutedTextStyle}" />
                                    <TextBlock
                                        x:Name="SummaryUnclassifiedCountText"
                                        Grid.Column="1"
                                        Text="0"
                                        Foreground="{StaticResource OrganizeWarningBrush}"
                                        FontSize="13"
                                        FontWeight="SemiBold" />
                                </Grid>

                                <StackPanel Spacing="3" Margin="0,4,0,0">
                                    <TextBlock Text="DESTINO" Style="{StaticResource BandaLabelTextStyle}" />
                                    <TextBlock
                                        x:Name="PreviewDestinationText"
                                        Text="—"
                                        Foreground="{StaticResource BandaAccentBrush}"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Estado contextual: detalle del elemento seleccionado -->
                        <Grid
                            x:Name="OrganizeDetailPanel"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock
                                    x:Name="OrganizeDetailTitleText"
                                    Text="Detalle del elemento"
                                    Foreground="{StaticResource BandaTextBrush}"
                                    FontSize="18"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="OrganizeDetailFileNameText"
                                    Text="Seleccioná un elemento"
                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                    FontSize="13"
                                    TextWrapping="Wrap"
                                    TextTrimming="CharacterEllipsis"
                                    MaxLines="2" />
                            </StackPanel>

                            <Grid
                                Grid.Row="1"
                                Margin="0,16,0,16"
                                ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    x:Name="OrganizeDetailCategoryCard"
                                    Padding="12"
                                    CornerRadius="12"
                                    Background="{StaticResource BandaNavIconBrush}"
                                    BorderBrush="{StaticResource BandaBorderBrush}"
                                    BorderThickness="1">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="CATEGORÍA" Style="{StaticResource BandaMutedTextStyle}" FontSize="11" />
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="7">
                                            <Ellipse
                                                x:Name="OrganizeDetailCategoryDot"
                                                Width="9"
                                                Height="9"
                                                Fill="{StaticResource BandaAccentBrush}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                x:Name="OrganizeDetailCategoryText"
                                                Text="—"
                                                Foreground="{StaticResource BandaAccentBrush}"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Padding="12"
                                    CornerRadius="12"
                                    Background="{StaticResource BandaNavIconBrush}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="TAMAÑO" Style="{StaticResource BandaMutedTextStyle}" FontSize="11" />
                                        <TextBlock
                                            x:Name="OrganizeDetailSizeText"
                                            Text="—"
                                            Foreground="{StaticResource BandaTextBrush}"
                                            FontSize="14"
                                            FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid
                                Grid.Row="2"
                                RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Spacing="11">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="TIPO / EXTENSIÓN" Style="{StaticResource BandaMutedTextStyle}" FontSize="10" />
                                            <TextBlock
                                                x:Name="OrganizeDetailTypeText"
                                                Text="—"
                                                Foreground="{StaticResource BandaMutedStrongBrush}"
                                                FontSize="12"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="1"
                                            Spacing="4">
                                            <TextBlock Text="MODIFICADO" Style="{StaticResource BandaMutedTextStyle}" FontSize="10" />
                                            <TextBlock
                                                x:Name="OrganizeDetailModifiedText"
                                                Text="—"
                                                Foreground="{StaticResource BandaMutedStrongBrush}"
                                                FontSize="12"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="UBICACIÓN" Style="{StaticResource BandaMutedTextStyle}" FontSize="10" />
                                        <TextBlock
                                            x:Name="OrganizeDetailLocationText"
                                            Text="—"
                                            Foreground="{StaticResource BandaMutedStrongBrush}"
                                            FontSize="11"
                                            TextWrapping="Wrap"
                                            TextTrimming="CharacterEllipsis"
                                            MaxLines="2" />
                                    </StackPanel>
                                </StackPanel>

                                <Border
                                    x:Name="OrganizeFolderContentsPanel"
                                    Grid.Row="1"
                                    Margin="0,6,0,2"
                                    MinHeight="220"
                                    MaxHeight="360"
                                    CornerRadius="12"
                                    Background="{StaticResource BandaNavIconBrush}"
                                    BorderBrush="{StaticResource BandaBorderBrush}"
                                    BorderThickness="1"
                                    Visibility="Collapsed">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="36" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid
                                            Padding="12,10,12,8"
                                            ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Button
                                                x:Name="FolderDetailBackButton"
                                                Content="Atrás"
                                                Click="FolderDetailBackButton_Click"
                                                Padding="8,4"
                                                Margin="0,0,8,0"
                                                CornerRadius="8"
                                                Background="Transparent"
                                                BorderBrush="{StaticResource BandaBorderBrush}"
                                                BorderThickness="1"
                                                Foreground="{StaticResource BandaMutedStrongBrush}"
                                                Visibility="Collapsed" />

                                            <StackPanel
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="5"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    x:Name="OrganizeFolderContentsTitleText"
                                                    Text="CONTENIDO"
                                                    Style="{StaticResource BandaLabelTextStyle}"
                                                    FontSize="10"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    x:Name="FolderDetailPathText"
                                                    Text=""
                                                    Foreground="{StaticResource BandaMutedBrush}"
                                                    FontSize="10"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>

                                            <TextBlock
                                                Grid.Column="2"
                                                Text="Seleccioná para explorar"
                                                Foreground="{StaticResource BandaMutedBrush}"
                                                FontSize="10"
                                                VerticalAlignment="Center" />
                                        </Grid>

                                        <Border
                                            Grid.Row="1"
                                            Background="{StaticResource BandaCardAltBrush}"
                                            BorderBrush="{StaticResource BandaBorderBrush}"
                                            BorderThickness="0,1,0,1">
                                            <Grid
                                                Padding="12,0"
                                                ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.15*" />
                                                    <ColumnDefinition Width="0.75*" />
                                                    <ColumnDefinition Width="0.8*" />
                                                    <ColumnDefinition Width="1.35*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    Text="NOMBRE"
                                                    Style="{StaticResource BandaMutedTextStyle}"
                                                    FontSize="10"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="EXT."
                                                    Style="{StaticResource BandaMutedTextStyle}"
                                                    FontSize="10"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Text="TAMAÑO"
                                                    Style="{StaticResource BandaMutedTextStyle}"
                                                    FontSize="10"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    Text="FECHA"
                                                    Style="{StaticResource BandaMutedTextStyle}"
                                                    FontSize="10"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <ListView
                                            x:Name="FolderDetailFilesList"
                                            Grid.Row="2"
                                            ItemTemplate="{StaticResource OrganizeSideFolderContentTemplate}"
                                            SelectionMode="None"
                                            IsItemClickEnabled="True"
                                            ItemClick="FolderDetailFilesList_ItemClick"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            MinHeight="170"
                                            Padding="6,6,6,8"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto">

                                            <ListView.Resources>
                                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#161F292D" />
                                            </ListView.Resources>

                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,2" />
                                                    <Setter Property="CornerRadius" Value="8" />
                                                    <Setter Property="MinHeight" Value="44" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                        </ListView>
                                    </Grid>
                                </Border>
                            </Grid>

                            <StackPanel
                                Grid.Row="3"
                                Spacing="8"
                                Margin="0,16,0,0">
                                <Button
                                    x:Name="OrganizeOpenButton"
                                    Content="Abrir archivo"
                                    Click="OrganizeOpenButton_Click"
                                    FontSize="14"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="14,10"
                                    CornerRadius="12"
                                    FontWeight="SemiBold"
                                    IsEnabled="False">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource BandaActionBaseColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource BandaActionHoverColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource BandaActionPressedColor}" />
                                        <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource BandaActionForegroundColor}" />
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource BandaActionForegroundColor}" />
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource BandaActionForegroundColor}" />
                                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource BandaActionBaseColor}" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource BandaActionHoverColor}" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource BandaActionPressedColor}" />
                                    </Button.Resources>
                                </Button>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        x:Name="OrganizeOpenLocationButton"
                                        Content="Abrir ubicación"
                                        Click="OrganizeOpenLocationButton_Click"
                                        Style="{StaticResource BandaPopupSecondaryButtonStyle}"
                                        IsEnabled="False" />
                                    <Button
                                        x:Name="OrganizeCopyPathButton"
                                        Grid.Column="1"
                                        Content="Copiar ruta"
                                        Click="OrganizeCopyPathButton_Click"
                                        Style="{StaticResource BandaPopupSecondaryButtonStyle}"
                                        IsEnabled="False" />
                                </Grid>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        x:Name="OrganizeChangeCategoryButton"
                                        Content="Cambiar categoría"
                                        Click="OrganizeChangeCategoryButton_Click"
                                        Style="{StaticResource BandaPopupSecondaryButtonStyle}"
                                        IsEnabled="False" />
                                    <Button
                                        x:Name="OrganizeRenameButton"
                                        Grid.Column="1"
                                        Content="Renombrar"
                                        Click="OrganizeRenameButton_Click"
                                        Style="{StaticResource BandaPopupSecondaryButtonStyle}"
                                        IsEnabled="False" />
                                </Grid>

                                <Border
                                    Height="1"
                                    Margin="0,4,0,4"
                                    Background="{StaticResource BandaBorderBrush}" />

                                <Button
                                    x:Name="OrganizeDeleteButton"
                                    Content="Eliminar archivo"
                                    Click="OrganizeDeleteButton_Click"
                                    FontSize="14"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="14,10"
                                    CornerRadius="12"
                                    FontWeight="SemiBold"
                                    IsEnabled="False">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackground" Color="#FF6F6F" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF8585" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D95454" />
                                        <SolidColorBrush x:Key="ButtonForeground" Color="#190909" />
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#190909" />
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#190909" />
                                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FF6F6F" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FF8585" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#D95454" />
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Barra final de acciones -->
            <Border
                Grid.Row="3"
                Padding="16"
                CornerRadius="18"
                Background="{StaticResource BandaCardBrush}"
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="1">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock
                            Text="Todo queda bajo tu control"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="13"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="FooterStatusText"
                            Text="Revisá la vista previa antes de continuar."
                            Style="{StaticResource BandaMutedTextStyle}" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Content="Cancelar"
                        Click="CancelPreviewButton_Click"
                        Padding="18,10"
                        MinWidth="100"
                        CornerRadius="12"
                        Background="Transparent"
                        BorderBrush="{StaticResource BandaBorderBrush}"
                        BorderThickness="1"
                        Foreground="{StaticResource BandaMutedStrongBrush}" />

                    <Button
                        x:Name="OrganizeButton"
                        Grid.Column="2"
                        Content="Organizar archivos"
                        Click="OrganizeButton_Click"
                        Padding="20,10"
                        MinWidth="190"
                        CornerRadius="12"
                        Background="{StaticResource BandaAccentBrush}"
                        Foreground="{StaticResource BandaActionForegroundBrush}"
                        BorderThickness="0"
                        FontWeight="SemiBold" />
                </Grid>
            </Border>
        </Grid>

        <!-- Estado de progreso -->
        <Grid
            x:Name="ProgressStatePanel"
            Grid.Row="1"
            Visibility="Collapsed">
            <Border
                MaxWidth="760"
                Margin="0,100,0,0"
                Padding="34"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Style="{StaticResource BandaCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock
                        Text="Organizando archivos..."
                        Foreground="{StaticResource BandaTextBrush}"
                        FontSize="23"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="ProgressStatusText"
                        Text="Preparando movimientos"
                        Style="{StaticResource BandaMutedTextStyle}"
                        FontSize="14" />
                    <ProgressBar
                        x:Name="OrganizationProgressBar"
                        Minimum="0"
                        Maximum="100"
                        Value="0"
                        Height="6" />
                    <TextBlock
                        x:Name="ProgressCountText"
                        Text="0 de 0 archivos"
                        Foreground="{StaticResource BandaMutedStrongBrush}"
                        FontSize="13" />
                    <TextBlock
                        Text="BandaNV registra cada movimiento en el historial portable antes y después de tocar el archivo, para mantener trazabilidad y preparar un Undo seguro."
                        Foreground="{StaticResource BandaMutedBrush}"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Estado final -->
        <Grid
            x:Name="CompletionStatePanel"
            Grid.Row="1"
            Visibility="Collapsed">
            <Border
                MaxWidth="760"
                Margin="0,92,0,0"
                Padding="34"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                CornerRadius="22"
                Background="{StaticResource BandaAccentCardBrush}"
                BorderBrush="{StaticResource BandaBorderStrongBrush}"
                BorderThickness="1">
                <StackPanel Spacing="12">
                    <Border
                        Width="62"
                        Height="62"
                        CornerRadius="20"
                        Background="{StaticResource OrganizeSuccessSoftBrush}"
                        HorizontalAlignment="Left">
                        <TextBlock
                            Text="✓"
                            Foreground="{StaticResource BandaAccentBrush}"
                            FontSize="28"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>

                    <TextBlock
                        Text="Organización completada"
                        Foreground="{StaticResource BandaTextBrush}"
                        FontSize="23"
                        FontWeight="SemiBold" />

                    <TextBlock
                        x:Name="CompletionText"
                        Text="Los archivos fueron organizados correctamente."
                        Foreground="{StaticResource BandaMutedStrongBrush}"
                        FontSize="14"
                        TextWrapping="Wrap" />

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10"
                        Margin="0,8,0,0">
                        <Button
                            Content="Nueva organización"
                            Click="NewOrganizationButton_Click"
                            Padding="18,10"
                            CornerRadius="12"
                            Background="{StaticResource BandaAccentBrush}"
                            Foreground="{StaticResource BandaActionForegroundBrush}"
                            BorderThickness="0"
                            FontWeight="SemiBold" />
                        <Button
                            Content="Revisar otra vez"
                            Click="AnalyzeAgainButton_Click"
                            Padding="18,10"
                            CornerRadius="12"
                            Background="Transparent"
                            BorderBrush="{StaticResource BandaBorderBrush}"
                            BorderThickness="1"
                            Foreground="{StaticResource BandaMutedStrongBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>

        <!-- Modal global BandaNV para asignación de extensiones -->
        <Grid
            x:Name="AssignmentOverlay"
            Canvas.ZIndex="100"
            Visibility="Collapsed">
            <Border
                Background="{StaticResource BandaPopupBackdropBrush}"
                Tapped="AssignmentBackdrop_Tapped" />

            <Border
                Width="620"
                Style="{StaticResource BandaPopupCardStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Grid RowSpacing="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="46"
                            Height="46"
                            CornerRadius="14"
                            Background="{StaticResource BandaAccentSoftBrush}">
                            <TextBlock
                                Text="+"
                                Foreground="{StaticResource BandaAccentBrush}"
                                FontSize="22"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="AssignmentOverlayTitleText"
                                Text="Asignar extensión"
                                Foreground="{StaticResource BandaTextBrush}"
                                FontSize="22"
                                FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="AssignmentHelperText"
                                Text=""
                                Foreground="{StaticResource BandaMutedBrush}"
                                FontSize="13"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            Content="×"
                            Click="CloseAssignmentOverlayButton_Click"
                            Style="{StaticResource BandaPopupCloseButtonStyle}"
                            VerticalAlignment="Top" />
                    </Grid>

                    <StackPanel Grid.Row="1" Spacing="12">
                        <Border
                            Padding="16"
                            CornerRadius="16"
                            Background="{StaticResource BandaCardBrush}"
                            BorderBrush="{StaticResource BandaBorderBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Text="ASIGNAR A CATEGORÍA"
                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                    FontSize="11"
                                    FontWeight="SemiBold" />

                                <Button
                                    x:Name="AssignmentCategorySelectorButton"
                                    Style="{StaticResource BandaSelectorButtonStyle}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="AssignmentCategoryValueText"
                                            Text="Elegir categoría"
                                            Foreground="{StaticResource BandaTextBrush}"
                                            FontSize="13"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="⌄"
                                            Foreground="{StaticResource BandaAccentBrush}"
                                            FontSize="14"
                                            VerticalAlignment="Center" />
                                    </Grid>

                                    <Button.Flyout>
                                        <Flyout
                                            x:Name="AssignmentCategoryFlyout"
                                            Placement="BottomEdgeAlignedLeft"
                                            FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                                            <Border
                                                Width="320"
                                                MaxHeight="330"
                                                Padding="8"
                                                CornerRadius="16"
                                                Background="{StaticResource BandaPopupSurfaceBrush}"
                                                BorderBrush="{StaticResource BandaBorderStrongBrush}"
                                                BorderThickness="1">
                                                <ScrollViewer
                                                    VerticalScrollBarVisibility="Auto"
                                                    HorizontalScrollBarVisibility="Disabled">
                                                    <StackPanel
                                                        x:Name="AssignmentCategoryOptionsPanel"
                                                        Margin="0,0,12,0"
                                                        Spacing="2" />
                                                </ScrollViewer>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>

                                <StackPanel
                                    x:Name="AssignmentCreateCategoryPanel"
                                    Spacing="8"
                                    Visibility="Collapsed">
                                    <TextBox
                                        x:Name="AssignmentCategoryNameTextBox"
                                        Header="Nombre de la nueva categoría"
                                        PlaceholderText="Ej: MODELOS 3D"
                                        Background="{StaticResource BandaPopupSurfaceBrush}"
                                        BorderBrush="{StaticResource BandaBorderBrush}"
                                        BorderThickness="1" />
                                    <TextBlock
                                        x:Name="AssignmentCreateCategoryInfoText"
                                        Text=""
                                        Foreground="{StaticResource BandaMutedBrush}"
                                        FontSize="12"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <Button
                                    x:Name="AssignmentToggleCreateCategoryButton"
                                    Content="Crear nueva categoría"
                                    Click="AssignmentToggleCreateCategoryButton_Click"
                                    Style="{StaticResource BandaPopupGhostButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Foreground="{StaticResource BandaAccentBrush}" />
                            </StackPanel>
                        </Border>

                        <CheckBox
                            x:Name="AssignmentRememberCheckBox"
                            Content="Recordar esta asignación para futuras organizaciones"
                            IsChecked="False"
                            Foreground="{StaticResource BandaMutedStrongBrush}" />

                        <TextBlock
                            x:Name="AssignmentValidationText"
                            Text=""
                            Foreground="{StaticResource OrganizeWarningBrush}"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <Grid Grid.Row="2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="1"
                            Content="Cancelar"
                            Click="CloseAssignmentOverlayButton_Click"
                            Style="{StaticResource BandaPopupSecondaryButtonStyle}" />

                        <Button
                            Grid.Column="2"
                            Content="Guardar asignación"
                            Click="SaveAssignmentOverlayButton_Click"
                            Style="{StaticResource BandaPopupPrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Gestión del elemento seleccionado durante el análisis -->
        <Grid
            x:Name="OrganizeManageOverlay"
            Canvas.ZIndex="108"
            Visibility="Collapsed">

            <Border
                Background="{StaticResource BandaPopupBackdropBrush}"
                Tapped="OrganizeManageBackdrop_Tapped" />

            <Border
                Width="560"
                Style="{StaticResource BandaPopupCardStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <Grid RowSpacing="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="OrganizeManageIconBorder"
                            Width="46"
                            Height="46"
                            CornerRadius="14"
                            Background="{StaticResource BandaAccentSoftBrush}">
                            <TextBlock
                                x:Name="OrganizeManageIconText"
                                Text="✎"
                                Foreground="{StaticResource BandaAccentBrush}"
                                FontSize="20"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="OrganizeManageTitleText"
                                Text="Gestionar elemento"
                                Foreground="{StaticResource BandaTextBrush}"
                                FontSize="22"
                                FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="OrganizeManageSubtitleText"
                                Text=""
                                Foreground="{StaticResource BandaMutedBrush}"
                                FontSize="13"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            Content="×"
                            Click="CloseOrganizeManageOverlayButton_Click"
                            Style="{StaticResource BandaPopupCloseButtonStyle}"
                            VerticalAlignment="Top" />
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Padding="16"
                        CornerRadius="16"
                        Background="{StaticResource BandaCardBrush}"
                        BorderBrush="{StaticResource BandaBorderBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="12">
                            <StackPanel
                                x:Name="OrganizeManageCategoryPanel"
                                Spacing="8"
                                Visibility="Collapsed">
                                <TextBlock
                                    Text="NUEVA CATEGORÍA"
                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                    FontSize="11"
                                    FontWeight="SemiBold" />

                                <Button
                                    x:Name="OrganizeManageCategorySelectorButton"
                                    Style="{StaticResource BandaSelectorButtonStyle}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="OrganizeManageCategoryValueText"
                                            Text="Elegir categoría"
                                            Foreground="{StaticResource BandaTextBrush}"
                                            FontSize="13"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="⌄"
                                            Foreground="{StaticResource BandaAccentBrush}"
                                            FontSize="14"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                    <Button.Flyout>
                                        <Flyout
                                            x:Name="OrganizeManageCategoryFlyout"
                                            Placement="BottomEdgeAlignedLeft"
                                            FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                                            <Border
                                                Width="300"
                                                MaxHeight="330"
                                                Padding="8"
                                                CornerRadius="16"
                                                Background="{StaticResource BandaPopupSurfaceBrush}"
                                                BorderBrush="{StaticResource BandaBorderStrongBrush}"
                                                BorderThickness="1">
                                                <ScrollViewer
                                                    VerticalScrollBarVisibility="Auto"
                                                    HorizontalScrollBarVisibility="Disabled">
                                                    <StackPanel
                                                        x:Name="OrganizeManageCategoryOptionsPanel"
                                                        Margin="0,0,12,0"
                                                        Spacing="2" />
                                                </ScrollViewer>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>

                            <StackPanel
                                x:Name="OrganizeManageRenamePanel"
                                Spacing="8"
                                Visibility="Collapsed">
                                <TextBlock
                                    Text="NUEVO NOMBRE"
                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                    FontSize="11"
                                    FontWeight="SemiBold" />
                                <TextBox
                                    x:Name="OrganizeManageRenameTextBox"
                                    PlaceholderText="Nombre del elemento"
                                    Background="{StaticResource BandaPopupSurfaceBrush}"
                                    BorderBrush="{StaticResource BandaBorderBrush}"
                                    BorderThickness="1" />
                            </StackPanel>

                            <StackPanel
                                x:Name="OrganizeManageDeletePanel"
                                Spacing="8"
                                Visibility="Collapsed">
                                <TextBlock
                                    Text="ELIMINAR ELEMENTO"
                                    Foreground="{StaticResource BandaDangerBrush}"
                                    FontSize="11"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="OrganizeManageDeleteText"
                                    Text=""
                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                    FontSize="13"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock
                                x:Name="OrganizeManageValidationText"
                                Text=""
                                Foreground="{StaticResource BandaDangerBrush}"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="1"
                            Content="Cancelar"
                            Click="CloseOrganizeManageOverlayButton_Click"
                            Style="{StaticResource BandaPopupSecondaryButtonStyle}" />

                        <Button
                            x:Name="OrganizeManagePrimaryButton"
                            Grid.Column="2"
                            Content="Guardar"
                            Click="OrganizeManagePrimaryButton_Click"
                            Style="{StaticResource BandaPopupPrimaryButtonStyle}" />

                        <Button
                            x:Name="OrganizeManageDangerButton"
                            Grid.Column="2"
                            Content="Eliminar"
                            Click="OrganizeManageDangerButton_Click"
                            Style="{StaticResource BandaPopupDangerButtonStyle}"
                            Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Modal global BandaNV para conflictos de nombre -->
        <Grid
            x:Name="ConflictOverlay"
            Canvas.ZIndex="110"
            Visibility="Collapsed">
            <Border
                Background="{StaticResource BandaPopupBackdropBrush}"
                Tapped="ConflictBackdrop_Tapped" />

            <Border
                Width="680"
                Style="{StaticResource BandaPopupCardStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Grid RowSpacing="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="46"
                            Height="46"
                            CornerRadius="14"
                            Background="{StaticResource OrganizeWarningSoftBrush}">
                            <TextBlock
                                Text="!"
                                Foreground="{StaticResource OrganizeWarningBrush}"
                                FontSize="22"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="ConflictTitleText"
                                Text="Ya existe un elemento con este nombre"
                                Foreground="{StaticResource BandaTextBrush}"
                                FontSize="22"
                                FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="ConflictFileNameText"
                                Text=""
                                Foreground="{StaticResource BandaMutedBrush}"
                                FontSize="13"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            Content="×"
                            Click="CloseConflictOverlayButton_Click"
                            Style="{StaticResource BandaPopupCloseButtonStyle}"
                            VerticalAlignment="Top" />
                    </Grid>

                    <StackPanel Grid.Row="1" Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Padding="16"
                                CornerRadius="16"
                                Background="{StaticResource BandaCardBrush}"
                                BorderBrush="{StaticResource BandaBorderBrush}"
                                BorderThickness="1">
                                <StackPanel Spacing="7">
                                    <TextBlock
                                        x:Name="ConflictSourceLabelText"
                                        Text="ELEMENTO A ORGANIZAR"
                                        Style="{StaticResource BandaLabelTextStyle}" />
                                    <TextBlock
                                        x:Name="ConflictSourcePathText"
                                        Text=""
                                        Foreground="{StaticResource BandaTextBrush}"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="ConflictSourceMetaText"
                                        Text=""
                                        Foreground="{StaticResource BandaMutedBrush}"
                                        FontSize="12"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Column="1"
                                Padding="16"
                                CornerRadius="16"
                                Background="{StaticResource BandaCardBrush}"
                                BorderBrush="{StaticResource OrganizeWarningBrush}"
                                BorderThickness="1">
                                <StackPanel Spacing="7">
                                    <TextBlock
                                        Text="YA EXISTE EN DESTINO"
                                        Foreground="{StaticResource OrganizeWarningBrush}"
                                        FontSize="11"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="ConflictDestinationPathText"
                                        Text=""
                                        Foreground="{StaticResource BandaTextBrush}"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="ConflictDestinationMetaText"
                                        Text=""
                                        Foreground="{StaticResource BandaMutedBrush}"
                                        FontSize="12"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock
                            x:Name="ConflictInstructionText"
                            Text="Elegí qué hacer con este conflicto. Cerrar esta ventana equivale a omitir el elemento."
                            Foreground="{StaticResource BandaMutedBrush}"
                            FontSize="12"
                            TextWrapping="Wrap" />

                        <CheckBox
                            x:Name="ConflictApplyAllCheckBox"
                            Content="Aplicar esta decisión a los conflictos restantes"
                            IsChecked="False"
                            Foreground="{StaticResource BandaMutedStrongBrush}" />
                    </StackPanel>

                    <Grid Grid.Row="2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="1"
                            Content="Omitir"
                            Click="ConflictSkipButton_Click"
                            Style="{StaticResource BandaPopupSecondaryButtonStyle}" />

                        <Button
                            Grid.Column="2"
                            Content="Renombrar automáticamente"
                            Click="ConflictRenameButton_Click"
                            Style="{StaticResource BandaPopupSecondaryButtonStyle}" />

                        <Button
                            Grid.Column="3"
                            Content="Reemplazar"
                            Click="ConflictReplaceButton_Click"
                            Style="{StaticResource BandaPopupPrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
