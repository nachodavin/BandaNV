<Page
    x:Class="BandaNV.App.Pages.ExplorerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BandaNV.Core.Models"
    xmlns:controls="using:BandaNV.App.Controls"
    Background="Transparent"
    Loaded="ExplorerPage_Loaded"
    Unloaded="ExplorerPage_Unloaded">

    <Page.Resources>
        <DataTemplate x:Key="ExplorerFileTemplate" x:DataType="models:ExplorerItem">
            <Grid Padding="10,9" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="0.8*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind IconGlyph}"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="18"
                        Foreground="{StaticResource BandaMutedStrongBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind Name}"
                        FontSize="13"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{StaticResource BandaTextBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind ModifiedText}"
                    FontSize="12"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{StaticResource BandaMutedStrongBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="2"
                    Text="{x:Bind TypeName}"
                    FontSize="12"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{StaticResource BandaMutedStrongBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="3"
                    Text="{x:Bind SizeText}"
                    FontSize="12"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{StaticResource BandaMutedStrongBrush}"
                    VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="18,16,18,12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Encabezado compacto: navegación similar al Explorador de Windows. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock
                    Text="Explorar"
                    FontSize="25"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource BandaTextBrush}" />
                <TextBlock
                    Text="Recorré tus unidades y archivos. Vista experimental de solo lectura."
                    FontSize="12"
                    Foreground="{StaticResource BandaMutedBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing
                    x:Name="ExplorerLoadingRing"
                    Width="19"
                    Height="19"
                    IsActive="False"
                    Visibility="Collapsed" />
                <TextBlock
                    Text="BUILD 7A"
                    Foreground="{StaticResource BandaAccentBrush}"
                    FontSize="12"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Barra de navegación, ruta y búsqueda local. -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <Button
                    x:Name="ExplorerBackButton"
                    Content="←"
                    Click="ExplorerBackButton_Click"
                    IsEnabled="False"
                    Width="37" Height="39" Padding="0"
                    Background="{StaticResource BandaCardBrush}"
                    BorderBrush="{StaticResource BandaBorderBrush}"
                    BorderThickness="1" CornerRadius="10" />
                <Button
                    x:Name="ExplorerForwardButton"
                    Content="→"
                    Click="ExplorerForwardButton_Click"
                    IsEnabled="False"
                    Width="37" Height="39" Padding="0"
                    Background="{StaticResource BandaCardBrush}"
                    BorderBrush="{StaticResource BandaBorderBrush}"
                    BorderThickness="1" CornerRadius="10" />
                <Button
                    x:Name="ExplorerUpButton"
                    Content="↑"
                    Click="ExplorerUpButton_Click"
                    IsEnabled="False"
                    Width="37" Height="39" Padding="0"
                    Background="{StaticResource BandaCardBrush}"
                    BorderBrush="{StaticResource BandaBorderBrush}"
                    BorderThickness="1" CornerRadius="10" />
                <Button
                    x:Name="ExplorerRefreshButton"
                    Content="↻"
                    Click="ExplorerRefreshButton_Click"
                    Width="37" Height="39" Padding="0"
                    Background="{StaticResource BandaCardBrush}"
                    BorderBrush="{StaticResource BandaBorderBrush}"
                    BorderThickness="1" CornerRadius="10" />
            </StackPanel>

            <Border
                Grid.Column="1"
                CornerRadius="10"
                Background="{StaticResource BandaCardAltBrush}"
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="1"
                Padding="8,2">
                <Grid>
                    <ScrollViewer
                        x:Name="ExplorerBreadcrumbScroll"
                        VerticalScrollBarVisibility="Disabled"
                        HorizontalScrollBarVisibility="Hidden"
                        HorizontalScrollMode="Auto">
                        <StackPanel x:Name="ExplorerBreadcrumbPanel" Orientation="Horizontal" Spacing="2" />
                    </ScrollViewer>
                    <TextBox
                        x:Name="ExplorerAddressBox"
                        Visibility="Collapsed"
                        BorderThickness="0"
                        Background="Transparent"
                        FontSize="13"
                        VerticalAlignment="Center"
                        KeyDown="ExplorerAddressBox_KeyDown"
                        LostFocus="ExplorerAddressBox_LostFocus" />
                </Grid>
            </Border>

            <Button
                Grid.Column="2"
                Content="Ruta"
                Click="ExplorerEditAddressButton_Click"
                Padding="10,6"
                CornerRadius="10"
                Background="{StaticResource BandaCardBrush}"
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="1" />

            <TextBox
                x:Name="ExplorerFilterBox"
                Grid.Column="3"
                PlaceholderText="Filtrar esta carpeta..."
                TextChanged="ExplorerFilterBox_TextChanged"
                VerticalAlignment="Center"
                FontSize="13" />
        </Grid>

        <!-- Paneles: ubicaciones, archivos y detalles -->
        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="255" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{StaticResource BandaCardBrush}"
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="10,14" Spacing="4">
                        <TextBlock Text="UBICACIONES" Margin="8,0,0,8"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource BandaMutedBrush}" />
                        <Button Content="Este equipo" Tag="thispc" Click="ExplorerShortcutButton_Click"
                                Style="{StaticResource BandaPopupOptionButtonStyle}" />
                        <Button Content="Escritorio" Tag="desktop" Click="ExplorerShortcutButton_Click"
                                Style="{StaticResource BandaPopupOptionButtonStyle}" />
                        <Button Content="Descargas" Tag="downloads" Click="ExplorerShortcutButton_Click"
                                Style="{StaticResource BandaPopupOptionButtonStyle}" />
                        <Button Content="Documentos" Tag="documents" Click="ExplorerShortcutButton_Click"
                                Style="{StaticResource BandaPopupOptionButtonStyle}" />
                        <Button Content="Imágenes" Tag="pictures" Click="ExplorerShortcutButton_Click"
                                Style="{StaticResource BandaPopupOptionButtonStyle}" />

                        <Rectangle Height="1" Fill="{StaticResource BandaBorderBrush}" Margin="5,10" />
                        <TextBlock Text="BANDANV" Margin="8,0,0,8"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource BandaMutedBrush}" />
                        <Button Content="Origen" Tag="source" Click="ExplorerShortcutButton_Click"
                                Style="{StaticResource BandaPopupOptionButtonStyle}" />
                        <Button Content="Organizado" Tag="destination" Click="ExplorerShortcutButton_Click"
                                Style="{StaticResource BandaPopupOptionButtonStyle}" />

                        <Rectangle Height="1" Fill="{StaticResource BandaBorderBrush}" Margin="5,10" />
                        <TextBlock Text="UNIDADES" Margin="8,0,0,8"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource BandaMutedBrush}" />
                        <StackPanel x:Name="ExplorerDrivesSidebar" Spacing="2" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border
                Grid.Column="1"
                Background="{StaticResource BandaCardBrush}"
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Padding="14,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="0.8*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Nombre" Foreground="{StaticResource BandaMutedStrongBrush}"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Modificación"
                                   Foreground="{StaticResource BandaMutedStrongBrush}"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Tipo"
                                   Foreground="{StaticResource BandaMutedStrongBrush}"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="Tamaño"
                                   Foreground="{StaticResource BandaMutedStrongBrush}"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                    <ListView
                        x:Name="ExplorerFilesList"
                        Grid.Row="1"
                        Margin="4,0,4,4"
                        SelectionMode="Extended"
                        ItemTemplate="{StaticResource ExplorerFileTemplate}"
                        SelectionChanged="ExplorerFilesList_SelectionChanged"
                        DoubleTapped="ExplorerFilesList_DoubleTapped"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <TextBlock
                        x:Name="ExplorerFolderNotice"
                        Grid.Row="2"
                        Visibility="Collapsed"
                        Padding="14,9"
                        Foreground="{StaticResource BandaMutedStrongBrush}"
                        TextWrapping="Wrap"
                        FontSize="12" />
                </Grid>
            </Border>

            <Border
                Grid.Column="2"
                Background="{StaticResource BandaCardBrush}"
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="14,16" Spacing="10">
                        <TextBlock Text="DETALLES" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource BandaMutedBrush}" />
                        <controls:BandaImagePreview x:Name="ExplorerSelectedPreview" />
                        <TextBlock x:Name="ExplorerDetailName"
                                   Text="Seleccioná un archivo o carpeta."
                                   FontSize="15" FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource BandaTextBrush}" />
                        <TextBlock x:Name="ExplorerDetailType"
                                   Foreground="{StaticResource BandaMutedStrongBrush}"
                                   TextWrapping="Wrap" FontSize="12" />
                        <TextBlock x:Name="ExplorerDetailSize"
                                   Foreground="{StaticResource BandaMutedStrongBrush}"
                                   TextWrapping="Wrap" FontSize="12" />
                        <TextBlock x:Name="ExplorerDetailModified"
                                   Foreground="{StaticResource BandaMutedStrongBrush}"
                                   TextWrapping="Wrap" FontSize="12" />
                        <TextBlock x:Name="ExplorerDetailPath"
                                   Foreground="{StaticResource BandaMutedBrush}"
                                   TextWrapping="Wrap" FontSize="11" IsTextSelectionEnabled="True" />
                        <Button x:Name="ExplorerOpenSelectionButton"
                                Content="Abrir"
                                Click="ExplorerOpenSelectionButton_Click"
                                IsEnabled="False"
                                Style="{StaticResource BandaPopupSecondaryButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ExplorerStatusText"
                       Text="Preparando explorador..."
                       FontSize="12"
                       Foreground="{StaticResource BandaMutedStrongBrush}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="ExplorerSelectionCountText"
                       Grid.Column="1"
                       Text=""
                       FontSize="12"
                       Foreground="{StaticResource BandaMutedStrongBrush}" />
        </Grid>
    </Grid>
</Page>
