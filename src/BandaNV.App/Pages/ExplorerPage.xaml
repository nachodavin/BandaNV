<Page
    x:Class="BandaNV.App.Pages.ExplorerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BandaNV.Core.Models"
    xmlns:controls="using:BandaNV.App.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    Background="Transparent"
    Loaded="ExplorerPage_Loaded"
    Unloaded="ExplorerPage_Unloaded">

    <Page.Resources>
        <!-- Un mismo ancho para el encabezado y cada fila virtualizada. -->
        <controls:ExplorerColumnLayout x:Key="ExplorerColumnLayout" />
        <!-- Thumb de WinUI: captura el arrastre; el Grid padre define el cursor. -->
        <ControlTemplate x:Key="ExplorerTransparentThumbTemplate"
                         TargetType="primitives:Thumb">
            <Grid Background="Transparent" />
        </ControlTemplate>
        <DataTemplate x:Key="ExplorerFileTemplate" x:DataType="models:ExplorerItem">
            <Grid Padding="10,4" ColumnSpacing="12" Height="{x:Bind RowHeight}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="180" Width="{Binding Source={StaticResource ExplorerColumnLayout}, Path=NameWidth}" />
                    <ColumnDefinition MinWidth="130" Width="{Binding Source={StaticResource ExplorerColumnLayout}, Path=ModifiedWidth}" />
                    <ColumnDefinition MinWidth="100" Width="{Binding Source={StaticResource ExplorerColumnLayout}, Path=TypeWidth}" />
                    <ColumnDefinition MinWidth="85" Width="{Binding Source={StaticResource ExplorerColumnLayout}, Path=SizeWidth}" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                    <controls:ExplorerItemIcon
                        FilePath="{x:Bind FullPath}"
                        IsDirectory="{x:Bind IsDirectory}"
                        IsDrive="{x:Bind IsDrive}"
                        Width="23" Height="23"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind DisplayName}"
                        FontSize="13"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{StaticResource BandaTextBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind ModifiedText}"
                    FontSize="12"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{StaticResource BandaMutedStrongBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="2"
                    Text="{x:Bind TypeName}"
                    FontSize="12"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{StaticResource BandaMutedStrongBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="3"
                    Text="{x:Bind SizeText}"
                    FontSize="12"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{StaticResource BandaMutedStrongBrush}"
                    VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="0" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="52" />
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="27" />
        </Grid.RowDefinitions>

        <!-- Pestaña visual de explorador: menos encabezados, más espacio para archivos. -->
        <Grid Background="{StaticResource BandaSidebarBrush}">
            <Border Width="205"
                    Margin="10,5,0,0"
                    HorizontalAlignment="Left"
                    CornerRadius="9,9,0,0"
                    Background="{StaticResource BandaCardBrush}"
                    BorderBrush="{StaticResource BandaBorderBrush}"
                    BorderThickness="1,1,1,0">
                <Grid Padding="13,0" ColumnSpacing="9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8B7;" FontSize="16"
                              Foreground="{StaticResource BandaAccentBrush}"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="Explorar"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{StaticResource BandaTextBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,0,16,0">
                <ProgressRing
                    x:Name="ExplorerLoadingRing"
                    Width="17" Height="17"
                    IsActive="False"
                    Visibility="Collapsed" />
                <TextBlock Text="Solo lectura · BUILD 7A"
                           FontSize="11"
                           Foreground="{StaticResource BandaMutedBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Barra de navegación, ruta y búsqueda local. -->
        <Grid Grid.Row="1" ColumnSpacing="8"
              Padding="12,7"
              Background="{StaticResource BandaCardBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <Button
                    x:Name="ExplorerBackButton"
                    ToolTipService.ToolTip="Atrás"
                    Click="ExplorerBackButton_Click"
                    IsEnabled="False"
                    Width="37" Height="39" Padding="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0" CornerRadius="10" >
                    <FontIcon Glyph="&#xE72A;" FontSize="16" />
                </Button>
                <Button
                    x:Name="ExplorerForwardButton"
                    ToolTipService.ToolTip="Adelante"
                    Click="ExplorerForwardButton_Click"
                    IsEnabled="False"
                    Width="37" Height="39" Padding="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0" CornerRadius="10" >
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <Button
                    x:Name="ExplorerUpButton"
                    ToolTipService.ToolTip="Subir un nivel"
                    Click="ExplorerUpButton_Click"
                    IsEnabled="False"
                    Width="37" Height="39" Padding="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0" CornerRadius="10" >
                    <FontIcon Glyph="&#xE74A;" FontSize="16" />
                </Button>
                <Button
                    x:Name="ExplorerRefreshButton"
                    ToolTipService.ToolTip="Actualizar"
                    Click="ExplorerRefreshButton_Click"
                    Width="37" Height="39" Padding="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0" CornerRadius="10" >
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                </Button>
            </StackPanel>

            <Border
                Grid.Column="1"
                CornerRadius="10"
                Background="{StaticResource BandaCardAltBrush}"
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="1"
                Padding="8,2">
                <Grid>
                    <ScrollViewer
                        x:Name="ExplorerBreadcrumbScroll"
                        VerticalScrollBarVisibility="Disabled"
                        HorizontalScrollBarVisibility="Hidden"
                        HorizontalScrollMode="Auto">
                        <StackPanel x:Name="ExplorerBreadcrumbPanel" Orientation="Horizontal" Spacing="2" />
                    </ScrollViewer>
                    <TextBox
                        x:Name="ExplorerAddressBox"
                        Visibility="Collapsed"
                        BorderThickness="0"
                        Background="Transparent"
                        FontSize="13"
                        VerticalAlignment="Center"
                        KeyDown="ExplorerAddressBox_KeyDown"
                        LostFocus="ExplorerAddressBox_LostFocus" />
                </Grid>
            </Border>

            <Button
                Grid.Column="2"
                Content="Ruta"
                Click="ExplorerEditAddressButton_Click"
                Padding="10,6"
                CornerRadius="10"
                Background="{StaticResource BandaCardBrush}"
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="1" />

            <TextBox
                x:Name="ExplorerFilterBox"
                Grid.Column="3"
                PlaceholderText="Filtrar esta carpeta..."
                TextChanged="ExplorerFilterBox_TextChanged"
                VerticalAlignment="Center"
                FontSize="13" />
        </Grid>

        <!-- Barra única, alineada a la izquierda, igual que en el Explorador de Windows. -->
        <Grid Grid.Row="2"
              Background="{StaticResource BandaCardBrush}"
              Padding="12,3"
              ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0"
                          HorizontalAlignment="Stretch"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Hidden"
                          HorizontalScrollMode="Auto"
                          VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="3"
                            VerticalAlignment="Center">
                    <!-- Nuevas operaciones se habilitarán al implementar el motor de la BUILD 7B. -->
                    <Button x:Name="ExplorerToolbarNewButton"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Nueva carpeta · disponible en BUILD 7B"
                            Background="Transparent" BorderThickness="0"
                            CornerRadius="7" Padding="10,7" MinHeight="36">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE710;" FontSize="15" />
                            <TextBlock Text="Nuevo" FontSize="13" VerticalAlignment="Center" />
                            <FontIcon Glyph="&#xE70D;" FontSize="9" />
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="22" Margin="7,0"
                               Fill="{StaticResource BandaBorderBrush}" />

                    <Button x:Name="ExplorerToolbarCutButton"
                            Click="ExplorerToolbarCutButton_Click"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Cortar archivos y carpetas (Ctrl+X)"
                            Background="Transparent" BorderThickness="0"
                            CornerRadius="7" Padding="12,7" MinHeight="36">
                        <FontIcon Glyph="&#xE8C6;" FontSize="16" />
                    </Button>
                    <Button x:Name="ExplorerToolbarCopyButton"
                            Click="ExplorerToolbarCopyButton_Click"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Copiar archivos y carpetas (Ctrl+C)"
                            Background="Transparent" BorderThickness="0"
                            CornerRadius="7" Padding="12,7" MinHeight="36">
                        <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                    </Button>
                    <Button x:Name="ExplorerToolbarPasteButton"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Pegar archivos · disponible en BUILD 7B"
                            Background="Transparent" BorderThickness="0"
                            CornerRadius="7" Padding="12,7" MinHeight="36">
                        <FontIcon Glyph="&#xE77F;" FontSize="16" />
                    </Button>
                    <Button x:Name="ExplorerToolbarRenameButton"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Renombrar · disponible en BUILD 7B"
                            Background="Transparent" BorderThickness="0"
                            CornerRadius="7" Padding="12,7" MinHeight="36">
                        <FontIcon Glyph="&#xE8AC;" FontSize="16" />
                    </Button>
                    <Button x:Name="ExplorerToolbarShareButton"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Compartir · disponible en una próxima BUILD"
                            Background="Transparent" BorderThickness="0"
                            CornerRadius="7" Padding="12,7" MinHeight="36">
                        <FontIcon Glyph="&#xE72D;" FontSize="16" />
                    </Button>
                    <Button x:Name="ExplorerToolbarDeleteButton"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Eliminar · disponible en BUILD 7B"
                            Background="Transparent" BorderThickness="0"
                            CornerRadius="7" Padding="12,7" MinHeight="36">
                        <FontIcon Glyph="&#xE74D;" FontSize="16" />
                    </Button>

                    <Rectangle Width="1" Height="22" Margin="7,0"
                               Fill="{StaticResource BandaBorderBrush}" />

                    <Button x:Name="ExplorerToolbarOrganizeButton"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Organizar selección con BandaNV · próximamente"
                            Background="Transparent" BorderThickness="0"
                            CornerRadius="7" Padding="11,7" MinHeight="36">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE8F1;" FontSize="15" />
                            <TextBlock Text="Organizar" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Ordenar, Ver y Más continúan junto a las acciones principales. -->
                    <Rectangle Width="1" Height="22" Margin="7,0"
                               Fill="{StaticResource BandaBorderBrush}" />

                <Button x:Name="ExplorerToolbarSortButton"
                        Padding="10,7" MinHeight="36"
                        Background="Transparent" BorderThickness="0"
                        CornerRadius="7" ToolTipService.ToolTip="Ordenar y agrupar">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE8CB;" FontSize="15" />
                        <TextBlock Text="Ordenar" FontSize="13" VerticalAlignment="Center" />
                        <FontIcon Glyph="&#xE70D;" FontSize="9" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft"
                                FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                            <Border Padding="6" Width="210" CornerRadius="12"
                                    Background="{StaticResource BandaPopupSurfaceBrush}"
                                    BorderBrush="{StaticResource BandaBorderStrongBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="ExplorerSortLabel"
                                               Text="Ordenar: Fecha"
                                               Margin="9,6,9,5" FontSize="11"
                                               Foreground="{StaticResource BandaMutedStrongBrush}" />
                                    <Button Content="Nombre" Tag="name"
                                            Click="ExplorerSortFieldButton_Click"
                                            Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                    <Button Content="Fecha de modificación" Tag="modified"
                                            Click="ExplorerSortFieldButton_Click"
                                            Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                    <Button Content="Tipo" Tag="type"
                                            Click="ExplorerSortFieldButton_Click"
                                            Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                    <Button Content="Más  ›"
                                            Style="{StaticResource BandaPopupOptionButtonStyle}">
                                        <Button.Flyout>
                                            <Flyout Placement="RightEdgeAlignedTop"
                                                    FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                                                <Border Padding="6" Width="185"
                                                        CornerRadius="12"
                                                        Background="{StaticResource BandaPopupSurfaceBrush}"
                                                        BorderBrush="{StaticResource BandaBorderStrongBrush}"
                                                        BorderThickness="1">
                                                    <StackPanel Spacing="2">
                                                        <Button Content="Tamaño" Tag="size"
                                                                Click="ExplorerSortFieldButton_Click"
                                                                Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                        <Button Content="Fecha de creación" IsEnabled="False"
                                                                Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                    </StackPanel>
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Rectangle Height="1" Fill="{StaticResource BandaBorderBrush}"
                                               Margin="6,5" />
                                    <Button Content="Ascendente" Tag="asc"
                                            Click="ExplorerSortDirectionButton_Click"
                                            Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                    <Button Content="Descendente" Tag="desc"
                                            Click="ExplorerSortDirectionButton_Click"
                                            Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                    <Rectangle Height="1" Fill="{StaticResource BandaBorderBrush}"
                                               Margin="6,5" />
                                    <Button Content="Agrupar por  ›"
                                            Style="{StaticResource BandaPopupOptionButtonStyle}">
                                        <Button.Flyout>
                                            <Flyout Placement="RightEdgeAlignedTop"
                                                    FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                                                <Border Padding="6" Width="220"
                                                        CornerRadius="12"
                                                        Background="{StaticResource BandaPopupSurfaceBrush}"
                                                        BorderBrush="{StaticResource BandaBorderStrongBrush}"
                                                        BorderThickness="1">
                                                    <StackPanel Spacing="2">
                                                        <Button Content="Nombre" Tag="name"
                                                                Click="ExplorerGroupFieldButton_Click"
                                                                Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                        <Button Content="Fecha de modificación" Tag="modified"
                                                                Click="ExplorerGroupFieldButton_Click"
                                                                Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                        <Button Content="Tipo" Tag="type"
                                                                Click="ExplorerGroupFieldButton_Click"
                                                                Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                        <Button Content="Tamaño" Tag="size"
                                                                Click="ExplorerGroupFieldButton_Click"
                                                                Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                        <Button Content="Fecha de creación" IsEnabled="False"
                                                                Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                        <Button Content="Autores" IsEnabled="False"
                                                                Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                        <Button Content="Categorías" IsEnabled="False"
                                                                Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                        <Button Content="Etiquetas" IsEnabled="False"
                                                                Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                        <Button Content="Título" IsEnabled="False"
                                                                Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                        <Rectangle Height="1" Fill="{StaticResource BandaBorderBrush}"
                                                                   Margin="6,5" />
                                                        <Button Content="(Ninguno)" Tag="none"
                                                                Click="ExplorerGroupFieldButton_Click"
                                                                Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                    </StackPanel>
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button x:Name="ExplorerToolbarViewButton"
                        ToolTipService.ToolTip="Opciones de visualización"
                        Padding="10,7" MinHeight="36"
                        Background="Transparent" BorderThickness="0"
                        CornerRadius="7">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE8A9;" FontSize="15" />
                        <TextBlock Text="Ver" FontSize="13" VerticalAlignment="Center" />
                        <FontIcon Glyph="&#xE70D;" FontSize="9" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft"
                                FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                            <Border Padding="6" Width="240" CornerRadius="12"
                                    Background="{StaticResource BandaPopupSurfaceBrush}"
                                    BorderBrush="{StaticResource BandaBorderStrongBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="MODO DE VISTA" Margin="9,6,9,4" FontSize="11"
                                               Foreground="{StaticResource BandaMutedStrongBrush}" />
                                    <Button Content="Íconos extragrandes" IsEnabled="False"
                                            Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                    <Button Content="Íconos grandes" IsEnabled="False"
                                            Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                    <Button Content="Íconos medianos" IsEnabled="False"
                                            Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                    <Button Content="Íconos pequeños" IsEnabled="False"
                                            Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                    <Button Content="Lista" IsEnabled="False"
                                            Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                    <Button Content="✓ Detalles" Tag="details"
                                            Click="ExplorerViewModeButton_Click"
                                            Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                    <Button Content="Mosaicos" IsEnabled="False"
                                            Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                    <Button Content="Contenido" IsEnabled="False"
                                            Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                    <Rectangle Height="1" Fill="{StaticResource BandaBorderBrush}"
                                               Margin="6,5" />
                                    <Button x:Name="ExplorerViewDetailsMenuButton"
                                            Content="✓ Panel de detalles"
                                            Click="ExplorerViewDetailsMenuButton_Click"
                                            Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                    <Button x:Name="ExplorerViewPreviewMenuButton"
                                            Content="Panel de vista previa"
                                            Click="ExplorerViewPreviewMenuButton_Click"
                                            Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                    <Rectangle Height="1" Fill="{StaticResource BandaBorderBrush}"
                                               Margin="6,5" />
                                    <Button Content="Mostrar  ›"
                                            Style="{StaticResource BandaPopupOptionButtonStyle}">
                                        <Button.Flyout>
                                            <Flyout Placement="RightEdgeAlignedTop"
                                                    FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                                                <Border Padding="6" Width="250" CornerRadius="12"
                                                        Background="{StaticResource BandaPopupSurfaceBrush}"
                                                        BorderBrush="{StaticResource BandaBorderStrongBrush}"
                                                        BorderThickness="1">
                                                    <StackPanel Spacing="2">
                                                        <Button x:Name="ExplorerShowNavigationButton"
                                                                Content="✓ Panel de navegación"
                                                                Tag="navigation"
                                                                Click="ExplorerViewShowOption_Click"
                                                                Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                        <Button x:Name="ExplorerShowCompactButton"
                                                                Content="Vista compacta"
                                                                Tag="compact"
                                                                Click="ExplorerViewShowOption_Click"
                                                                Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                        <Button x:Name="ExplorerShowCheckboxesButton"
                                                                Content="✓ Casillas de selección"
                                                                Tag="checkboxes"
                                                                Click="ExplorerViewShowOption_Click"
                                                                Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                        <Button x:Name="ExplorerShowExtensionsButton"
                                                                Content="✓ Extensiones de nombre"
                                                                Tag="extensions"
                                                                Click="ExplorerViewShowOption_Click"
                                                                Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                        <Button x:Name="ExplorerShowHiddenButton"
                                                                Content="Elementos ocultos"
                                                                Tag="hidden"
                                                                Click="ExplorerViewShowOption_Click"
                                                                Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                    </StackPanel>
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button x:Name="ExplorerToolbarMoreButton"
                        ToolTipService.ToolTip="Más opciones"
                        Padding="12,7" MinHeight="36"
                        Background="Transparent" BorderThickness="0"
                        CornerRadius="7">
                    <FontIcon Glyph="&#xE712;" FontSize="18" />
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft"
                                FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                            <Border Padding="6" Width="240" CornerRadius="12"
                                    Background="{StaticResource BandaPopupSurfaceBrush}"
                                    BorderBrush="{StaticResource BandaBorderStrongBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="2">
                                    <Button Content="Anclar a Acceso rápido"
                                            IsEnabled="False"
                                            Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                    <Rectangle Height="1" Fill="{StaticResource BandaBorderBrush}" Margin="6,4" />
                                    <Button x:Name="ExplorerSelectAllButton"
                                            Content="Seleccionar todo"
                                            Click="ExplorerSelectAllButton_Click"
                                            Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                    <Button x:Name="ExplorerSelectNoneButton"
                                            Content="No seleccionar nada"
                                            Click="ExplorerSelectNoneButton_Click"
                                            IsEnabled="False"
                                            Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                    <Button x:Name="ExplorerInvertSelectionButton"
                                            Content="Invertir selección"
                                            Click="ExplorerInvertSelectionButton_Click"
                                            Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                    <Rectangle Height="1" Fill="{StaticResource BandaBorderBrush}" Margin="6,4" />
                                    <Button x:Name="ExplorerPropertiesButton"
                                            Content="Propiedades"
                                            Click="ExplorerPropertiesButton_Click"
                                            IsEnabled="False"
                                            Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                    <Button Content="Opciones de BandaNV"
                                            Click="ExplorerOptionsButton_Click"
                                            Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                    <Rectangle Height="1" Fill="{StaticResource BandaBorderBrush}" Margin="6,4" />
                                    <Button x:Name="ExplorerToolbarOpenButton"
                                            Content="Abrir"
                                            Click="ExplorerOpenSelectionButton_Click"
                                            IsEnabled="False"
                                            Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                    <Button x:Name="ExplorerToolbarCopyPathButton"
                                            Content="Copiar ruta"
                                            Click="ExplorerCopyPathButton_Click"
                                            IsEnabled="False"
                                            Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                </StackPanel>
            </ScrollViewer>

            <!-- Solo Detalles queda fijo a la derecha, fuera del área desplazable. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center" Spacing="3">
                <Rectangle Width="1" Height="22" Margin="7,0"
                           Fill="{StaticResource BandaBorderBrush}" />
                <Button x:Name="ExplorerToggleDetailsButton"
                        Click="ExplorerToggleDetailsButton_Click"
                        ToolTipService.ToolTip="Mostrar u ocultar el panel derecho"
                        Padding="11,7" MinHeight="36"
                        Background="Transparent" BorderThickness="0"
                        CornerRadius="7">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE8A7;" FontSize="15" />
                        <TextBlock Text="Detalles" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Paneles: ubicaciones, archivos y detalles -->
        <Grid x:Name="ExplorerContentGrid" Grid.Row="3" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ExplorerLocationsColumn" Width="185" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ExplorerDetailsDividerColumn" Width="14" />
                <ColumnDefinition x:Name="ExplorerDetailsColumn" Width="280" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="ExplorerLocationsPane"
                Grid.Column="0"
                Background="{StaticResource BandaBackgroundBrush}"
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="10,14" Spacing="4">
                        <TextBlock Text="UBICACIONES" Margin="8,0,0,8"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource BandaMutedBrush}" />
                        <Button Tag="thispc" Click="ExplorerShortcutButton_Click"
                                Padding="10,8" CornerRadius="7"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <FontIcon Glyph="&#xE7F4;" FontSize="15"
                                          Foreground="{StaticResource BandaMutedStrongBrush}" />
                                <TextBlock Text="Este equipo" FontSize="13"
                                           Foreground="{StaticResource BandaTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="desktop" Click="ExplorerShortcutButton_Click"
                                Padding="10,8" CornerRadius="7"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <FontIcon Glyph="&#xE80F;" FontSize="15"
                                          Foreground="{StaticResource BandaMutedStrongBrush}" />
                                <TextBlock Text="Escritorio" FontSize="13"
                                           Foreground="{StaticResource BandaTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="downloads" Click="ExplorerShortcutButton_Click"
                                Padding="10,8" CornerRadius="7"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <FontIcon Glyph="&#xE896;" FontSize="15"
                                          Foreground="{StaticResource BandaMutedStrongBrush}" />
                                <TextBlock Text="Descargas" FontSize="13"
                                           Foreground="{StaticResource BandaTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="documents" Click="ExplorerShortcutButton_Click"
                                Padding="10,8" CornerRadius="7"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <FontIcon Glyph="&#xE8A5;" FontSize="15"
                                          Foreground="{StaticResource BandaMutedStrongBrush}" />
                                <TextBlock Text="Documentos" FontSize="13"
                                           Foreground="{StaticResource BandaTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="pictures" Click="ExplorerShortcutButton_Click"
                                Padding="10,8" CornerRadius="7"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <FontIcon Glyph="&#xEB9F;" FontSize="15"
                                          Foreground="{StaticResource BandaMutedStrongBrush}" />
                                <TextBlock Text="Imágenes" FontSize="13"
                                           Foreground="{StaticResource BandaTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Rectangle Height="1" Fill="{StaticResource BandaBorderBrush}" Margin="5,10" />
                        <TextBlock Text="BANDANV" Margin="8,0,0,8"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource BandaMutedBrush}" />
                        <Button Tag="source" Click="ExplorerShortcutButton_Click"
                                Padding="10,8" CornerRadius="7"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <FontIcon Glyph="&#xE8B7;" FontSize="15"
                                          Foreground="{StaticResource BandaMutedStrongBrush}" />
                                <TextBlock Text="Origen" FontSize="13"
                                           Foreground="{StaticResource BandaTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="destination" Click="ExplorerShortcutButton_Click"
                                Padding="10,8" CornerRadius="7"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <FontIcon Glyph="&#xE8B7;" FontSize="15"
                                          Foreground="{StaticResource BandaMutedStrongBrush}" />
                                <TextBlock Text="Organizado" FontSize="13"
                                           Foreground="{StaticResource BandaTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Rectangle Height="1" Fill="{StaticResource BandaBorderBrush}" Margin="5,10" />
                        <TextBlock Text="UNIDADES" Margin="8,0,0,8"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource BandaMutedBrush}" />
                        <StackPanel x:Name="ExplorerDrivesSidebar" Spacing="2" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border
                Grid.Column="1"
                Background="{StaticResource BandaBackgroundBrush}"
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Encabezados redimensionables con zonas de arrastre. -->
                    <Grid x:Name="ExplorerColumnHeaders"
                          Padding="10,8" Margin="4,0,4,0"
                          ColumnSpacing="12" MinWidth="590">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ExplorerHeaderNameColumn"
                                              MinWidth="180"
                                              Width="{Binding Source={StaticResource ExplorerColumnLayout}, Path=NameWidth}" />
                            <ColumnDefinition x:Name="ExplorerHeaderModifiedColumn"
                                              MinWidth="130"
                                              Width="{Binding Source={StaticResource ExplorerColumnLayout}, Path=ModifiedWidth}" />
                            <ColumnDefinition x:Name="ExplorerHeaderTypeColumn"
                                              MinWidth="100"
                                              Width="{Binding Source={StaticResource ExplorerColumnLayout}, Path=TypeWidth}" />
                            <ColumnDefinition x:Name="ExplorerHeaderSizeColumn"
                                              MinWidth="85"
                                              Width="{Binding Source={StaticResource ExplorerColumnLayout}, Path=SizeWidth}" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Nombre"
                                   Foreground="{StaticResource BandaMutedStrongBrush}"
                                   FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,12,0" />
                        <controls:ExplorerResizeZone Grid.Column="0"
                                                 Width="18" Margin="0,0,-9,0"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Stretch"
                                                 ToolTipService.ToolTip="Arrastrar para ajustar ancho de nombre">
                            <primitives:Thumb Tag="name"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              Template="{StaticResource ExplorerTransparentThumbTemplate}"
                                              DragDelta="ExplorerColumnResize_DragDelta" />
                            <Rectangle IsHitTestVisible="False"
                                       Width="1"
                                       HorizontalAlignment="Center"
                                       Fill="{StaticResource BandaBorderStrongBrush}"
                                       Opacity="0.58" />
                        </controls:ExplorerResizeZone>
                        <TextBlock Grid.Column="1"
                                   Text="Modificación"
                                   Foreground="{StaticResource BandaMutedStrongBrush}"
                                   FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,12,0" />
                        <controls:ExplorerResizeZone Grid.Column="1"
                                                 Width="18" Margin="0,0,-9,0"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Stretch"
                                                 ToolTipService.ToolTip="Arrastrar para ajustar ancho de modificación">
                            <primitives:Thumb Tag="modified"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              Template="{StaticResource ExplorerTransparentThumbTemplate}"
                                              DragDelta="ExplorerColumnResize_DragDelta" />
                            <Rectangle IsHitTestVisible="False"
                                       Width="1"
                                       HorizontalAlignment="Center"
                                       Fill="{StaticResource BandaBorderStrongBrush}"
                                       Opacity="0.58" />
                        </controls:ExplorerResizeZone>
                        <TextBlock Grid.Column="2"
                                   Text="Tipo"
                                   Foreground="{StaticResource BandaMutedStrongBrush}"
                                   FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,12,0" />
                        <controls:ExplorerResizeZone Grid.Column="2"
                                                 Width="18" Margin="0,0,-9,0"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Stretch"
                                                 ToolTipService.ToolTip="Arrastrar para ajustar ancho de tipo">
                            <primitives:Thumb Tag="type"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              Template="{StaticResource ExplorerTransparentThumbTemplate}"
                                              DragDelta="ExplorerColumnResize_DragDelta" />
                            <Rectangle IsHitTestVisible="False"
                                       Width="1"
                                       HorizontalAlignment="Center"
                                       Fill="{StaticResource BandaBorderStrongBrush}"
                                       Opacity="0.58" />
                        </controls:ExplorerResizeZone>
                        <TextBlock Grid.Column="3"
                                   Text="Tamaño"
                                   Foreground="{StaticResource BandaMutedStrongBrush}"
                                   FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,12,0" />
                        <controls:ExplorerResizeZone Grid.Column="3"
                                                 Width="18" Margin="0,0,-9,0"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Stretch"
                                                 ToolTipService.ToolTip="Arrastrar para ajustar ancho de tamaño">
                            <primitives:Thumb Tag="size"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              Template="{StaticResource ExplorerTransparentThumbTemplate}"
                                              DragDelta="ExplorerColumnResize_DragDelta" />
                            <Rectangle IsHitTestVisible="False"
                                       Width="1"
                                       HorizontalAlignment="Center"
                                       Fill="{StaticResource BandaBorderStrongBrush}"
                                       Opacity="0.58" />
                        </controls:ExplorerResizeZone>
                    </Grid>
                    <ListView
                        x:Name="ExplorerFilesList"
                        Grid.Row="1"
                        Margin="4,0,4,4"
                        SelectionMode="Extended"
                        KeyboardAcceleratorPlacementMode="Hidden"
                        ItemTemplate="{StaticResource ExplorerFileTemplate}"
                        SelectionChanged="ExplorerFilesList_SelectionChanged"
                        DoubleTapped="ExplorerFilesList_DoubleTapped"
                        IsMultiSelectCheckBoxEnabled="True"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.KeyboardAccelerators>
                            <KeyboardAccelerator Key="C" Modifiers="Control"
                                                 Invoked="ExplorerCopyShortcut_Invoked" />
                            <KeyboardAccelerator Key="X" Modifiers="Control"
                                                 Invoked="ExplorerCutShortcut_Invoked" />
                            <KeyboardAccelerator Key="A" Modifiers="Control"
                                                 Invoked="ExplorerSelectAllShortcut_Invoked" />
                        </ListView.KeyboardAccelerators>
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,9,10,5">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource BandaMutedStrongBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                    </ListView>
                    <TextBlock
                        x:Name="ExplorerFolderNotice"
                        Grid.Row="2"
                        Visibility="Collapsed"
                        Padding="14,9"
                        Foreground="{StaticResource BandaMutedStrongBrush}"
                        TextWrapping="Wrap"
                        FontSize="12" />
                </Grid>
            </Border>

            <!-- Borde izquierdo del panel derecho: se arrastra como en Explorer. -->
            <controls:ExplorerResizeZone
                x:Name="ExplorerDetailsDivider"
                Grid.Column="2"
                Width="14"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ToolTipService.ToolTip="Arrastrar para ajustar el ancho de Detalles">
                <primitives:Thumb
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Template="{StaticResource ExplorerTransparentThumbTemplate}"
                    DragDelta="ExplorerDetailsResize_DragDelta" />
                <Rectangle IsHitTestVisible="False"
                           Width="1"
                           HorizontalAlignment="Center"
                           Fill="{StaticResource BandaBorderStrongBrush}"
                           Opacity="0.58" />
            </controls:ExplorerResizeZone>

            <!-- Detalles: estructura como Windows 11: imagen, nombre,
                 acción, tabla de metadatos y Propiedades. -->
            <Border
                x:Name="ExplorerDetailsPane"
                Grid.Column="3"
                Background="{StaticResource BandaBackgroundBrush}"
                BorderThickness="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="0">
                        <!-- Zona grande e independiente para miniaturas/íconos. -->
                        <Grid Height="215"
                              Background="{StaticResource BandaCardBrush}">
                            <controls:BandaImagePreview
                                x:Name="ExplorerSelectedPreview"
                                UseCompactExplorerFrame="True"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
                            <Border x:Name="ExplorerFileIconPanel"
                                    Background="Transparent"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <controls:ExplorerItemIcon
                                    x:Name="ExplorerSelectedFileIcon"
                                    IsLargePreview="True"
                                    Width="112"
                                    Height="112"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <!-- Datos de la selección con la jerarquía de Windows. -->
                        <StackPanel Padding="18,23,18,22" Spacing="0">
                            <TextBlock x:Name="ExplorerDetailName"
                                       Text="Seleccioná un archivo o carpeta."
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource BandaTextBrush}"
                                       Margin="0,0,0,12" />

                            <Button x:Name="ExplorerDetailShareButton"
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="Compartir estará disponible en una próxima BUILD"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,26"
                                    Style="{StaticResource BandaPopupSecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72D;" FontSize="14" />
                                    <TextBlock Text="Compartir" VerticalAlignment="Center" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <TextBlock x:Name="ExplorerDetailsHeading"
                                       Text="Detalles"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BandaTextBrush}"
                                       Margin="0,0,0,18" />

                            <Grid x:Name="ExplorerMetadataGrid"
                                  ColumnSpacing="10"
                                  RowSpacing="13"
                                  Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Tipo"
                                           Grid.Row="0"
                                           FontSize="12"
                                           Foreground="{StaticResource BandaMutedStrongBrush}" />
                                <TextBlock x:Name="ExplorerDetailType"
                                           Grid.Row="0" Grid.Column="1"
                                           TextAlignment="Right"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           Foreground="{StaticResource BandaTextBrush}" />

                                <TextBlock Text="Tamaño"
                                           Grid.Row="1"
                                           FontSize="12"
                                           Foreground="{StaticResource BandaMutedStrongBrush}" />
                                <TextBlock x:Name="ExplorerDetailSize"
                                           Grid.Row="1" Grid.Column="1"
                                           TextAlignment="Right"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource BandaTextBrush}" />

                                <TextBlock Text="Ubicación"
                                           Grid.Row="2"
                                           FontSize="12"
                                           Foreground="{StaticResource BandaMutedStrongBrush}" />
                                <TextBlock x:Name="ExplorerDetailPath"
                                           Grid.Row="2" Grid.Column="1"
                                           TextAlignment="Right"
                                           FontSize="12"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{Binding Text, ElementName=ExplorerDetailPath}"
                                           Foreground="{StaticResource BandaTextBrush}" />

                                <TextBlock Text="Modificado"
                                           Grid.Row="3"
                                           FontSize="12"
                                           Foreground="{StaticResource BandaMutedStrongBrush}" />
                                <TextBlock x:Name="ExplorerDetailModified"
                                           Grid.Row="3" Grid.Column="1"
                                           TextAlignment="Right"
                                           FontSize="12"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource BandaTextBrush}" />
                            </Grid>

                            <Button x:Name="ExplorerDetailPropertiesButton"
                                    Click="ExplorerPropertiesButton_Click"
                                    IsEnabled="False"
                                    HorizontalAlignment="Left"
                                    Padding="12,8"
                                    Style="{StaticResource BandaPopupSecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE90F;" FontSize="15" />
                                    <TextBlock Text="Propiedades" FontSize="12"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Windows 11: estado a la izquierda, con tres datos separados. -->
        <Grid Grid.Row="4"
              Background="{StaticResource BandaSidebarBrush}"
              Padding="12,4,12,4"
              ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        Spacing="9" VerticalAlignment="Center">
                <TextBlock x:Name="ExplorerTotalCountText"
                           Text="0 elementos"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BandaMutedStrongBrush}" />
                <TextBlock x:Name="ExplorerSelectionDivider"
                           Text="|" Visibility="Collapsed"
                           FontSize="12"
                           Foreground="{StaticResource BandaMutedBrush}" />
                <TextBlock x:Name="ExplorerSelectionCountText"
                           Text="" Visibility="Collapsed"
                           FontSize="12"
                           Foreground="{StaticResource BandaMutedStrongBrush}" />
                <TextBlock x:Name="ExplorerSelectionSizeDivider"
                           Text="|" Visibility="Collapsed"
                           FontSize="12"
                           Foreground="{StaticResource BandaMutedBrush}" />
                <TextBlock x:Name="ExplorerSelectionSizeText"
                           Text="" Visibility="Collapsed"
                           FontSize="12"
                           Foreground="{StaticResource BandaMutedStrongBrush}" />
            </StackPanel>

            <TextBlock x:Name="ExplorerStatusText"
                       Grid.Column="1"
                       Text=""
                       TextAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource BandaMutedStrongBrush}"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</Page>
