<Page
    x:Class="BandaNV.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="SettingsTabButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource BandaMutedStrongBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SettingsInlineButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{StaticResource BandaCardAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BandaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource BandaTextBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid
            Padding="34,32,34,40"
            RowSpacing="16">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <StackPanel Spacing="5">
                <TextBlock
                    Text="Configuración"
                    Style="{StaticResource BandaSectionTitleStyle}"
                    FontSize="32" />
                <TextBlock
                    Text="Definí cómo se comporta, se ve y protege tus archivos BandaNV."
                    Style="{StaticResource BandaMutedTextStyle}"
                    FontSize="14" />
            </StackPanel>

            <!-- Pestañas superiores -->
            <Border
                Grid.Row="1"
                Padding="6"
                CornerRadius="16"
                Background="{StaticResource BandaCardBrush}"
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="1">

                <ScrollViewer
                    HorizontalScrollMode="Auto"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Disabled">

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button
                            x:Name="GeneralTabButton"
                            Tag="General"
                            Content="General"
                            Click="SettingsTabButton_Click"
                            Style="{StaticResource SettingsTabButtonStyle}" />
                        <Button
                            x:Name="AppearanceTabButton"
                            Tag="Appearance"
                            Content="Apariencia"
                            Click="SettingsTabButton_Click"
                            Style="{StaticResource SettingsTabButtonStyle}" />
                        <Button
                            x:Name="OrganizationTabButton"
                            Tag="Organization"
                            Content="Organización"
                            Click="SettingsTabButton_Click"
                            Style="{StaticResource SettingsTabButtonStyle}" />
                        <Button
                            x:Name="HistorySecurityTabButton"
                            Tag="HistorySecurity"
                            Content="Historial y seguridad"
                            Click="SettingsTabButton_Click"
                            Style="{StaticResource SettingsTabButtonStyle}" />
                        <Button
                            x:Name="AdvancedTabButton"
                            Tag="Advanced"
                            Content="Avanzado"
                            Click="SettingsTabButton_Click"
                            Style="{StaticResource SettingsTabButtonStyle}" />
                        <Button
                            x:Name="AboutTabButton"
                            Tag="About"
                            Content="Acerca de"
                            Click="SettingsTabButton_Click"
                            Style="{StaticResource SettingsTabButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Feedback -->
            <Border
                x:Name="SettingsFeedbackBorder"
                Grid.Row="2"
                Padding="12,8"
                CornerRadius="11"
                Background="{StaticResource BandaAccentFaintBrush}"
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="1"
                Visibility="Collapsed">

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse
                        Width="7"
                        Height="7"
                        Fill="{StaticResource BandaAccentBrush}"
                        VerticalAlignment="Center" />

                    <TextBlock
                        x:Name="SettingsFeedbackText"
                        Grid.Column="1"
                        Text=""
                        Foreground="{StaticResource BandaMutedStrongBrush}"
                        FontSize="12"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap" />

                    <Button
                        Grid.Column="2"
                        Content="×"
                        Click="CloseSettingsFeedbackButton_Click"
                        Width="28"
                        Height="28"
                        Padding="0"
                        CornerRadius="8"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource BandaMutedStrongBrush}" />
                </Grid>
            </Border>

            <!-- Contenido de pestañas -->
            <Grid Grid.Row="3">

                <!-- GENERAL -->
                <ScrollViewer
                    x:Name="GeneralSettingsPanel"
                    VerticalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Spacing="14" Padding="0,0,12,0">

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="0.75*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Style="{StaticResource BandaCardStyle}"
                                Padding="24"
                                MinHeight="250">

                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Text="Ubicaciones"
                                            Foreground="{StaticResource BandaTextBrush}"
                                            FontSize="19"
                                            FontWeight="SemiBold" />
                                        <TextBlock
                                            Text="Definí de dónde toma los archivos BandaNV y dónde crea la organización."
                                            Style="{StaticResource BandaMutedTextStyle}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Border
                                        Padding="14"
                                        CornerRadius="12"
                                        Background="{StaticResource BandaCardAltBrush}"
                                        BorderBrush="{StaticResource BandaBorderBrush}"
                                        BorderThickness="1">

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="4">
                                                <TextBlock Text="CARPETA DE ORIGEN" Style="{StaticResource BandaLabelTextStyle}" FontSize="11" />
                                                <TextBlock
                                                    x:Name="SourceFolderText"
                                                    Text="C:\Users\Usuario\Downloads"
                                                    Foreground="{StaticResource BandaTextBrush}"
                                                    FontSize="13"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Button
                                                Grid.Column="1"
                                                Content="Cambiar"
                                                Click="ChangeSourceFolderButton_Click"
                                                Style="{StaticResource SettingsInlineButtonStyle}"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <Border
                                        Padding="14"
                                        CornerRadius="12"
                                        Background="{StaticResource BandaCardAltBrush}"
                                        BorderBrush="{StaticResource BandaBorderBrush}"
                                        BorderThickness="1">

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="4">
                                                <TextBlock Text="DESTINO" Style="{StaticResource BandaLabelTextStyle}" FontSize="11" />
                                                <TextBlock
                                                    x:Name="DestinationFolderText"
                                                    Text="C:\Users\Usuario\Downloads\ORGANIZADO"
                                                    Foreground="{StaticResource BandaTextBrush}"
                                                    FontSize="13"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Button
                                                Grid.Column="1"
                                                Content="Cambiar"
                                                Click="ChangeDestinationFolderButton_Click"
                                                Style="{StaticResource SettingsInlineButtonStyle}"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Column="1"
                                Style="{StaticResource BandaCardStyle}"
                                Padding="24"
                                MinHeight="250">

                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Text="Aplicación"
                                            Foreground="{StaticResource BandaTextBrush}"
                                            FontSize="19"
                                            FontWeight="SemiBold" />
                                        <TextBlock
                                            Text="Comportamiento general al abrir, cerrar y usar BandaNV."
                                            Style="{StaticResource BandaMutedTextStyle}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Página inicial" Foreground="{StaticResource BandaTextBrush}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="Sección que se abre al iniciar." Style="{StaticResource BandaMutedTextStyle}" FontSize="12" />
                                        </StackPanel>
                                        <Button
                                            x:Name="StartupPageSelectorButton"
                                            Grid.Column="1"
                                            Style="{StaticResource BandaSelectorButtonStyle}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="StartupPageValueText" Text="Inicio" Foreground="{StaticResource BandaTextBrush}" FontSize="13" />
                                                <TextBlock Grid.Column="1" Text="⌄" Foreground="{StaticResource BandaAccentBrush}" />
                                            </Grid>
                                            <Button.Flyout>
                                                <Flyout x:Name="StartupPageFlyout" Placement="BottomEdgeAlignedLeft" FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                                                    <Border Width="190" Padding="8" CornerRadius="16" Background="{StaticResource BandaPopupSurfaceBrush}" BorderBrush="{StaticResource BandaBorderStrongBrush}" BorderThickness="1">
                                                        <StackPanel Spacing="2">
                                                            <Button Tag="Inicio" Content="Inicio" Click="StartupPageOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                            <Button Tag="Organizar" Content="Organizar" Click="StartupPageOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                            <Button Tag="Buscar" Content="Buscar" Click="StartupPageOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Al cerrar la ventana" Foreground="{StaticResource BandaTextBrush}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="Qué hacer al presionar cerrar." Style="{StaticResource BandaMutedTextStyle}" FontSize="12" />
                                        </StackPanel>
                                        <Button
                                            x:Name="CloseBehaviorSelectorButton"
                                            Grid.Column="1"
                                            Style="{StaticResource BandaSelectorButtonStyle}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="CloseBehaviorValueText" Text="Cerrar BandaNV" Foreground="{StaticResource BandaTextBrush}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="⌄" Foreground="{StaticResource BandaAccentBrush}" />
                                            </Grid>
                                            <Button.Flyout>
                                                <Flyout x:Name="CloseBehaviorFlyout" Placement="BottomEdgeAlignedLeft" FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                                                    <Border Width="220" Padding="8" CornerRadius="16" Background="{StaticResource BandaPopupSurfaceBrush}" BorderBrush="{StaticResource BandaBorderStrongBrush}" BorderThickness="1">
                                                        <StackPanel Spacing="2">
                                                            <Button Tag="Cerrar BandaNV" Content="Cerrar BandaNV" Click="CloseBehaviorOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                            <Button Tag="Minimizar a bandeja" Content="Minimizar a bandeja" Click="CloseBehaviorOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Iniciar con Windows" Foreground="{StaticResource BandaTextBrush}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="Abrir BandaNV al iniciar sesión." Style="{StaticResource BandaMutedTextStyle}" FontSize="12" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="StartWithWindowsToggle" Grid.Column="1" IsOn="False" Toggled="GenericSettingToggle_Toggled" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Mostrar aviso de actualización al iniciar" Foreground="{StaticResource BandaTextBrush}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="El chequeo se realiza siempre; activalo para abrir automáticamente el aviso cuando haya una nueva versión." Style="{StaticResource BandaMutedTextStyle}" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AutoUpdateToggle" Grid.Column="1" IsOn="True" Toggled="GenericSettingToggle_Toggled" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- APARIENCIA -->
                <ScrollViewer
                    x:Name="AppearanceSettingsPanel"
                    Visibility="Collapsed"
                    VerticalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Spacing="14" Padding="0,0,12,0">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.92*" />
                                <ColumnDefinition Width="1.08*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource BandaCardStyle}" Padding="20">
                                <StackPanel Spacing="18">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Interfaz" Foreground="{StaticResource BandaTextBrush}" FontSize="19" FontWeight="SemiBold" />
                                        <TextBlock Text="Personalizá cómo se siente BandaNV sin alterar su estructura." Style="{StaticResource BandaMutedTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="190" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Tema" Foreground="{StaticResource BandaTextBrush}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="Modo visual de la aplicación." Style="{StaticResource BandaMutedTextStyle}" FontSize="12" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource BandaSelectorButtonStyle}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="ThemeValueText" Text="Oscuro" Foreground="{StaticResource BandaTextBrush}" FontSize="13" />
                                                <TextBlock Grid.Column="1" Text="⌄" Foreground="{StaticResource BandaAccentBrush}" />
                                            </Grid>
                                            <Button.Flyout>
                                                <Flyout x:Name="ThemeFlyout" Placement="BottomEdgeAlignedLeft" FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                                                    <Border Width="200" Padding="8" CornerRadius="16" Background="{StaticResource BandaPopupSurfaceBrush}" BorderBrush="{StaticResource BandaBorderStrongBrush}" BorderThickness="1">
                                                        <StackPanel Spacing="2">
                                                            <Button Tag="Oscuro" Content="Oscuro" Click="ThemeOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                            <Button Tag="Sistema" Content="Usar sistema" Click="ThemeOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                            <Button Tag="Claro" Content="Claro" Click="ThemeOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="190" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Color primario" Foreground="{StaticResource BandaTextBrush}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="Define fondos, cards y superficies." Style="{StaticResource BandaMutedTextStyle}" FontSize="12" />
                                        </StackPanel>

                                        <Button
                                            x:Name="PrimaryColorSelectorButton"
                                            Grid.Column="1"
                                            Style="{StaticResource BandaSelectorButtonStyle}">
                                            <Grid ColumnSpacing="9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Ellipse
                                                    x:Name="PrimaryColorPreviewEllipse"
                                                    Width="16"
                                                    Height="16"
                                                    Fill="{StaticResource BandaPrimaryColorBrush}"
                                                    VerticalAlignment="Center" />

                                                <TextBlock
                                                    x:Name="PrimaryColorHexText"
                                                    Grid.Column="1"
                                                    Text="#123A34"
                                                    Foreground="{StaticResource BandaTextBrush}"
                                                    FontSize="13"
                                                    VerticalAlignment="Center" />

                                                <TextBlock
                                                    Grid.Column="2"
                                                    Text="⌄"
                                                    Foreground="{StaticResource BandaAccentBrush}"
                                                    VerticalAlignment="Center" />
                                            </Grid>

                                            <Button.Flyout>
                                                <Flyout
                                                    x:Name="PrimaryColorFlyout"
                                                    Placement="BottomEdgeAlignedLeft"
                                                    FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                                                    <Border
                                                        Width="330"
                                                        Padding="16"
                                                        CornerRadius="16"
                                                        Background="{StaticResource BandaPopupSurfaceBrush}"
                                                        BorderBrush="{StaticResource BandaBorderStrongBrush}"
                                                        BorderThickness="1">

                                                        <StackPanel Spacing="12">
                                                            <StackPanel Spacing="3">
                                                                <TextBlock Text="COLOR PRIMARIO" Style="{StaticResource BandaLabelTextStyle}" FontSize="11" />
                                                                <TextBlock Text="BandaNV genera a partir de este color toda la familia de fondos y superficies." Style="{StaticResource BandaMutedTextStyle}" FontSize="12" TextWrapping="Wrap" />
                                                            </StackPanel>

                                                            <ColorPicker
                                                                x:Name="PrimaryColorPicker"
                                                                Color="#FF123A34"
                                                                IsAlphaEnabled="False"
                                                                ColorChanged="PrimaryColorPicker_ColorChanged" />

                                                            <Button
                                                                Content="Restablecer primario"
                                                                Click="ResetPrimaryColorButton_Click"
                                                                Style="{StaticResource BandaPopupSecondaryButtonStyle}"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="190" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Color secundario" Foreground="{StaticResource BandaTextBrush}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="Define acciones, selección y controles activos." Style="{StaticResource BandaMutedTextStyle}" FontSize="12" />
                                        </StackPanel>

                                        <Button
                                            x:Name="SecondaryColorSelectorButton"
                                            Grid.Column="1"
                                            Style="{StaticResource BandaSelectorButtonStyle}">
                                            <Grid ColumnSpacing="9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Ellipse
                                                    x:Name="SecondaryColorPreviewEllipse"
                                                    Width="16"
                                                    Height="16"
                                                    Fill="{StaticResource BandaSecondaryColorBrush}"
                                                    VerticalAlignment="Center" />

                                                <TextBlock
                                                    x:Name="SecondaryColorHexText"
                                                    Grid.Column="1"
                                                    Text="#4FE0C6"
                                                    Foreground="{StaticResource BandaTextBrush}"
                                                    FontSize="13"
                                                    VerticalAlignment="Center" />

                                                <TextBlock
                                                    Grid.Column="2"
                                                    Text="⌄"
                                                    Foreground="{StaticResource BandaAccentBrush}"
                                                    VerticalAlignment="Center" />
                                            </Grid>

                                            <Button.Flyout>
                                                <Flyout
                                                    x:Name="SecondaryColorFlyout"
                                                    Placement="BottomEdgeAlignedLeft"
                                                    FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                                                    <Border
                                                        Width="330"
                                                        Padding="16"
                                                        CornerRadius="16"
                                                        Background="{StaticResource BandaPopupSurfaceBrush}"
                                                        BorderBrush="{StaticResource BandaBorderStrongBrush}"
                                                        BorderThickness="1">

                                                        <StackPanel Spacing="12">
                                                            <StackPanel Spacing="3">
                                                                <TextBlock Text="COLOR SECUNDARIO" Style="{StaticResource BandaLabelTextStyle}" FontSize="11" />
                                                                <TextBlock Text="Usado en botones, toggles, pestañas activas, selección e indicadores." Style="{StaticResource BandaMutedTextStyle}" FontSize="12" TextWrapping="Wrap" />
                                                            </StackPanel>

                                                            <ColorPicker
                                                                x:Name="SecondaryColorPicker"
                                                                Color="#FF4FE0C6"
                                                                IsAlphaEnabled="False"
                                                                ColorChanged="SecondaryColorPicker_ColorChanged" />

                                                            <Button
                                                                Content="Restablecer secundario"
                                                                Click="ResetSecondaryColorButton_Click"
                                                                Style="{StaticResource BandaPopupSecondaryButtonStyle}"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>

                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource BandaCardStyle}" Padding="20">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Vista previa" Foreground="{StaticResource BandaTextBrush}" FontSize="19" FontWeight="SemiBold" />
                                        <TextBlock Text="Referencia visual de la identidad seleccionada." Style="{StaticResource BandaMutedTextStyle}" />
                                    </StackPanel>

                                    <Border
                                        MinHeight="210"
                                        CornerRadius="18"
                                        Background="{StaticResource BandaAccentCardBrush}"
                                        BorderBrush="{StaticResource BandaBorderStrongBrush}"
                                        BorderThickness="1"
                                        Padding="22">

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Orientation="Horizontal" Spacing="9">
                                                <Ellipse Width="9" Height="9" Fill="{StaticResource BandaAccentBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="BandaNV" Foreground="{StaticResource BandaTextBrush}" FontSize="17" FontWeight="SemiBold" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Spacing="5" VerticalAlignment="Center">
                                                <TextBlock Text="Tu organización, bajo control." Foreground="{StaticResource BandaTextBrush}" FontSize="25" FontWeight="SemiBold" />
                                                <TextBlock Text="oscuro · primario #123A34 · secundario #4FE0C6" x:Name="AppearancePreviewDescriptionText" Foreground="{StaticResource BandaMutedStrongBrush}" FontSize="13" />
                                            </StackPanel>

                                            <Grid Grid.Row="2" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Padding="10,5" CornerRadius="10" Background="{StaticResource BandaAccentSoftBrush}">
                                                    <TextBlock Text="Seleccionado" Foreground="{StaticResource BandaAccentBrush}" FontSize="12" FontWeight="SemiBold" />
                                                </Border>
                                                <Border Grid.Column="1" Padding="10,5" CornerRadius="10" Background="{StaticResource BandaNavIconBrush}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="8" Height="8" Fill="{StaticResource BandaPrimaryColorBrush}" VerticalAlignment="Center" /><Ellipse Width="8" Height="8" Fill="{StaticResource BandaSecondaryColorBrush}" VerticalAlignment="Center" /><TextBlock Text="Primario + secundario" Foreground="{StaticResource BandaMutedStrongBrush}" FontSize="12" /></StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <TextBlock
                                        Text="La estructura general de BandaNV se mantiene consistente entre temas para no perder reconocimiento ni jerarquía."
                                        Style="{StaticResource BandaMutedTextStyle}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ORGANIZACIÓN -->
                <ScrollViewer
                    x:Name="OrganizationSettingsPanel"
                    Visibility="Collapsed"
                    VerticalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled"
