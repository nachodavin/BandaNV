<Page
    x:Class="BandaNV.App.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BandaNV.App.Pages"
    Background="Transparent">

    <Grid>
        <Grid
            Padding="34,32,34,40"
            RowSpacing="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Spacing="5">
            <TextBlock
                Text="Historial"
                Style="{StaticResource BandaSectionTitleStyle}"
                FontSize="32" />

            <TextBlock
                Text="Revisá, buscá y consultá las organizaciones realizadas por BandaNV."
                Style="{StaticResource BandaMutedTextStyle}"
                FontSize="14" />
        </StackPanel>

        <!-- Métricas del historial: datos de maqueta hasta conectar logs reales -->
        <Grid
            Grid.Row="1"
            ColumnSpacing="12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource BandaCardStyle}" Padding="18" MinHeight="104">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="TOTAL EJECUCIONES" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" />
                    <TextBlock Grid.Row="1" Text="4" Foreground="{StaticResource BandaTextBrush}" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Text="registradas" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource BandaCardStyle}" Padding="18" MinHeight="104">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="ARCHIVOS ORGANIZADOS" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" />
                    <TextBlock Grid.Row="1" Text="103" Foreground="{StaticResource BandaTextBrush}" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Text="movimientos históricos" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource BandaCardStyle}" Padding="18" MinHeight="104">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="TAMAÑO MOVIDO" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" />
                    <TextBlock Grid.Row="1" Text="5.32 GB" Foreground="{StaticResource BandaTextBrush}" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Text="acumulado" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" />
                </Grid>
            </Border>

            <Border
                Grid.Column="3"
                Padding="18"
                MinHeight="104"
                CornerRadius="18"
                Background="{StaticResource BandaAccentCardBrush}"
                BorderBrush="{StaticResource BandaBorderStrongBrush}"
                BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="ÚLTIMA ORGANIZACIÓN" Foreground="{StaticResource BandaMutedStrongBrush}" FontSize="13" />
                    <TextBlock Grid.Row="1" Text="04/10 · 00:47:18" Foreground="{StaticResource BandaTextBrush}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Text="34 archivos · 1.8 GB" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" />
                </Grid>
            </Border>
        </Grid>

        <!-- Herramientas de búsqueda -->
        <Grid
            Grid.Row="2"
            ColumnSpacing="12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="HistorySearchBox"
                Grid.Column="0"
                PlaceholderText="Buscar por fecha, archivo, categoría, origen o destino..."
                TextChanged="HistorySearchBox_TextChanged"
                FontSize="14"
                Padding="14,10"
                MinHeight="44" />

            <Border
                Grid.Column="1"
                Padding="14,0"
                CornerRadius="12"
                Background="{StaticResource BandaCardBrush}"
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="1"
                VerticalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="HistoryResultCountText"
                        Text="4"
                        Foreground="{StaticResource BandaTextBrush}"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="HistoryResultCountLabel"
                        Text="ejecuciones"
                        Style="{StaticResource BandaMutedTextStyle}" />
                </StackPanel>
            </Border>

            <Button
                x:Name="HistoryFiltersButton"
                Grid.Column="2"
                Content="Filtros"
                Click="HistoryFiltersButton_Click"
                Padding="16,10"
                MinHeight="44"
                CornerRadius="12"
                Background="{StaticResource BandaCardBrush}"
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="1"
                Foreground="{StaticResource BandaTextBrush}" />

            <Button
                x:Name="HistorySortSelectorButton"
                Grid.Column="3"
                Width="190"
                MinHeight="44"
                Style="{StaticResource BandaSelectorButtonStyle}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="HistorySortValueText"
                        Text="Fecha · más reciente"
                        Foreground="{StaticResource BandaTextBrush}"
                        FontSize="13"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Text="⌄"
                        Foreground="{StaticResource BandaAccentBrush}"
                        FontSize="14"
                        VerticalAlignment="Center" />
                </Grid>
                <Button.Flyout>
                    <Flyout
                        x:Name="HistorySortFlyout"
                        Placement="BottomEdgeAlignedLeft"
                        FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                        <Border
                            Width="210"
                            Padding="8"
                            CornerRadius="16"
                            Background="{StaticResource BandaPopupSurfaceBrush}"
                            BorderBrush="{StaticResource BandaBorderStrongBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Text="ORDENAR POR"
                                    Margin="10,6,10,4"
                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                    FontSize="11"
                                    FontWeight="SemiBold" />
                                <Button Tag="Newest" Content="Fecha · más reciente" Click="HistorySortOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                <Button Tag="Oldest" Content="Fecha · más antigua" Click="HistorySortOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                <Button Tag="FilesDescending" Content="Archivos · mayor primero" Click="HistorySortOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                <Button Tag="FilesAscending" Content="Archivos · menor primero" Click="HistorySortOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                <Button Tag="SizeDescending" Content="Tamaño · mayor primero" Click="HistorySortOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                <Button Tag="SizeAscending" Content="Tamaño · menor primero" Click="HistorySortOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Historial + detalle integrado -->
        <Border
            Grid.Row="3"
            Style="{StaticResource BandaCardStyle}"
            Padding="0"
            MinHeight="390">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Filtros activos -->
                <Grid Padding="18,14" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="HistoryAllChip"
                        Grid.Column="0"
                        Padding="12,6"
                        CornerRadius="14"
                        Background="{StaticResource BandaAccentSoftBrush}">
                        <TextBlock Text="Todas" Foreground="{StaticResource BandaAccentBrush}" FontSize="13" FontWeight="SemiBold" />
                    </Border>

                    <Border
                        x:Name="HistoryActiveFilterChip"
                        Grid.Column="1"
                        Padding="12,6"
                        CornerRadius="14"
                        Background="{StaticResource BandaNavIconBrush}">
                        <TextBlock
                            x:Name="HistoryActiveFilterText"
                            Text="Sin filtros"
                            Foreground="{StaticResource BandaMutedStrongBrush}"
                            FontSize="13" />
                    </Border>

                    <Border Grid.Column="2" Padding="12,6" CornerRadius="14" Background="{StaticResource BandaNavIconBrush}">
                        <TextBlock
                            x:Name="HistoryActiveSortText"
                            Text="Fecha · más reciente"
                            Foreground="{StaticResource BandaMutedStrongBrush}"
                            FontSize="13" />
                    </Border>

                    <Button
                        x:Name="HistoryClearFiltersButton"
                        Grid.Column="4"
                        Content="Limpiar filtros"
                        Click="HistoryClearFiltersButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource BandaMutedBrush}"
                        Padding="10,6" />
                </Grid>

                <Grid
                    Grid.Row="1"
                    Margin="14,0,14,14"
                    ColumnSpacing="12">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.75*" />
                        <ColumnDefinition Width="0.85*" />
                    </Grid.ColumnDefinitions>

                    <!-- Lista de ejecuciones -->
                    <Border
                        Grid.Column="0"
                        CornerRadius="14"
                        Background="{StaticResource BandaCardAltBrush}"
                        BorderBrush="{StaticResource BandaBorderBrush}"
                        BorderThickness="1">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="48" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Padding="16,0" ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.22*" />
                                    <ColumnDefinition Width="0.72*" />
                                    <ColumnDefinition Width="1.45*" />
                                    <ColumnDefinition Width="1.45*" />
                                    <ColumnDefinition Width="0.62*" />
                                    <ColumnDefinition Width="0.7*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="FECHA Y HORA" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="TIPO" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="ORIGEN" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="DESTINO" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="ARCHIVOS" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="TAMAÑO" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" VerticalAlignment="Center" />
                            </Grid>

                            <ListView
                                x:Name="HistoryList"
                                Grid.Row="1"
                                ItemsSource="{x:Bind PreviewExecutions, Mode=OneWay}"
                                SelectionMode="Extended"
                                IsMultiSelectCheckBoxEnabled="False"
                                SelectionChanged="HistoryList_SelectionChanged"
                                Tapped="HistoryList_Tapped"
                                HorizontalContentAlignment="Stretch"
                                Padding="8,0,8,8">
                                <ListView.KeyboardAccelerators>
                                    <KeyboardAccelerator
                                        Key="A"
                                        Modifiers="Control"
                                        Invoked="HistorySelectAllAccelerator_Invoked" />
                                </ListView.KeyboardAccelerators>

                                <ListView.Resources>
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#244FE0C6" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#304FE0C6" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#161F292D" />
                                    <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#F5F8FA" />
                                </ListView.Resources>

                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,2" />
                                        <Setter Property="CornerRadius" Value="10" />
                                        <Setter Property="MinHeight" Value="54" />
                                    </Style>
                                </ListView.ItemContainerStyle>

                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:HistoryExecutionPreview">
                                        <Grid Padding="10,0" ColumnSpacing="18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.22*" />
                                                <ColumnDefinition Width="0.72*" />
                                                <ColumnDefinition Width="1.45*" />
                                                <ColumnDefinition Width="1.45*" />
                                                <ColumnDefinition Width="0.62*" />
                                                <ColumnDefinition Width="0.7*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{x:Bind DateTimeText}" Foreground="{StaticResource BandaTextBrush}" FontSize="13" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Type}" Foreground="{StaticResource BandaMutedStrongBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind OriginShort}" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind DestinationShort}" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind FileCountText}" Foreground="{StaticResource BandaTextBrush}" FontSize="13" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{x:Bind SizeText}" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Detalle de la ejecución seleccionada -->
                    <Border
                        Grid.Column="1"
                        CornerRadius="14"
                        Background="{StaticResource BandaCardAltBrush}"
                        BorderBrush="{StaticResource BandaBorderBrush}"
                        BorderThickness="1"
                        Padding="18">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Encabezado fijo -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="4">
                                    <TextBlock
                                        x:Name="DetailTitleText"
                                        Text="Detalle de ejecución"
                                        Foreground="{StaticResource BandaTextBrush}"
                                        FontSize="18"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        x:Name="DetailDateText"
                                        Text="—"
                                        Style="{StaticResource BandaMutedTextStyle}"
                                        FontSize="14" />
                                </StackPanel>

                                <Border
                                    x:Name="UndoStatusBorder"
                                    Grid.Column="1"
                                    Padding="10,5"
                                    CornerRadius="12"
                                    Background="{StaticResource BandaAccentSoftBrush}"
                                    VerticalAlignment="Top">
                                    <TextBlock
                                        x:Name="UndoStatusText"
                                        Text="Reversible"
                                        Foreground="{StaticResource BandaAccentBrush}"
                                        FontSize="13"
                                        FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <!-- Resumen fijo -->
                            <StackPanel
                                Grid.Row="1"
                                Margin="0,16,0,14"
                                Spacing="14">

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Padding="12" CornerRadius="12" Background="{StaticResource BandaNavIconBrush}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="ARCHIVOS" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" />
                                            <TextBlock x:Name="DetailFileCountText" Text="—" Foreground="{StaticResource BandaTextBrush}" FontSize="21" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Padding="12" CornerRadius="12" Background="{StaticResource BandaNavIconBrush}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="TAMAÑO" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" />
                                            <TextBlock x:Name="DetailSizeText" Text="—" Foreground="{StaticResource BandaTextBrush}" FontSize="21" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Spacing="5">
                                    <TextBlock Text="ORIGEN" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" />
                                    <TextBlock
                                        x:Name="DetailOriginText"
                                        Text="—"
                                        Foreground="{StaticResource BandaMutedStrongBrush}"
                                        FontSize="14"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="5">
                                    <TextBlock Text="DESTINO" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" />
                                    <TextBlock
                                        x:Name="DetailDestinationText"
                                        Text="—"
                                        Foreground="{StaticResource BandaMutedStrongBrush}"
                                        FontSize="14"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Solo la lista de archivos scrollea; el título queda fijo -->
                            <Grid
                                Grid.Row="2"
                                MinHeight="120">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    x:Name="DetailFilesSectionTitleText"
                                    Text="ARCHIVOS DE LA EJECUCIÓN"
                                    Style="{StaticResource BandaMutedTextStyle}"
                                    FontSize="13"
                                    Margin="0,0,0,10" />

                                <ScrollViewer
                                    Grid.Row="1"
                                    VerticalScrollMode="Enabled"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Disabled"
                                    HorizontalScrollBarVisibility="Disabled">

                                    <ItemsControl ItemsSource="{x:Bind SelectedFiles, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:HistoryFilePreview">
                                                <Border
                                                    Padding="12,10"
                                                    Margin="0,0,12,7"
                                                    CornerRadius="10"
                                                    Background="{StaticResource BandaNavIconBrush}"
                                                    Opacity="{x:Bind RowOpacity}">

                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Spacing="3">
                                                            <Grid>
                                                                <TextBlock
                                                                    Text="{x:Bind Name}"
                                                                    Foreground="{StaticResource BandaTextBrush}"
                                                                    FontSize="14"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    Visibility="{x:Bind NormalNameVisibility}" />

                                                                <TextBlock
                                                                    Text="{x:Bind Name}"
                                                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                                                    FontSize="14"
                                                                    TextDecorations="Strikethrough"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    Visibility="{x:Bind DeletedNameVisibility}" />
                                                            </Grid>

                                                            <TextBlock
                                                                Text="{x:Bind Category}"
                                                                Foreground="{StaticResource BandaAccentBrush}"
                                                                FontSize="13" />
                                                        </StackPanel>

                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Text="{x:Bind SizeText}"
                                                            Style="{StaticResource BandaMutedTextStyle}"
                                                            FontSize="13"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center" />

                                                        <Grid
                                                            Grid.Column="2"
                                                            MinWidth="72">

                                                            <Button
                                                                Tag="{x:Bind Name}"
                                                                Click="DeleteFilePreviewButton_Click"
                                                                Width="28"
                                                                Height="28"
                                                                Padding="0"
                                                                CornerRadius="8"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Foreground="{StaticResource BandaMutedStrongBrush}"
                                                                Visibility="{x:Bind DeleteVisibility}"
                                                                IsEnabled="{x:Bind CanDelete}"
                                                                ToolTipService.ToolTip="Eliminar archivo">
                                                                <SymbolIcon Symbol="Delete" />
                                                            </Button>

                                                            <Border
                                                                Padding="8,4"
                                                                CornerRadius="9"
                                                                Background="{StaticResource BandaNavIconBrush}"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Visibility="{x:Bind DeletedStatusVisibility}">
                                                                <TextBlock
                                                                    Text="ELIMINADO"
                                                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                                                    FontSize="13"
                                                                    FontWeight="SemiBold" />
                                                            </Border>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <!-- Acción principal fija -->
                            <Button
                                x:Name="UndoPreviewButton"
                                Grid.Row="3"
                                Content="Deshacer ejecución"
                                Margin="0,14,0,0"
                                FontSize="14"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="14,10"
                                CornerRadius="12"
                                FontWeight="SemiBold"
                                Click="UndoPreviewButton_Click">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackground" Color="#4FE0C6" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#67E7D2" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#39B9A7" />
                                    <SolidColorBrush x:Key="ButtonForeground" Color="#07110F" />
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#07110F" />
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#07110F" />
                                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#4FE0C6" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#67E7D2" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#39B9A7" />
                                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#151D262F" />
                                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#65747D" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#35424E59" />
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Pie -->
                <Grid Grid.Row="2" Padding="18,0,18,16">
                    <TextBlock
                        x:Name="HistoryFooterCountText"
                        Text="4 resultados"
                        Style="{StaticResource BandaMutedTextStyle}"
                        FontSize="13"
                        VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>
        </Grid>

        <Grid
            x:Name="HistoryFiltersOverlay"
            Canvas.ZIndex="90"
            Visibility="Collapsed">
            <Border
                Background="{StaticResource BandaPopupBackdropBrush}"
                Tapped="HistoryFiltersBackdrop_Tapped" />

            <Border
                Width="620"
                Style="{StaticResource BandaPopupCardStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Grid RowSpacing="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="46"
                            Height="46"
                            CornerRadius="14"
                            Background="{StaticResource BandaAccentSoftBrush}">
                            <TextBlock
                                Text="≡"
                                Foreground="{StaticResource BandaAccentBrush}"
                                FontSize="24"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock
                                Text="Filtrar historial"
                                Foreground="{StaticResource BandaTextBrush}"
                                FontSize="22"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Text="Acotá las ejecuciones por tipo, estado de Undo y origen."
                                Foreground="{StaticResource BandaMutedBrush}"
                                FontSize="13"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            Content="×"
                            Click="CloseHistoryFiltersOverlayButton_Click"
                            Style="{StaticResource BandaPopupCloseButtonStyle}"
                            VerticalAlignment="Top" />
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Padding="16"
                            CornerRadius="16"
                            Background="{StaticResource BandaCardBrush}"
                            BorderBrush="{StaticResource BandaBorderBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Text="TIPO DE EJECUCIÓN"
                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                    FontSize="11"
                                    FontWeight="SemiBold" />

                                <Button
                                    x:Name="HistoryTypeSelectorButton"
                                    Style="{StaticResource BandaSelectorButtonStyle}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="HistoryTypeValueText"
                                            Text="Todos los tipos"
                                            Foreground="{StaticResource BandaTextBrush}"
                                            FontSize="13"
                                            VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="⌄" Foreground="{StaticResource BandaAccentBrush}" FontSize="14" VerticalAlignment="Center" />
                                    </Grid>
                                    <Button.Flyout>
                                        <Flyout
                                            x:Name="HistoryTypeFlyout"
                                            Placement="BottomEdgeAlignedLeft"
                                            FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                                            <Border
                                                Width="250"
                                                Padding="8"
                                                CornerRadius="16"
                                                Background="{StaticResource BandaPopupSurfaceBrush}"
                                                BorderBrush="{StaticResource BandaBorderStrongBrush}"
                                                BorderThickness="1">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="TIPO DE EJECUCIÓN" Margin="10,6,10,4" Foreground="{StaticResource BandaMutedStrongBrush}" FontSize="11" FontWeight="SemiBold" />
                                                    <Button Tag="All" Content="Todos los tipos" Click="HistoryTypeOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                    <Button Tag="Organize" Content="Organizar" Click="HistoryTypeOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                    <Button Tag="Undo" Content="Deshacer" Click="HistoryTypeOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Padding="16"
                            CornerRadius="16"
                            Background="{StaticResource BandaCardBrush}"
                            BorderBrush="{StaticResource BandaBorderBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Text="ESTADO DE UNDO"
                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                    FontSize="11"
                                    FontWeight="SemiBold" />

                                <Button
                                    x:Name="HistoryUndoSelectorButton"
                                    Style="{StaticResource BandaSelectorButtonStyle}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="HistoryUndoValueText"
                                            Text="Cualquier estado"
                                            Foreground="{StaticResource BandaTextBrush}"
                                            FontSize="13"
                                            VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="⌄" Foreground="{StaticResource BandaAccentBrush}" FontSize="14" VerticalAlignment="Center" />
                                    </Grid>
                                    <Button.Flyout>
                                        <Flyout
                                            x:Name="HistoryUndoFlyout"
                                            Placement="BottomEdgeAlignedLeft"
                                            FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                                            <Border
                                                Width="250"
                                                Padding="8"
                                                CornerRadius="16"
                                                Background="{StaticResource BandaPopupSurfaceBrush}"
                                                BorderBrush="{StaticResource BandaBorderStrongBrush}"
                                                BorderThickness="1">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="ESTADO DE UNDO" Margin="10,6,10,4" Foreground="{StaticResource BandaMutedStrongBrush}" FontSize="11" FontWeight="SemiBold" />
                                                    <Button Tag="All" Content="Cualquier estado" Click="HistoryUndoOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                    <Button Tag="Reversible" Content="Reversibles" Click="HistoryUndoOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                    <Button Tag="NotReversible" Content="No reversibles" Click="HistoryUndoOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border
                        Grid.Row="2"
                        Padding="16"
                        CornerRadius="16"
                        Background="{StaticResource BandaCardBrush}"
                        BorderBrush="{StaticResource BandaBorderBrush}"
                        BorderThickness="1">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock
                                    Text="ORIGEN"
                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                    FontSize="11"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Mostrá ejecuciones de una ubicación concreta."
                                    Foreground="{StaticResource BandaMutedBrush}"
                                    FontSize="12"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Button
                                x:Name="HistoryOriginSelectorButton"
                                Grid.Column="1"
                                Style="{StaticResource BandaSelectorButtonStyle}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="HistoryOriginValueText"
                                        Text="Todos los orígenes"
                                        Foreground="{StaticResource BandaTextBrush}"
                                        FontSize="13"
                                        VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="⌄" Foreground="{StaticResource BandaAccentBrush}" FontSize="14" VerticalAlignment="Center" />
                                </Grid>
                                <Button.Flyout>
                                    <Flyout
                                        x:Name="HistoryOriginFlyout"
                                        Placement="BottomEdgeAlignedLeft"
                                        FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                                        <Border
                                            Width="280"
                                            Padding="8"
                                            CornerRadius="16"
                                            Background="{StaticResource BandaPopupSurfaceBrush}"
                                            BorderBrush="{StaticResource BandaBorderStrongBrush}"
                                            BorderThickness="1">
                                            <StackPanel
                                                x:Name="HistoryOriginOptionsPanel"
                                                Spacing="2" />
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="1"
                            Content="Restablecer"
                            Click="ResetHistoryFiltersOverlayButton_Click"
                            Style="{StaticResource BandaPopupGhostButtonStyle}" />
                        <Button
                            Grid.Column="2"
                            Content="Cancelar"
                            Click="CloseHistoryFiltersOverlayButton_Click"
                            Style="{StaticResource BandaPopupSecondaryButtonStyle}" />
                        <Button
                            Grid.Column="3"
                            Content="Aplicar filtros"
                            Click="ApplyHistoryFiltersOverlayButton_Click"
                            Style="{StaticResource BandaPopupPrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid
            x:Name="HistoryModalOverlay"
            Canvas.ZIndex="100"
            Visibility="Collapsed">
            <Border
                Background="{StaticResource BandaPopupBackdropBrush}"
                Tapped="HistoryModalBackdrop_Tapped" />

            <Border
                Width="560"
                Style="{StaticResource BandaPopupCardStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Grid RowSpacing="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="HistoryModalIconBorder"
                            Width="46"
                            Height="46"
                            CornerRadius="14"
                            Background="{StaticResource BandaAccentSoftBrush}">
                            <TextBlock
                                x:Name="HistoryModalIconText"
                                Text="!"
                                Foreground="{StaticResource BandaAccentBrush}"
                                FontSize="20"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="HistoryModalTitleText"
                                Text="Historial"
                                Foreground="{StaticResource BandaTextBrush}"
                                FontSize="22"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Text="BandaNV"
                                Foreground="{StaticResource BandaMutedBrush}"
                                FontSize="12" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            Content="×"
                            Click="HistoryModalCloseButton_Click"
                            Style="{StaticResource BandaPopupCloseButtonStyle}"
                            VerticalAlignment="Top" />
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Padding="16"
                        CornerRadius="16"
                        Background="{StaticResource BandaCardBrush}"
                        BorderBrush="{StaticResource BandaBorderBrush}"
                        BorderThickness="1">
                        <TextBlock
                            x:Name="HistoryModalBodyText"
                            Text=""
                            Foreground="{StaticResource BandaMutedStrongBrush}"
                            FontSize="13"
                            TextWrapping="Wrap"
                            LineHeight="20" />
                    </Border>

                    <Grid Grid.Row="2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="HistoryModalSecondaryButton"
                            Grid.Column="1"
                            Content="Cancelar"
                            Click="HistoryModalCloseButton_Click"
                            Style="{StaticResource BandaPopupSecondaryButtonStyle}" />

                        <Button
                            x:Name="HistoryModalPrimaryButton"
                            Grid.Column="2"
                            Content="Eliminar"
                            Click="HistoryModalPrimaryButton_Click"
                            Style="{StaticResource BandaPopupDangerButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
