<Page
    x:Class="BandaNV.App.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BandaNV.App.Pages"
    Background="Transparent">

    <Grid
        Padding="34,32,34,40"
        RowSpacing="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Spacing="5">
            <TextBlock
                Text="Historial"
                Style="{StaticResource BandaSectionTitleStyle}"
                FontSize="32" />

            <TextBlock
                Text="Revisá, buscá y consultá las organizaciones realizadas por BandaNV."
                Style="{StaticResource BandaMutedTextStyle}"
                FontSize="14" />
        </StackPanel>

        <!-- Métricas del historial: datos de maqueta hasta conectar logs reales -->
        <Grid
            Grid.Row="1"
            ColumnSpacing="12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource BandaCardStyle}" Padding="18" MinHeight="104">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="TOTAL EJECUCIONES" Style="{StaticResource BandaMutedTextStyle}" FontSize="11" />
                    <TextBlock Grid.Row="1" Text="4" Foreground="{StaticResource BandaTextBrush}" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Text="registradas" Style="{StaticResource BandaMutedTextStyle}" FontSize="11" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource BandaCardStyle}" Padding="18" MinHeight="104">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="ARCHIVOS ORGANIZADOS" Style="{StaticResource BandaMutedTextStyle}" FontSize="11" />
                    <TextBlock Grid.Row="1" Text="103" Foreground="{StaticResource BandaTextBrush}" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Text="movimientos históricos" Style="{StaticResource BandaMutedTextStyle}" FontSize="11" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource BandaCardStyle}" Padding="18" MinHeight="104">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="TAMAÑO MOVIDO" Style="{StaticResource BandaMutedTextStyle}" FontSize="11" />
                    <TextBlock Grid.Row="1" Text="5.32 GB" Foreground="{StaticResource BandaTextBrush}" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Text="acumulado" Style="{StaticResource BandaMutedTextStyle}" FontSize="11" />
                </Grid>
            </Border>

            <Border
                Grid.Column="3"
                Padding="18"
                MinHeight="104"
                CornerRadius="18"
                Background="{StaticResource BandaAccentCardBrush}"
                BorderBrush="{StaticResource BandaBorderStrongBrush}"
                BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="ÚLTIMA ORGANIZACIÓN" Foreground="{StaticResource BandaMutedStrongBrush}" FontSize="11" />
                    <TextBlock Grid.Row="1" Text="04/10 · 00:47" Foreground="{StaticResource BandaTextBrush}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Text="34 archivos · 1.8 GB" Style="{StaticResource BandaMutedTextStyle}" FontSize="11" />
                </Grid>
            </Border>
        </Grid>

        <!-- Herramientas de búsqueda -->
        <Grid
            Grid.Row="2"
            ColumnSpacing="12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                PlaceholderText="Buscar por fecha, archivo, categoría, origen o destino..."
                FontSize="14"
                Padding="14,10"
                MinHeight="44" />

            <Border
                Grid.Column="1"
                Padding="14,0"
                CornerRadius="12"
                Background="{StaticResource BandaCardBrush}"
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="1"
                VerticalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <TextBlock Text="4" Foreground="{StaticResource BandaTextBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="ejecuciones" Style="{StaticResource BandaMutedTextStyle}" />
                </StackPanel>
            </Border>

            <Button
                Grid.Column="2"
                Content="Filtros"
                Padding="16,10"
                MinHeight="44"
                CornerRadius="12" />

            <ComboBox
                Grid.Column="3"
                MinWidth="170"
                MinHeight="44"
                PlaceholderText="Ordenar por">
                <ComboBoxItem Content="Fecha" />
                <ComboBoxItem Content="Archivos" />
                <ComboBoxItem Content="Tamaño" />
                <ComboBoxItem Content="Origen" />
            </ComboBox>
        </Grid>

        <!-- Historial + detalle integrado -->
        <Border
            Grid.Row="3"
            Style="{StaticResource BandaCardStyle}"
            Padding="0"
            MinHeight="390">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Filtros activos -->
                <Grid Padding="18,14" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Padding="12,6" CornerRadius="14" Background="{StaticResource BandaAccentSoftBrush}">
                        <TextBlock Text="Todas" Foreground="{StaticResource BandaAccentBrush}" FontSize="12" FontWeight="SemiBold" />
                    </Border>

                    <Border Grid.Column="1" Padding="12,6" CornerRadius="14" Background="{StaticResource BandaNavIconBrush}">
                        <TextBlock Text="Sin filtros" Foreground="{StaticResource BandaMutedStrongBrush}" FontSize="12" />
                    </Border>

                    <Border Grid.Column="2" Padding="12,6" CornerRadius="14" Background="{StaticResource BandaNavIconBrush}">
                        <TextBlock Text="Más recientes primero" Foreground="{StaticResource BandaMutedStrongBrush}" FontSize="12" />
                    </Border>

                    <Button
                        Grid.Column="4"
                        Content="Limpiar filtros"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource BandaMutedBrush}"
                        Padding="10,6" />
                </Grid>

                <Grid
                    Grid.Row="1"
                    Margin="14,0,14,14"
                    ColumnSpacing="12">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.75*" />
                        <ColumnDefinition Width="0.85*" />
                    </Grid.ColumnDefinitions>

                    <!-- Lista de ejecuciones -->
                    <Border
                        Grid.Column="0"
                        CornerRadius="14"
                        Background="{StaticResource BandaCardAltBrush}"
                        BorderBrush="{StaticResource BandaBorderBrush}"
                        BorderThickness="1">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="48" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Padding="16,0" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="0.75*" />
                                    <ColumnDefinition Width="1.8*" />
                                    <ColumnDefinition Width="0.72*" />
                                    <ColumnDefinition Width="0.72*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="FECHA Y HORA" Style="{StaticResource BandaMutedTextStyle}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="TIPO" Style="{StaticResource BandaMutedTextStyle}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="ORIGEN" Style="{StaticResource BandaMutedTextStyle}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="ARCHIVOS" Style="{StaticResource BandaMutedTextStyle}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="TAMAÑO" Style="{StaticResource BandaMutedTextStyle}" FontSize="11" VerticalAlignment="Center" />
                            </Grid>

                            <ListView
                                x:Name="HistoryList"
                                Grid.Row="1"
                                ItemsSource="{x:Bind PreviewExecutions, Mode=OneWay}"
                                SelectionMode="Single"
                                SelectionChanged="HistoryList_SelectionChanged"
                                HorizontalContentAlignment="Stretch"
                                Padding="8,0,8,8">

                                <ListView.Resources>
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#244FE0C6" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#304FE0C6" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#161F292D" />
                                    <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#F5F8FA" />
                                </ListView.Resources>

                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,2" />
                                        <Setter Property="CornerRadius" Value="10" />
                                        <Setter Property="MinHeight" Value="54" />
                                    </Style>
                                </ListView.ItemContainerStyle>

                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:HistoryExecutionPreview">
                                        <Grid Padding="10,0" ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.25*" />
                                                <ColumnDefinition Width="0.75*" />
                                                <ColumnDefinition Width="1.8*" />
                                                <ColumnDefinition Width="0.72*" />
                                                <ColumnDefinition Width="0.72*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{x:Bind DateTimeText}" Foreground="{StaticResource BandaTextBrush}" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Type}" Foreground="{StaticResource BandaMutedStrongBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind OriginShort}" Style="{StaticResource BandaMutedTextStyle}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind FileCountText}" Foreground="{StaticResource BandaTextBrush}" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind SizeText}" Style="{StaticResource BandaMutedTextStyle}" FontSize="12" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Detalle de la ejecución seleccionada -->
                    <Border
                        Grid.Column="1"
                        CornerRadius="14"
                        Background="{StaticResource BandaCardAltBrush}"
                        BorderBrush="{StaticResource BandaBorderBrush}"
                        BorderThickness="1"
                        Padding="18">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Encabezado fijo -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Text="Detalle de ejecución"
                                        Foreground="{StaticResource BandaTextBrush}"
                                        FontSize="16"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        x:Name="DetailDateText"
                                        Text="—"
                                        Style="{StaticResource BandaMutedTextStyle}"
                                        FontSize="13" />
                                </StackPanel>

                                <Border
                                    x:Name="UndoStatusBorder"
                                    Grid.Column="1"
                                    Padding="10,5"
                                    CornerRadius="12"
                                    Background="{StaticResource BandaAccentSoftBrush}"
                                    VerticalAlignment="Top">
                                    <TextBlock
                                        x:Name="UndoStatusText"
                                        Text="Reversible"
                                        Foreground="{StaticResource BandaAccentBrush}"
                                        FontSize="11"
                                        FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <!-- Resumen fijo -->
                            <StackPanel
                                Grid.Row="1"
                                Margin="0,16,0,14"
                                Spacing="14">

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Padding="12" CornerRadius="12" Background="{StaticResource BandaNavIconBrush}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="ARCHIVOS" Style="{StaticResource BandaMutedTextStyle}" FontSize="11" />
                                            <TextBlock x:Name="DetailFileCountText" Text="—" Foreground="{StaticResource BandaTextBrush}" FontSize="19" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Padding="12" CornerRadius="12" Background="{StaticResource BandaNavIconBrush}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="TAMAÑO" Style="{StaticResource BandaMutedTextStyle}" FontSize="11" />
                                            <TextBlock x:Name="DetailSizeText" Text="—" Foreground="{StaticResource BandaTextBrush}" FontSize="19" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Spacing="5">
                                    <TextBlock Text="ORIGEN" Style="{StaticResource BandaMutedTextStyle}" FontSize="11" />
                                    <TextBlock
                                        x:Name="DetailOriginText"
                                        Text="—"
                                        Foreground="{StaticResource BandaMutedStrongBrush}"
                                        FontSize="12"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="5">
                                    <TextBlock Text="DESTINO" Style="{StaticResource BandaMutedTextStyle}" FontSize="11" />
                                    <TextBlock
                                        x:Name="DetailDestinationText"
                                        Text="—"
                                        Foreground="{StaticResource BandaMutedStrongBrush}"
                                        FontSize="12"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Solo la lista de archivos scrollea; el título queda fijo -->
                            <Grid
                                Grid.Row="2"
                                MinHeight="120">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Text="ARCHIVOS DE LA EJECUCIÓN"
                                    Style="{StaticResource BandaMutedTextStyle}"
                                    FontSize="11"
                                    Margin="0,0,0,8" />

                                <ScrollViewer
                                    Grid.Row="1"
                                    VerticalScrollMode="Enabled"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Disabled"
                                    HorizontalScrollBarVisibility="Disabled">

                                    <ItemsControl ItemsSource="{x:Bind SelectedFiles, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:HistoryFilePreview">
                                                <Border
                                                    Padding="10,8"
                                                    Margin="0,0,12,6"
                                                    CornerRadius="10"
                                                    Background="{StaticResource BandaNavIconBrush}"
                                                    Opacity="{x:Bind RowOpacity}">

                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Spacing="3">
                                                            <Grid>
                                                                <TextBlock
                                                                    Text="{x:Bind Name}"
                                                                    Foreground="{StaticResource BandaTextBrush}"
                                                                    FontSize="12"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    Visibility="{x:Bind NormalNameVisibility}" />

                                                                <TextBlock
                                                                    Text="{x:Bind Name}"
                                                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                                                    FontSize="11"
                                                                    TextDecorations="Strikethrough"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    Visibility="{x:Bind DeletedNameVisibility}" />
                                                            </Grid>

                                                            <TextBlock
                                                                Text="{x:Bind Category}"
                                                                Foreground="{StaticResource BandaAccentBrush}"
                                                                FontSize="11" />
                                                        </StackPanel>

                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Text="{x:Bind SizeText}"
                                                            Style="{StaticResource BandaMutedTextStyle}"
                                                            FontSize="11"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center" />

                                                        <Grid
                                                            Grid.Column="2"
                                                            MinWidth="72">

                                                            <Button
                                                                Tag="{x:Bind Name}"
                                                                Click="DeleteFilePreviewButton_Click"
                                                                Width="28"
                                                                Height="28"
                                                                Padding="0"
                                                                CornerRadius="8"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Foreground="{StaticResource BandaMutedStrongBrush}"
                                                                Visibility="{x:Bind DeleteVisibility}"
                                                                IsEnabled="{x:Bind CanDelete}"
                                                                ToolTipService.ToolTip="Eliminar archivo">
                                                                <SymbolIcon Symbol="Delete" />
                                                            </Button>

                                                            <Border
                                                                Padding="8,4"
                                                                CornerRadius="9"
                                                                Background="{StaticResource BandaNavIconBrush}"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Visibility="{x:Bind DeletedStatusVisibility}">
                                                                <TextBlock
                                                                    Text="ELIMINADO"
                                                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                                                    FontSize="10"
                                                                    FontWeight="SemiBold" />
                                                            </Border>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <!-- Acción principal fija -->
                            <Button
                                x:Name="UndoPreviewButton"
                                Grid.Row="3"
                                Content="Deshacer ejecución"
                                Margin="0,14,0,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="14,10"
                                CornerRadius="12"
                                FontWeight="SemiBold"
                                Click="UndoPreviewButton_Click">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackground" Color="#4FE0C6" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#67E7D2" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#39B9A7" />
                                    <SolidColorBrush x:Key="ButtonForeground" Color="#07110F" />
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#07110F" />
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#07110F" />
                                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#4FE0C6" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#67E7D2" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#39B9A7" />
                                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#151D262F" />
                                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#65747D" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#35424E59" />
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Pie -->
                <Grid Grid.Row="2" Padding="18,0,18,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Text="4 resultados"
                        Style="{StaticResource BandaMutedTextStyle}"
                        FontSize="12"
                        VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="‹" Width="34" Height="32" Padding="0" IsEnabled="False" />
                        <TextBlock Text="1 de 1" Style="{StaticResource BandaMutedTextStyle}" VerticalAlignment="Center" />
                        <Button Content="›" Width="34" Height="32" Padding="0" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
