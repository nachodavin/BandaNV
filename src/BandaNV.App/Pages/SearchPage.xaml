<Page
    x:Class="BandaNV.App.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BandaNV.App.Pages"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="CategoryCardTemplate" x:DataType="local:SearchCategorySummary">
            <Button
                Tag="{x:Bind Name}"
                Click="CategoryCard_Click"
                Height="122"
                Padding="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="18">

                <Border
                    Padding="18"
                    CornerRadius="18"
                    Background="{x:Bind CardBackground}"
                    BorderBrush="{x:Bind CardBorderBrush}"
                    BorderThickness="1">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            Width="9"
                            Height="9"
                            CornerRadius="5"
                            Background="{StaticResource BandaAccentBrush}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Visibility="{x:Bind SelectedVisibility}" />

                        <TextBlock
                            Text="{x:Bind Name}"
                            Foreground="{StaticResource BandaMutedStrongBrush}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1" />

                        <TextBlock
                            Grid.Row="1"
                            Text="{x:Bind ExtensionsText}"
                            Foreground="{StaticResource BandaAccentBrush}"
                            FontSize="13"
                            Margin="0,5,0,0"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1" />

                        <TextBlock
                            Grid.Row="2"
                            Text="{x:Bind CountText}"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="30"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Row="3"
                            Text="archivos"
                            Style="{StaticResource BandaMutedTextStyle}"
                            FontSize="13" />
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="SearchResultTemplate" x:DataType="local:SearchFileResult">
            <Grid Padding="12,10" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*" />
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="1.25*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind Name}"
                        Foreground="{StaticResource BandaTextBrush}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Text="{x:Bind ExtensionDisplay}"
                        Foreground="{StaticResource BandaMutedBrush}"
                        FontSize="11" />
                </StackPanel>

                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Category}"
                    Foreground="{StaticResource BandaMutedStrongBrush}"
                    FontSize="13"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />

                <TextBlock
                    Grid.Column="2"
                    Text="{x:Bind SizeText}"
                    Foreground="{StaticResource BandaMutedStrongBrush}"
                    FontSize="13"
                    VerticalAlignment="Center" />

                <TextBlock
                    Grid.Column="3"
                    Text="{x:Bind ModifiedText}"
                    Foreground="{StaticResource BandaMutedStrongBrush}"
                    FontSize="13"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DateWheelItemTemplate">
            <Grid Height="36">
                <TextBlock
                    Text="{Binding}"
                    Foreground="{StaticResource BandaTextBrush}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    TextAlignment="Center"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

    </Page.Resources>

    <Grid>
        <Grid
            Padding="34,32,34,40"
            RowSpacing="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Spacing="5">
            <TextBlock
                Text="Buscar"
                Style="{StaticResource BandaSectionTitleStyle}"
                FontSize="32" />

            <TextBlock
                Text="Encontrá y explorá los archivos organizados por BandaNV."
                Style="{StaticResource BandaMutedTextStyle}"
                FontSize="14" />
        </StackPanel>

        <!-- Carrusel de categorías: 10 por tanda, siempre en orden global -->
        <Grid
            Grid.Row="1"
            RowSpacing="6">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="PreviousCategoriesButton"
                    Grid.Column="0"
                    Click="PreviousCategoriesButton_Click"
                    Width="34"
                    Height="72"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    Background="{StaticResource BandaCardBrush}"
                    BorderBrush="{StaticResource BandaBorderBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    IsEnabled="False">
                    <TextBlock Text="‹" FontSize="26" />
                </Button>

                <Grid
                    x:Name="CategoryCardsGrid"
                    Grid.Column="1"
                    ColumnSpacing="8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />

                <Button
                    x:Name="NextCategoriesButton"
                    Grid.Column="2"
                    Click="NextCategoriesButton_Click"
                    Width="34"
                    Height="72"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    Background="{StaticResource BandaCardBrush}"
                    BorderBrush="{StaticResource BandaBorderBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    IsEnabled="False">
                    <TextBlock Text="›" FontSize="26" />
                </Button>
            </Grid>

            <!-- Indicador por tandas: ● ○ ○ -->
            <StackPanel
                x:Name="CategoryPageDots"
                Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="7"
                Visibility="Collapsed" />
        </Grid>

        <!-- Herramientas de búsqueda -->
        <Grid
            Grid.Row="2"
            ColumnSpacing="12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="SearchBox"
                Grid.Column="0"
                PlaceholderText="Buscar por nombre, extensión o categoría..."
                TextChanged="SearchBox_TextChanged"
                FontSize="14"
                Padding="14,10"
                MinHeight="44" />

            <Border
                Grid.Column="1"
                Padding="14,0"
                CornerRadius="12"
                Background="{StaticResource BandaCardBrush}"
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="1"
                VerticalAlignment="Stretch">

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="5"
                    VerticalAlignment="Center">
                    <TextBlock
                        x:Name="SearchResultCountText"
                        Text="0"
                        Foreground="{StaticResource BandaTextBrush}"
                        FontWeight="SemiBold" />
                    <TextBlock
                        Text="archivos"
                        Style="{StaticResource BandaMutedTextStyle}" />
                </StackPanel>
            </Border>

            <Button
                x:Name="FiltersButton"
                Grid.Column="2"
                Content="Filtros"
                Click="FiltersButton_Click"
                Padding="16,10"
                MinHeight="44"
                CornerRadius="12"
                Background="{StaticResource BandaCardBrush}"
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="1" />

            <Button
                x:Name="SortSelectorButton"
                Grid.Column="3"
                Width="205"
                MinHeight="44"
                Style="{StaticResource BandaSelectorButtonStyle}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="SortValueText"
                        Text="Fecha · más reciente"
                        Foreground="{StaticResource BandaTextBrush}"
                        FontSize="13"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Text="⌄"
                        Foreground="{StaticResource BandaAccentBrush}"
                        FontSize="14"
                        VerticalAlignment="Center" />
                </Grid>

                <Button.Flyout>
                    <Flyout
                        x:Name="SortFlyout"
                        Placement="BottomEdgeAlignedLeft"
                        FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                        <Border
                            Width="245"
                            Padding="8"
                            CornerRadius="16"
                            Background="{StaticResource BandaPopupSurfaceBrush}"
                            BorderBrush="{StaticResource BandaBorderStrongBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Text="ORDENAR POR"
                                    Margin="10,6,10,4"
                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                    FontSize="11"
                                    FontWeight="SemiBold" />
                                <Button Tag="Newest" Content="Fecha · más reciente" Click="SortOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                <Button Tag="Oldest" Content="Fecha · más antigua" Click="SortOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                <Button Tag="NameAscending" Content="Nombre · A–Z" Click="SortOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                <Button Tag="NameDescending" Content="Nombre · Z–A" Click="SortOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                <Button Tag="SizeDescending" Content="Tamaño · mayor primero" Click="SortOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                <Button Tag="SizeAscending" Content="Tamaño · menor primero" Click="SortOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                <Button Tag="Category" Content="Categoría" Click="SortOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Tabla principal de resultados -->
        <Border
            Grid.Row="3"
            Style="{StaticResource BandaCardStyle}"
            Padding="0"
            MinHeight="400">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Chips / filtros activos -->
                <Grid
                    Padding="18,14"
                    ColumnSpacing="8">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="AllCategoriesChip"
                        Grid.Column="0"
                        Padding="12,6"
                        CornerRadius="14"
                        Background="{StaticResource BandaAccentSoftBrush}">
                        <TextBlock
                            Text="Todas"
                            Foreground="{StaticResource BandaAccentBrush}"
                            FontSize="13"
                            FontWeight="SemiBold" />
                    </Border>

                    <Border
                        x:Name="ActiveCategoriesChip"
                        Grid.Column="1"
                        Padding="12,6"
                        CornerRadius="14"
                        Background="{StaticResource BandaAccentSoftBrush}"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="ActiveCategoriesText"
                            Text=""
                            Foreground="{StaticResource BandaAccentBrush}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            MaxWidth="560"
                            TextTrimming="CharacterEllipsis" />
                    </Border>

                    <TextBlock
                        x:Name="NoFiltersText"
                        Grid.Column="2"
                        Text="Sin filtros"
                        Foreground="{StaticResource BandaMutedStrongBrush}"
                        FontSize="13"
                        VerticalAlignment="Center"
                        Margin="2,0,0,0" />

                    <Button
                        x:Name="ClearFiltersButton"
                        Grid.Column="3"
                        Content="Limpiar filtros"
                        Click="ClearFiltersButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource BandaMutedBrush}"
                        Padding="10,6"
                        IsEnabled="False" />
                </Grid>

                <!-- Resultados + detalle del archivo seleccionado -->
                <Grid
                    Grid.Row="1"
                    Margin="14,0,14,14"
                    ColumnSpacing="12">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.72*" />
                        <ColumnDefinition Width="0.78*" />
                    </Grid.ColumnDefinitions>

                    <!-- Lista de resultados -->
                    <Border
                        Grid.Column="0"
                        CornerRadius="14"
                        Background="{StaticResource BandaCardAltBrush}"
                        BorderBrush="{StaticResource BandaBorderBrush}"
                        BorderThickness="1">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="48" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid
                                Padding="16,0"
                                ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.1*" />
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="1.25*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="NOMBRE" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="CATEGORÍA" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="TAMAÑO" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="FECHA" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Grid.Row="1" MinHeight="330">
                                <ListView
                                    x:Name="SearchResultsList"
                                    ItemsSource="{x:Bind VisibleSearchResults, Mode=OneWay}"
                                    SelectionMode="Single"
                                    SelectionChanged="SearchResultsList_SelectionChanged"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="8,0,8,8">

                                    <ListView.Resources>
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#244FE0C6" />
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#304FE0C6" />
                                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#161F292D" />
                                        <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#F5F8FA" />
                                    </ListView.Resources>

                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,2" />
                                            <Setter Property="CornerRadius" Value="10" />
                                            <Setter Property="MinHeight" Value="54" />
                                        </Style>
                                    </ListView.ItemContainerStyle>

                                    <ListView.ItemTemplate>
                                        <StaticResource ResourceKey="SearchResultTemplate" />
                                    </ListView.ItemTemplate>
                                </ListView>

                                <StackPanel
                                    x:Name="EmptyStatePanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="10"
                                    Visibility="Collapsed">

                                    <Border
                                        Width="46"
                                        Height="46"
                                        CornerRadius="15"
                                        Background="{StaticResource BandaAccentSoftBrush}">
                                        <TextBlock
                                            Text="⌕"
                                            Foreground="{StaticResource BandaAccentBrush}"
                                            FontSize="22"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock
                                        x:Name="EmptyStateTitle"
                                        Text="No hay archivos que coincidan"
                                        Foreground="{StaticResource BandaTextBrush}"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center" />

                                    <TextBlock
                                        x:Name="EmptyStateDescription"
                                        Text="Probá cambiando las categorías seleccionadas o el texto de búsqueda."
                                        Style="{StaticResource BandaMutedTextStyle}"
                                        FontSize="13"
                                        HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Panel de detalle -->
                    <Border
                        Grid.Column="1"
                        CornerRadius="14"
                        Background="{StaticResource BandaCardAltBrush}"
                        BorderBrush="{StaticResource BandaBorderBrush}"
                        BorderThickness="1"
                        Padding="18">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock
                                    Text="Detalle del archivo"
                                    Foreground="{StaticResource BandaTextBrush}"
                                    FontSize="18"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="SearchDetailFileNameText"
                                    Text="Seleccioná un archivo"
                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                    FontSize="13"
                                    TextWrapping="Wrap"
                                    TextTrimming="CharacterEllipsis"
                                    MaxLines="2" />
                            </StackPanel>

                            <Grid
                                Grid.Row="1"
                                Margin="0,16,0,16"
                                ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Padding="12"
                                    CornerRadius="12"
                                    Background="{StaticResource BandaNavIconBrush}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="CATEGORÍA" Style="{StaticResource BandaMutedTextStyle}" FontSize="11" />
                                        <TextBlock
                                            x:Name="SearchDetailCategoryText"
                                            Text="—"
                                            Foreground="{StaticResource BandaAccentBrush}"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Padding="12"
                                    CornerRadius="12"
                                    Background="{StaticResource BandaNavIconBrush}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="TAMAÑO" Style="{StaticResource BandaMutedTextStyle}" FontSize="11" />
                                        <TextBlock
                                            x:Name="SearchDetailSizeText"
                                            Text="—"
                                            Foreground="{StaticResource BandaTextBrush}"
                                            FontSize="14"
                                            FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel
                                Grid.Row="2"
                                Spacing="14">

                                <StackPanel Spacing="5">
                                    <TextBlock Text="EXTENSIÓN" Style="{StaticResource BandaMutedTextStyle}" FontSize="11" />
                                    <TextBlock
                                        x:Name="SearchDetailExtensionText"
                                        Text="—"
                                        Foreground="{StaticResource BandaMutedStrongBrush}"
                                        FontSize="13" />
                                </StackPanel>

                                <StackPanel Spacing="5">
                                    <TextBlock Text="MODIFICADO" Style="{StaticResource BandaMutedTextStyle}" FontSize="11" />
                                    <TextBlock
                                        x:Name="SearchDetailModifiedText"
                                        Text="—"
                                        Foreground="{StaticResource BandaMutedStrongBrush}"
                                        FontSize="13" />
                                </StackPanel>

                                <StackPanel Spacing="5">
                                    <TextBlock Text="UBICACIÓN" Style="{StaticResource BandaMutedTextStyle}" FontSize="11" />
                                    <TextBlock
                                        x:Name="SearchDetailLocationText"
                                        Text="—"
                                        Foreground="{StaticResource BandaMutedStrongBrush}"
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="4" />
                                </StackPanel>

                                <TextBlock
                                    x:Name="SearchDetailActionStatusText"
                                    Text=""
                                    Foreground="{StaticResource BandaMutedBrush}"
                                    FontSize="11"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                            </StackPanel>

                            <StackPanel
                                Grid.Row="3"
                                Spacing="8"
                                Margin="0,16,0,0">
                                <Button
                                    x:Name="SearchOpenFileButton"
                                    Content="Abrir archivo"
                                    Click="SearchOpenFileButton_Click"
                                    Style="{StaticResource BandaPopupPrimaryButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    IsEnabled="False" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        x:Name="SearchOpenLocationButton"
                                        Content="Abrir ubicación"
                                        Click="SearchOpenLocationButton_Click"
                                        Style="{StaticResource BandaPopupSecondaryButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        IsEnabled="False" />

                                    <Button
                                        x:Name="SearchCopyPathButton"
                                        Grid.Column="1"
                                        Content="Copiar ruta"
                                        Click="SearchCopyPathButton_Click"
                                        Style="{StaticResource BandaPopupSecondaryButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        IsEnabled="False" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Pie de tabla -->
                <Grid
                    Grid.Row="2"
                    Padding="18,0,18,16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="SearchResultsFooterText"
                        Text="0 resultados"
                        Style="{StaticResource BandaMutedTextStyle}"
                        FontSize="13"
                        VerticalAlignment="Center" />

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button Content="‹" Width="34" Height="32" Padding="0" IsEnabled="False" />
                        <TextBlock Text="1 de 1" Style="{StaticResource BandaMutedTextStyle}" VerticalAlignment="Center" />
                        <Button Content="›" Width="34" Height="32" Padding="0" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        </Grid>

        <!-- Prototipo de popup BandaNV: filtros -->
        <Grid
            x:Name="FiltersOverlay"
            Canvas.ZIndex="100"
            Visibility="Collapsed">

            <Border
                Background="{StaticResource BandaPopupBackdropBrush}"
                Tapped="FiltersBackdrop_Tapped" />

            <Border
                Width="620"
                Style="{StaticResource BandaPopupCardStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <Grid RowSpacing="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="46"
                            Height="46"
                            CornerRadius="14"
                            Background="{StaticResource BandaAccentSoftBrush}">
                            <TextBlock
                                Text="≡"
                                Foreground="{StaticResource BandaAccentBrush}"
                                FontSize="24"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="4"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="Filtrar archivos"
                                Foreground="{StaticResource BandaTextBrush}"
                                FontSize="22"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Text="Combiná estos filtros con categorías y búsqueda para afinar los resultados."
                                Foreground="{StaticResource BandaMutedBrush}"
                                FontSize="13"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            Content="×"
                            Click="CloseFiltersOverlayButton_Click"
                            Style="{StaticResource BandaPopupCloseButtonStyle}"
                            VerticalAlignment="Top" />
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Padding="16"
                            CornerRadius="16"
                            Background="{StaticResource BandaCardBrush}"
                            BorderBrush="{StaticResource BandaBorderBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Text="FECHA DE MODIFICACIÓN"
                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                    FontSize="12"
                                    FontWeight="SemiBold" />
                                <Button
                                    x:Name="DateFilterSelectorButton"
                                    Style="{StaticResource BandaSelectorButtonStyle}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="DateFilterValueText"
                                            Text="Cualquier fecha"
                                            Foreground="{StaticResource BandaTextBrush}"
                                            FontSize="13"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="⌄"
                                            Foreground="{StaticResource BandaAccentBrush}"
                                            FontSize="14"
                                            VerticalAlignment="Center" />
                                    </Grid>

                                    <Button.Flyout>
                                        <Flyout
                                            x:Name="DateFilterFlyout"
                                            Placement="BottomEdgeAlignedLeft"
                        FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                                            <Border
                                                Width="245"
                                                Padding="8"
                                                CornerRadius="16"
                                                Background="{StaticResource BandaPopupSurfaceBrush}"
                                                BorderBrush="{StaticResource BandaBorderStrongBrush}"
                                                BorderThickness="1">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="FECHA DE MODIFICACIÓN" Margin="10,6,10,4" Foreground="{StaticResource BandaMutedStrongBrush}" FontSize="11" FontWeight="SemiBold" />
                                                    <Button Tag="All" Content="Cualquier fecha" Click="DateFilterOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                    <Button Tag="Today" Content="Hoy" Click="DateFilterOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                    <Button Tag="Last7Days" Content="Últimos 7 días" Click="DateFilterOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                    <Button Tag="Last30Days" Content="Últimos 30 días" Click="DateFilterOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                    <Border Height="1" Margin="8,5" Background="{StaticResource BandaBorderBrush}" />
                                                    <Button Tag="SpecificDate" Content="Elegir fecha específica…" Click="DateFilterOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>

                                <Border
                                    x:Name="SpecificDateWheelPanel"
                                    Padding="12"
                                    CornerRadius="11"
                                    Background="{StaticResource BandaCardAltBrush}"
                                    BorderBrush="{StaticResource BandaBorderStrongBrush}"
                                    BorderThickness="1"
                                    Visibility="Collapsed">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.8*" />
                                                <ColumnDefinition Width="1.55*" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Text="DÍA"
                                                Foreground="{StaticResource BandaMutedStrongBrush}"
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                TextAlignment="Center" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="MES"
                                                Foreground="{StaticResource BandaMutedStrongBrush}"
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                TextAlignment="Center" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="AÑO"
                                                Foreground="{StaticResource BandaMutedStrongBrush}"
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                TextAlignment="Center" />
                                        </Grid>

                                        <Grid Height="180">
                                            <Border
                                                Height="36"
                                                Margin="2,0"
                                                VerticalAlignment="Center"
                                                CornerRadius="9"
                                                Background="{StaticResource BandaAccentSoftBrush}"
                                                BorderBrush="{StaticResource BandaBorderStrongBrush}"
                                                BorderThickness="1"
                                                IsHitTestVisible="False" />

                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="0.8*" />
                                                    <ColumnDefinition Width="1.55*" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>

                                                <ScrollViewer
                                                    x:Name="DayWheelScrollViewer"
                                                    Tag="Day"
                                                    ViewChanged="DateWheelScrollViewer_ViewChanged"
                                                    VerticalScrollMode="Enabled"
                                                    VerticalScrollBarVisibility="Hidden"
                                                    HorizontalScrollMode="Disabled"
                                                    HorizontalScrollBarVisibility="Hidden">
                                                    <StackPanel>
                                                        <Border Height="72" />
                                                        <ItemsControl
                                                            x:Name="DayWheelItems"
                                                            ItemTemplate="{StaticResource DateWheelItemTemplate}" />
                                                        <Border Height="72" />
                                                    </StackPanel>
                                                </ScrollViewer>

                                                <ScrollViewer
                                                    x:Name="MonthWheelScrollViewer"
                                                    Grid.Column="1"
                                                    Tag="Month"
                                                    ViewChanged="DateWheelScrollViewer_ViewChanged"
                                                    VerticalScrollMode="Enabled"
                                                    VerticalScrollBarVisibility="Hidden"
                                                    HorizontalScrollMode="Disabled"
                                                    HorizontalScrollBarVisibility="Hidden">
                                                    <StackPanel>
                                                        <Border Height="72" />
                                                        <ItemsControl
                                                            x:Name="MonthWheelItems"
                                                            ItemTemplate="{StaticResource DateWheelItemTemplate}" />
                                                        <Border Height="72" />
                                                    </StackPanel>
                                                </ScrollViewer>

                                                <ScrollViewer
                                                    x:Name="YearWheelScrollViewer"
                                                    Grid.Column="2"
                                                    Tag="Year"
                                                    ViewChanged="DateWheelScrollViewer_ViewChanged"
                                                    VerticalScrollMode="Enabled"
                                                    VerticalScrollBarVisibility="Hidden"
                                                    HorizontalScrollMode="Disabled"
                                                    HorizontalScrollBarVisibility="Hidden">
                                                    <StackPanel>
                                                        <Border Height="72" />
                                                        <ItemsControl
                                                            x:Name="YearWheelItems"
                                                            ItemTemplate="{StaticResource DateWheelItemTemplate}" />
                                                        <Border Height="72" />
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Grid>

                                            <Border
                                                Height="52"
                                                VerticalAlignment="Top"
                                                IsHitTestVisible="False">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#F20C1418" Offset="0" />
                                                        <GradientStop Color="#000C1418" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>

                                            <Border
                                                Height="52"
                                                VerticalAlignment="Bottom"
                                                IsHitTestVisible="False">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#000C1418" Offset="0" />
                                                        <GradientStop Color="#F20C1418" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Grid>

                                        <Button
                                            Content="Hoy"
                                            Click="SpecificDateTodayButton_Click"
                                            HorizontalAlignment="Right"
                                            Padding="10,5"
                                            CornerRadius="9"
                                            Background="Transparent"
                                            BorderBrush="{StaticResource BandaBorderBrush}"
                                            BorderThickness="1"
                                            Foreground="{StaticResource BandaAccentBrush}"
                                            FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Padding="16"
                            CornerRadius="16"
                            Background="{StaticResource BandaCardBrush}"
                            BorderBrush="{StaticResource BandaBorderBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Text="TAMAÑO"
                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                    FontSize="12"
                                    FontWeight="SemiBold" />
                                <Button
                                    x:Name="SizeFilterSelectorButton"
                                    Style="{StaticResource BandaSelectorButtonStyle}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="SizeFilterValueText"
                                            Text="Cualquier tamaño"
                                            Foreground="{StaticResource BandaTextBrush}"
                                            FontSize="13"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="⌄"
                                            Foreground="{StaticResource BandaAccentBrush}"
                                            FontSize="14"
                                            VerticalAlignment="Center" />
                                    </Grid>

                                    <Button.Flyout>
                                        <Flyout
                                            x:Name="SizeFilterFlyout"
                                            Placement="BottomEdgeAlignedLeft"
                        FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                                            <Border
                                                Width="245"
                                                Padding="8"
                                                CornerRadius="16"
                                                Background="{StaticResource BandaPopupSurfaceBrush}"
                                                BorderBrush="{StaticResource BandaBorderStrongBrush}"
                                                BorderThickness="1">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="TAMAÑO" Margin="10,6,10,4" Foreground="{StaticResource BandaMutedStrongBrush}" FontSize="11" FontWeight="SemiBold" />
                                                    <Button Tag="All" Content="Cualquier tamaño" Click="SizeFilterOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                    <Button Tag="Under100Mb" Content="Menos de 100 MB" Click="SizeFilterOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                    <Button Tag="From100To500Mb" Content="100 MB a 500 MB" Click="SizeFilterOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                    <Button Tag="From500MbTo1Gb" Content="500 MB a 1 GB" Click="SizeFilterOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                    <Button Tag="From1To5Gb" Content="1 GB a 5 GB" Click="SizeFilterOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                    <Button Tag="From5To20Gb" Content="5 GB a 20 GB" Click="SizeFilterOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                    <Button Tag="Over20Gb" Content="Más de 20 GB" Click="SizeFilterOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border
                        Grid.Row="2"
                        Padding="16"
                        CornerRadius="16"
                        Background="{StaticResource BandaCardBrush}"
                        BorderBrush="{StaticResource BandaBorderBrush}"
                        BorderThickness="1">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.45*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock
                                    Text="EXTENSIÓN"
                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                    FontSize="12"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Seleccioná uno o varios formatos presentes en los archivos organizados."
                                    Foreground="{StaticResource BandaMutedBrush}"
                                    FontSize="12"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Button
                                x:Name="ExtensionFilterSelectorButton"
                                Grid.Column="1"
                                Style="{StaticResource BandaSelectorButtonStyle}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="ExtensionFilterValueText"
                                        Text="Todas las extensiones"
                                        Foreground="{StaticResource BandaTextBrush}"
                                        FontSize="13"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="⌄"
                                        Foreground="{StaticResource BandaAccentBrush}"
                                        FontSize="14"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <Button.Flyout>
                                    <Flyout
                                        x:Name="ExtensionFilterFlyout"
                                        Placement="BottomEdgeAlignedLeft"
                        FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                                        <Border
                                            Width="245"
                                            MaxHeight="330"
                                            Padding="8"
                                            CornerRadius="16"
                                            Background="{StaticResource BandaPopupSurfaceBrush}"
                                            BorderBrush="{StaticResource BandaBorderStrongBrush}"
                                            BorderThickness="1">
                                            <Grid
                                                Padding="0,0,12,0">
                                                <ScrollViewer
                                                    Margin="0,4,0,4"
                                                    VerticalScrollBarVisibility="Auto"
                                                    HorizontalScrollBarVisibility="Disabled">
                                                    <StackPanel
                                                        x:Name="ExtensionFilterOptionsPanel"
                                                        Margin="0,0,12,0"
                                                        Spacing="2" />
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </Border>

                    <Grid
                        Grid.Row="3"
                        Margin="0,2,0,0"
                        ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <Border
                                Width="8"
                                Height="8"
                                CornerRadius="4"
                                Background="{StaticResource BandaAccentBrush}" />
                            <TextBlock
                                Text="Los cambios se aplican al confirmar."
                                Foreground="{StaticResource BandaMutedBrush}"
                                FontSize="12"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Content="Restablecer"
                            Click="ResetFiltersOverlayButton_Click"
                            Style="{StaticResource BandaPopupGhostButtonStyle}"
                            MinWidth="108" />

                        <Button
                            Grid.Column="2"
                            Content="Cancelar"
                            Click="CloseFiltersOverlayButton_Click"
                            Style="{StaticResource BandaPopupSecondaryButtonStyle}" />

                        <Button
                            Grid.Column="3"
                            Content="Aplicar filtros"
                            Click="ApplyFiltersOverlayButton_Click"
                            Style="{StaticResource BandaPopupPrimaryButtonStyle}"
                            MinWidth="126" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>