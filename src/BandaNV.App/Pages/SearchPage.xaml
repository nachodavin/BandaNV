<Page
    x:Class="BandaNV.App.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BandaNV.App.Pages"
    Background="Transparent">

    <Page.Resources>
        <SolidColorBrush x:Key="BandaPopupSurfaceBrush" Color="#FF0C1418" />

        <DataTemplate x:Key="CategoryCardTemplate" x:DataType="local:SearchCategorySummary">
            <Button
                Tag="{x:Bind Name}"
                Click="CategoryCard_Click"
                Height="122"
                Padding="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="18">

                <Border
                    Padding="18"
                    CornerRadius="18"
                    Background="{x:Bind CardBackground}"
                    BorderBrush="{x:Bind CardBorderBrush}"
                    BorderThickness="1">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            Width="9"
                            Height="9"
                            CornerRadius="5"
                            Background="{StaticResource BandaAccentBrush}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Visibility="{x:Bind SelectedVisibility}" />

                        <TextBlock
                            Text="{x:Bind Name}"
                            Foreground="{StaticResource BandaMutedStrongBrush}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1" />

                        <TextBlock
                            Grid.Row="1"
                            Text="{x:Bind ExtensionsText}"
                            Foreground="{StaticResource BandaAccentBrush}"
                            FontSize="13"
                            Margin="0,5,0,0"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1" />

                        <TextBlock
                            Grid.Row="2"
                            Text="{x:Bind CountText}"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="30"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Row="3"
                            Text="archivos"
                            Style="{StaticResource BandaMutedTextStyle}"
                            FontSize="13" />
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="SearchResultTemplate" x:DataType="local:SearchFileResult">
            <Border
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid Padding="16,12" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.4*" />
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind Name}"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind ExtensionDisplay}"
                            Foreground="{StaticResource BandaMutedBrush}"
                            FontSize="11" />
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind Category}"
                        Foreground="{StaticResource BandaMutedStrongBrush}"
                        FontSize="13"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        Grid.Column="2"
                        Text="{x:Bind SizeText}"
                        Foreground="{StaticResource BandaMutedStrongBrush}"
                        FontSize="13"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Grid.Column="3"
                        Text="{x:Bind ModifiedText}"
                        Foreground="{StaticResource BandaMutedStrongBrush}"
                        FontSize="13"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Grid.Column="4"
                        Text="{x:Bind Location}"
                        Foreground="{StaticResource BandaMutedBrush}"
                        FontSize="13"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        Grid.Column="5"
                        Text="···"
                        Foreground="{StaticResource BandaMutedBrush}"
                        FontSize="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="BandaPopupFlyoutPresenterStyle" TargetType="FlyoutPresenter">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <Style x:Key="BandaPopupOptionButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource BandaTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="BandaSelectorButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{StaticResource BandaCardAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BandaBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource BandaTextBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid
            Padding="34,32,34,40"
            RowSpacing="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Spacing="5">
            <TextBlock
                Text="Buscar"
                Style="{StaticResource BandaSectionTitleStyle}"
                FontSize="32" />

            <TextBlock
                Text="Encontrá y explorá los archivos organizados por BandaNV."
                Style="{StaticResource BandaMutedTextStyle}"
                FontSize="14" />
        </StackPanel>

        <!-- Carrusel de categorías: 10 por tanda, siempre en orden global -->
        <Grid
            Grid.Row="1"
            RowSpacing="6">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="PreviousCategoriesButton"
                    Grid.Column="0"
                    Click="PreviousCategoriesButton_Click"
                    Width="34"
                    Height="72"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    Background="{StaticResource BandaCardBrush}"
                    BorderBrush="{StaticResource BandaBorderBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    IsEnabled="False">
                    <TextBlock Text="‹" FontSize="26" />
                </Button>

                <Grid
                    x:Name="CategoryCardsGrid"
                    Grid.Column="1"
                    ColumnSpacing="8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />

                <Button
                    x:Name="NextCategoriesButton"
                    Grid.Column="2"
                    Click="NextCategoriesButton_Click"
                    Width="34"
                    Height="72"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    Background="{StaticResource BandaCardBrush}"
                    BorderBrush="{StaticResource BandaBorderBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    IsEnabled="False">
                    <TextBlock Text="›" FontSize="26" />
                </Button>
            </Grid>

            <!-- Indicador por tandas: ● ○ ○ -->
            <StackPanel
                x:Name="CategoryPageDots"
                Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="7"
                Visibility="Collapsed" />
        </Grid>

        <!-- Herramientas de búsqueda -->
        <Grid
            Grid.Row="2"
            ColumnSpacing="12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="SearchBox"
                Grid.Column="0"
                PlaceholderText="Buscar por nombre, extensión o categoría..."
                TextChanged="SearchBox_TextChanged"
                FontSize="14"
                Padding="14,10"
                MinHeight="44" />

            <Border
                Grid.Column="1"
                Padding="14,0"
                CornerRadius="12"
                Background="{StaticResource BandaCardBrush}"
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="1"
                VerticalAlignment="Stretch">

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="5"
                    VerticalAlignment="Center">
                    <TextBlock
                        x:Name="SearchResultCountText"
                        Text="0"
                        Foreground="{StaticResource BandaTextBrush}"
                        FontWeight="SemiBold" />
                    <TextBlock
                        Text="archivos"
                        Style="{StaticResource BandaMutedTextStyle}" />
                </StackPanel>
            </Border>

            <Button
                x:Name="FiltersButton"
                Grid.Column="2"
                Content="Filtros"
                Click="FiltersButton_Click"
                Padding="16,10"
                MinHeight="44"
                CornerRadius="12"
                Background="{StaticResource BandaCardBrush}"
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="1" />

            <Button
                x:Name="SortSelectorButton"
                Grid.Column="3"
                Width="205"
                MinHeight="44"
                Style="{StaticResource BandaSelectorButtonStyle}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="SortValueText"
                        Text="Fecha · más reciente"
                        Foreground="{StaticResource BandaTextBrush}"
                        FontSize="13"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Text="⌄"
                        Foreground="{StaticResource BandaAccentBrush}"
                        FontSize="14"
                        VerticalAlignment="Center" />
                </Grid>

                <Button.Flyout>
                    <Flyout
                        x:Name="SortFlyout"
                        Placement="BottomEdgeAlignedLeft"
                        FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                        <Border
                            Width="245"
                            Padding="8"
                            CornerRadius="16"
                            Background="{StaticResource BandaPopupSurfaceBrush}"
                            BorderBrush="{StaticResource BandaBorderStrongBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Text="ORDENAR POR"
                                    Margin="10,6,10,4"
                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                    FontSize="11"
                                    FontWeight="SemiBold" />
                                <Button Tag="Newest" Content="Fecha · más reciente" Click="SortOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                <Button Tag="Oldest" Content="Fecha · más antigua" Click="SortOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                <Button Tag="NameAscending" Content="Nombre · A–Z" Click="SortOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                <Button Tag="NameDescending" Content="Nombre · Z–A" Click="SortOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                <Button Tag="SizeDescending" Content="Tamaño · mayor primero" Click="SortOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                <Button Tag="SizeAscending" Content="Tamaño · menor primero" Click="SortOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                <Button Tag="Category" Content="Categoría" Click="SortOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Tabla principal de resultados -->
        <Border
            Grid.Row="3"
            Style="{StaticResource BandaCardStyle}"
            Padding="0"
            MinHeight="400">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Chips / filtros activos -->
                <Grid
                    Padding="18,14"
                    ColumnSpacing="8">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="AllCategoriesChip"
                        Grid.Column="0"
                        Padding="12,6"
                        CornerRadius="14"
                        Background="{StaticResource BandaAccentSoftBrush}">
                        <TextBlock
                            Text="Todas"
                            Foreground="{StaticResource BandaAccentBrush}"
                            FontSize="13"
                            FontWeight="SemiBold" />
                    </Border>

                    <Border
                        x:Name="ActiveCategoriesChip"
                        Grid.Column="1"
                        Padding="12,6"
                        CornerRadius="14"
                        Background="{StaticResource BandaAccentSoftBrush}"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="ActiveCategoriesText"
                            Text=""
                            Foreground="{StaticResource BandaAccentBrush}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            MaxWidth="560"
                            TextTrimming="CharacterEllipsis" />
                    </Border>

                    <TextBlock
                        x:Name="NoFiltersText"
                        Grid.Column="2"
                        Text="Sin filtros"
                        Foreground="{StaticResource BandaMutedStrongBrush}"
                        FontSize="13"
                        VerticalAlignment="Center"
                        Margin="2,0,0,0" />

                    <Button
                        x:Name="ClearFiltersButton"
                        Grid.Column="3"
                        Content="Limpiar filtros"
                        Click="ClearFiltersButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource BandaMutedBrush}"
                        Padding="10,6"
                        IsEnabled="False" />
                </Grid>

                <!-- Encabezado de tabla -->
                <Border
                    Grid.Row="1"
                    Margin="14,0,14,14"
                    CornerRadius="14"
                    Background="{StaticResource BandaCardAltBrush}"
                    BorderBrush="{StaticResource BandaBorderBrush}"
                    BorderThickness="1">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid
                            Padding="16,0"
                            ColumnSpacing="16"
                            VerticalAlignment="Stretch">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.4*" />
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="NOMBRE" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="CATEGORÍA" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="TAMAÑO" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="FECHA" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="UBICACIÓN" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="" />
                        </Grid>

                        <Grid
                            Grid.Row="1"
                            MinHeight="330">

                            <ScrollViewer
                                x:Name="SearchResultsScrollViewer"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl
                                    x:Name="SearchResultsList"
                                    ItemTemplate="{StaticResource SearchResultTemplate}"
                                    HorizontalContentAlignment="Stretch" />
                            </ScrollViewer>

                            <StackPanel
                                x:Name="EmptyStatePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                Visibility="Collapsed">

                                <Border
                                    Width="46"
                                    Height="46"
                                    CornerRadius="15"
                                    Background="{StaticResource BandaAccentSoftBrush}">
                                    <TextBlock
                                        Text="⌕"
                                        Foreground="{StaticResource BandaAccentBrush}"
                                        FontSize="22"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>

                                <TextBlock
                                    x:Name="EmptyStateTitle"
                                    Text="No hay archivos que coincidan"
                                    Foreground="{StaticResource BandaTextBrush}"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center" />

                                <TextBlock
                                    x:Name="EmptyStateDescription"
                                    Text="Probá cambiando las categorías seleccionadas o el texto de búsqueda."
                                    Style="{StaticResource BandaMutedTextStyle}"
                                    FontSize="13"
                                    HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Pie de tabla -->
                <Grid
                    Grid.Row="2"
                    Padding="18,0,18,16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="SearchResultsFooterText"
                        Text="0 resultados"
                        Style="{StaticResource BandaMutedTextStyle}"
                        FontSize="13"
                        VerticalAlignment="Center" />

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button Content="‹" Width="34" Height="32" Padding="0" IsEnabled="False" />
                        <TextBlock Text="1 de 1" Style="{StaticResource BandaMutedTextStyle}" VerticalAlignment="Center" />
                        <Button Content="›" Width="34" Height="32" Padding="0" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        </Grid>

        <!-- Prototipo de popup BandaNV: filtros -->
        <Grid
            x:Name="FiltersOverlay"
            Canvas.ZIndex="100"
            Visibility="Collapsed">

            <Border
                Background="#B3080C11"
                Tapped="FiltersBackdrop_Tapped" />

            <Border
                Width="620"
                Padding="26"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="22"
                Background="{StaticResource BandaPopupSurfaceBrush}"
                BorderBrush="{StaticResource BandaBorderStrongBrush}"
                BorderThickness="1">

                <Grid RowSpacing="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="46"
                            Height="46"
                            CornerRadius="14"
                            Background="{StaticResource BandaAccentSoftBrush}">
                            <TextBlock
                                Text="≡"
                                Foreground="{StaticResource BandaAccentBrush}"
                                FontSize="24"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="4"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="Filtrar archivos"
                                Foreground="{StaticResource BandaTextBrush}"
                                FontSize="22"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Text="Combiná estos filtros con categorías y búsqueda para afinar los resultados."
                                Foreground="{StaticResource BandaMutedBrush}"
                                FontSize="13"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            Content="×"
                            Click="CloseFiltersOverlayButton_Click"
                            Width="36"
                            Height="36"
                            Padding="0"
                            CornerRadius="12"
                            Background="{StaticResource BandaCardBrush}"
                            BorderBrush="{StaticResource BandaBorderBrush}"
                            BorderThickness="1"
                            Foreground="{StaticResource BandaMutedStrongBrush}"
                            FontSize="20"
                            VerticalAlignment="Top" />
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Padding="16"
                            CornerRadius="16"
                            Background="{StaticResource BandaCardBrush}"
                            BorderBrush="{StaticResource BandaBorderBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Text="FECHA DE MODIFICACIÓN"
                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                    FontSize="12"
                                    FontWeight="SemiBold" />
                                <Button
                                    x:Name="DateFilterSelectorButton"
                                    Style="{StaticResource BandaSelectorButtonStyle}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="DateFilterValueText"
                                            Text="Cualquier fecha"
                                            Foreground="{StaticResource BandaTextBrush}"
                                            FontSize="13"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="⌄"
                                            Foreground="{StaticResource BandaAccentBrush}"
                                            FontSize="14"
                                            VerticalAlignment="Center" />
                                    </Grid>

                                    <Button.Flyout>
                                        <Flyout
                                            x:Name="DateFilterFlyout"
                                            Placement="BottomEdgeAlignedLeft"
                        FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                                            <Border
                                                Width="245"
                                                Padding="8"
                                                CornerRadius="16"
                                                Background="{StaticResource BandaPopupSurfaceBrush}"
                                                BorderBrush="{StaticResource BandaBorderStrongBrush}"
                                                BorderThickness="1">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="FECHA DE MODIFICACIÓN" Margin="10,6,10,4" Foreground="{StaticResource BandaMutedStrongBrush}" FontSize="11" FontWeight="SemiBold" />
                                                    <Button Tag="All" Content="Cualquier fecha" Click="DateFilterOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                    <Button Tag="Last24Hours" Content="Últimas 24 horas" Click="DateFilterOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                    <Button Tag="Last7Days" Content="Últimos 7 días" Click="DateFilterOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                    <Button Tag="Last30Days" Content="Últimos 30 días" Click="DateFilterOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Padding="16"
                            CornerRadius="16"
                            Background="{StaticResource BandaCardBrush}"
                            BorderBrush="{StaticResource BandaBorderBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Text="TAMAÑO"
                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                    FontSize="12"
                                    FontWeight="SemiBold" />
                                <Button
                                    x:Name="SizeFilterSelectorButton"
                                    Style="{StaticResource BandaSelectorButtonStyle}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="SizeFilterValueText"
                                            Text="Cualquier tamaño"
                                            Foreground="{StaticResource BandaTextBrush}"
                                            FontSize="13"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="⌄"
                                            Foreground="{StaticResource BandaAccentBrush}"
                                            FontSize="14"
                                            VerticalAlignment="Center" />
                                    </Grid>

                                    <Button.Flyout>
                                        <Flyout
                                            x:Name="SizeFilterFlyout"
                                            Placement="BottomEdgeAlignedLeft"
                        FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                                            <Border
                                                Width="245"
                                                Padding="8"
                                                CornerRadius="16"
                                                Background="{StaticResource BandaPopupSurfaceBrush}"
                                                BorderBrush="{StaticResource BandaBorderStrongBrush}"
                                                BorderThickness="1">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="TAMAÑO" Margin="10,6,10,4" Foreground="{StaticResource BandaMutedStrongBrush}" FontSize="11" FontWeight="SemiBold" />
                                                    <Button Tag="All" Content="Cualquier tamaño" Click="SizeFilterOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                    <Button Tag="Under100Mb" Content="Menos de 100 MB" Click="SizeFilterOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                    <Button Tag="From100To500Mb" Content="100 MB a 500 MB" Click="SizeFilterOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                    <Button Tag="From500MbTo1Gb" Content="500 MB a 1 GB" Click="SizeFilterOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                    <Button Tag="From1To5Gb" Content="1 GB a 5 GB" Click="SizeFilterOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                    <Button Tag="From5To20Gb" Content="5 GB a 20 GB" Click="SizeFilterOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                    <Button Tag="Over20Gb" Content="Más de 20 GB" Click="SizeFilterOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border
                        Grid.Row="2"
                        Padding="16"
                        CornerRadius="16"
                        Background="{StaticResource BandaCardBrush}"
                        BorderBrush="{StaticResource BandaBorderBrush}"
                        BorderThickness="1">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.45*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock
                                    Text="EXTENSIÓN"
                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                    FontSize="12"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Limitá los resultados a un formato puntual."
                                    Foreground="{StaticResource BandaMutedBrush}"
                                    FontSize="12"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Button
                                x:Name="ExtensionFilterSelectorButton"
                                Grid.Column="1"
                                Style="{StaticResource BandaSelectorButtonStyle}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="ExtensionFilterValueText"
                                        Text="Todas las extensiones"
                                        Foreground="{StaticResource BandaTextBrush}"
                                        FontSize="13"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="⌄"
                                        Foreground="{StaticResource BandaAccentBrush}"
                                        FontSize="14"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <Button.Flyout>
                                    <Flyout
                                        x:Name="ExtensionFilterFlyout"
                                        Placement="BottomEdgeAlignedLeft"
                        FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                                        <Border
                                            Width="245"
                                            MaxHeight="330"
                                            Padding="8"
                                            CornerRadius="16"
                                            Background="{StaticResource BandaPopupSurfaceBrush}"
                                            BorderBrush="{StaticResource BandaBorderStrongBrush}"
                                            BorderThickness="1">
                                            <Grid
                                                Padding="0,0,12,0">
                                                <ScrollViewer
                                                    Margin="0,4,0,4"
                                                    VerticalScrollBarVisibility="Auto"
                                                    HorizontalScrollBarVisibility="Disabled">
                                                    <StackPanel
                                                        x:Name="ExtensionFilterOptionsPanel"
                                                        Margin="0,0,12,0"
                                                        Spacing="2" />
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </Border>

                    <Grid
                        Grid.Row="3"
                        Margin="0,2,0,0"
                        ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <Border
                                Width="8"
                                Height="8"
                                CornerRadius="4"
                                Background="{StaticResource BandaAccentBrush}" />
                            <TextBlock
                                Text="Los cambios se aplican al confirmar."
                                Foreground="{StaticResource BandaMutedBrush}"
                                FontSize="12"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Content="Restablecer"
                            Click="ResetFiltersOverlayButton_Click"
                            Padding="16,9"
                            MinWidth="108"
                            CornerRadius="11"
                            Background="Transparent"
                            BorderBrush="{StaticResource BandaBorderBrush}"
                            BorderThickness="1"
                            Foreground="{StaticResource BandaMutedStrongBrush}" />

                        <Button
                            Grid.Column="2"
                            Content="Cancelar"
                            Click="CloseFiltersOverlayButton_Click"
                            Padding="16,9"
                            MinWidth="92"
                            CornerRadius="11"
                            Background="{StaticResource BandaCardBrush}"
                            BorderBrush="{StaticResource BandaBorderBrush}"
                            BorderThickness="1"
                            Foreground="{StaticResource BandaTextBrush}" />

                        <Button
                            Grid.Column="3"
                            Content="Aplicar filtros"
                            Click="ApplyFiltersOverlayButton_Click"
                            Padding="18,9"
                            MinWidth="126"
                            CornerRadius="11"
                            Background="{StaticResource BandaAccentBrush}"
                            BorderThickness="0"
                            Foreground="#07110F"
                            FontWeight="SemiBold" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>