<Page
    x:Class="BandaNV.App.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BandaNV.App.Pages"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="CategoryCardTemplate" x:DataType="local:SearchCategorySummary">
            <Button
                Tag="{x:Bind Name}"
                Click="CategoryCard_Click"
                Height="140"
                Padding="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="18">

                <Border
                    Padding="18"
                    CornerRadius="18"
                    Background="{x:Bind CardBackground}"
                    BorderBrush="{x:Bind CardBorderBrush}"
                    BorderThickness="1">

                    <Grid RowSpacing="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            Width="9"
                            Height="9"
                            CornerRadius="5"
                            Background="{x:Bind CategoryBrush}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Visibility="{x:Bind SelectedVisibility}" />

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="7">
                            <Ellipse
                                Width="9"
                                Height="9"
                                Fill="{x:Bind CategoryBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="{x:Bind Name}"
                                Foreground="{StaticResource BandaMutedStrongBrush}"
                                FontSize="13"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1" />
                        </StackPanel>

                        <TextBlock
                            Grid.Row="1"
                            Text="{x:Bind ExtensionsText}"
                            Foreground="{x:Bind CategoryBrush}"
                            FontSize="13"
                            Margin="0,6,0,0"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1" />

                        <TextBlock
                            Grid.Row="2"
                            Text="{x:Bind CountText}"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="30"
                            FontWeight="SemiBold"
                            Margin="0,6,0,0"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Row="3"
                            Text="Elementos"
                            Style="{StaticResource BandaMutedTextStyle}"
                            FontSize="13"
                            Margin="0,2,0,0" />
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="SearchResultTemplate" x:DataType="local:SearchFileResult">
            <Grid Padding="12,10" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*" />
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="1.25*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind Name}"
                        Foreground="{StaticResource BandaTextBrush}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Text="{x:Bind ExtensionDisplay}"
                        Foreground="{StaticResource BandaMutedBrush}"
                        FontSize="11" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="7"
                    VerticalAlignment="Center">
                    <Ellipse
                        Width="8"
                        Height="8"
                        Fill="{x:Bind CategoryBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind Category}"
                        Foreground="{x:Bind CategoryBrush}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock
                    Grid.Column="2"
                    Text="{x:Bind SizeText}"
                    Foreground="{StaticResource BandaMutedStrongBrush}"
                    FontSize="13"
                    VerticalAlignment="Center" />

                <TextBlock
                    Grid.Column="3"
                    Text="{x:Bind ModifiedText}"
                    Foreground="{StaticResource BandaMutedStrongBrush}"
                    FontSize="13"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SearchFolderContentTemplate" x:DataType="local:SearchFolderContentItem">
            <Grid
                Padding="10,9"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.15*" />
                    <ColumnDefinition Width="0.75*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="1.35*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="{x:Bind RelativePath}"
                    Foreground="{StaticResource BandaTextBrush}"
                    FontSize="12"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />

                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind ExtensionDisplay}"
                    Foreground="{StaticResource BandaMutedStrongBrush}"
                    FontSize="11"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />

                <TextBlock
                    Grid.Column="2"
                    Text="{x:Bind SizeText}"
                    Foreground="{StaticResource BandaMutedStrongBrush}"
                    FontSize="11"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />

                <TextBlock
                    Grid.Column="3"
                    Text="{x:Bind ModifiedText}"
                    Foreground="{StaticResource BandaMutedBrush}"
                    FontSize="11"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DateWheelItemTemplate">
            <Grid Height="36">
                <TextBlock
                    Text="{Binding}"
                    Foreground="{StaticResource BandaTextBrush}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    TextAlignment="Center"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

    </Page.Resources>

    <Grid>
        <Grid
            Padding="34,32,34,40"
            RowSpacing="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Spacing="5">
            <TextBlock
                Text="Buscar"
                Style="{StaticResource BandaSectionTitleStyle}"
                FontSize="32" />

            <TextBlock
                Text="Encontrá y explorá los archivos y carpetas organizados por BandaNV."
                Style="{StaticResource BandaMutedTextStyle}"
                FontSize="14" />
        </StackPanel>

        <!-- Carrusel de categorías: 10 por tanda, siempre en orden global -->
        <Grid
            Grid.Row="1"
            RowSpacing="6">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="PreviousCategoriesButton"
                    Grid.Column="0"
                    Click="PreviousCategoriesButton_Click"
                    Width="34"
                    Height="72"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    Background="{StaticResource BandaCardBrush}"
                    BorderBrush="{StaticResource BandaBorderBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    IsEnabled="False">
                    <TextBlock Text="‹" FontSize="26" />
                </Button>

                <Grid
                    x:Name="CategoryCardsGrid"
                    Grid.Column="1"
                    ColumnSpacing="8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />

                <Button
                    x:Name="NextCategoriesButton"
                    Grid.Column="2"
                    Click="NextCategoriesButton_Click"
                    Width="34"
                    Height="72"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    Background="{StaticResource BandaCardBrush}"
                    BorderBrush="{StaticResource BandaBorderBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    IsEnabled="False">
                    <TextBlock Text="›" FontSize="26" />
                </Button>
            </Grid>

            <!-- Indicador por tandas: ● ○ ○ -->
            <StackPanel
                x:Name="CategoryPageDots"
                Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="7"
                Visibility="Collapsed" />
        </Grid>

        <!-- Herramientas de búsqueda -->
        <Grid
            Grid.Row="2"
            ColumnSpacing="12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="SearchBox"
                Grid.Column="0"
                PlaceholderText="Buscar por nombre, contenido, extensión o categoría..."
                TextChanged="SearchBox_TextChanged"
                FontSize="14"
                Padding="14,10"
                MinHeight="44" />

            <Border
                Grid.Column="1"
                Padding="14,0"
                CornerRadius="12"
                Background="{StaticResource BandaCardBrush}"
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="1"
                VerticalAlignment="Stretch">

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="5"
                    VerticalAlignment="Center">
                    <TextBlock
                        x:Name="SearchResultCountText"
                        Text="0"
                        Foreground="{StaticResource BandaTextBrush}"
                        FontWeight="SemiBold" />
                    <TextBlock
                        Text="Elementos"
                        Style="{StaticResource BandaMutedTextStyle}" />
                </StackPanel>
            </Border>

            <Button
                x:Name="FiltersButton"
                Grid.Column="2"
                Content="Filtros"
                Click="FiltersButton_Click"
                Padding="16,10"
                MinHeight="44"
                CornerRadius="12"
                Background="{StaticResource BandaCardBrush}"
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="1" />

            <Button
                x:Name="SortSelectorButton"
                Grid.Column="3"
                Width="215"
                MinHeight="52"
                Style="{StaticResource BandaSelectorButtonStyle}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock
                            Text="ORDENAR POR"
                            Foreground="{StaticResource BandaMutedBrush}"
                            FontSize="10"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="SortValueText"
                            Text="Fecha de modificación · Desc."
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="13"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Text="⌄"
                        Foreground="{StaticResource BandaAccentBrush}"
                        FontSize="14"
                        VerticalAlignment="Center" />
                </Grid>

                <Button.Flyout>
                    <Flyout
                        x:Name="SortFlyout"
                        Placement="BottomEdgeAlignedLeft"
                        FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                        <Border
                            Width="245"
                            Padding="8"
                            CornerRadius="16"
                            Background="{StaticResource BandaPopupSurfaceBrush}"
                            BorderBrush="{StaticResource BandaBorderStrongBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Text="ORDENAR POR"
                                    Margin="10,6,10,4"
                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                    FontSize="11"
                                    FontWeight="SemiBold" />
                                <Button Tag="Name" Content="Nombre" Click="SortFieldOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                <Button Tag="DateModified" Content="Fecha de modificación" Click="SortFieldOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                <Button Tag="Size" Content="Tamaño" Click="SortFieldOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                <Button Tag="Category" Content="Categoría" Click="SortFieldOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                <Button Tag="Extension" Content="Extensión" Click="SortFieldOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />

                                <Rectangle Height="1" Fill="{StaticResource BandaBorderBrush}" Margin="8,6" />

                                <Button Tag="Ascending" Content="Ascendente" Click="SortDirectionOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                <Button Tag="Descending" Content="Descendente" Click="SortDirectionOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <Button
                x:Name="GroupSelectorButton"
                Grid.Column="4"
                Width="205"
                MinHeight="52"
                Style="{StaticResource BandaSelectorButtonStyle}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock
                            Text="AGRUPAR POR"
                            Foreground="{StaticResource BandaMutedBrush}"
                            FontSize="10"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="GroupValueText"
                            Text="Ninguno"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="13"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Text="⌄"
                        Foreground="{StaticResource BandaAccentBrush}"
                        FontSize="14"
                        VerticalAlignment="Center" />
                </Grid>

                <Button.Flyout>
                    <Flyout
                        x:Name="GroupFlyout"
                        Placement="BottomEdgeAlignedLeft"
                        FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                        <Border
                            Width="245"
                            Padding="8"
                            CornerRadius="16"
                            Background="{StaticResource BandaPopupSurfaceBrush}"
                            BorderBrush="{StaticResource BandaBorderStrongBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Text="AGRUPAR POR"
                                    Margin="10,6,10,4"
                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                    FontSize="11"
                                    FontWeight="SemiBold" />
                                <Button Tag="None" Content="(Ninguno)" Click="GroupFieldOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                <Button Tag="Name" Content="Nombre" Click="GroupFieldOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                <Button Tag="DateModified" Content="Fecha de modificación" Click="GroupFieldOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                <Button Tag="Size" Content="Tamaño" Click="GroupFieldOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                <Button Tag="Category" Content="Categoría" Click="GroupFieldOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                <Button Tag="Extension" Content="Extensión" Click="GroupFieldOptionButton_Click" Style="{StaticResource BandaPopupOptionButtonStyle}" />

                            </StackPanel>
                        </Border>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Tabla principal de resultados -->
        <Border
            Grid.Row="3"
            Style="{StaticResource BandaCardStyle}"
            Padding="0"
            MinHeight="400">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Chips / filtros activos -->
                <Grid
                    Padding="18,14"
                    ColumnSpacing="8">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="AllCategoriesChip"
                        Grid.Column="0"
                        Padding="12,6"
                        CornerRadius="14"
                        Background="{StaticResource BandaAccentSoftBrush}">
                        <TextBlock
                            Text="Todas"
                            Foreground="{StaticResource BandaAccentBrush}"
                            FontSize="13"
                            FontWeight="SemiBold" />
                    </Border>

                    <Border
                        x:Name="ActiveCategoriesChip"
                        Grid.Column="1"
                        Padding="12,6"
                        CornerRadius="14"
                        Background="{StaticResource BandaCardAltBrush}"
                        BorderBrush="{StaticResource BandaBorderBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed">
                        <StackPanel
                            x:Name="ActiveCategoriesVisualPanel"
                            Orientation="Horizontal"
                            Spacing="10"
                            MaxWidth="560" />
                    </Border>

                    <TextBlock
                        x:Name="NoFiltersText"
                        Grid.Column="2"
                        Text="Sin filtros"
                        Foreground="{StaticResource BandaMutedStrongBrush}"
                        FontSize="13"
                        VerticalAlignment="Center"
                        Margin="2,0,0,0" />

                    <Button
                        x:Name="ClearFiltersButton"
                        Grid.Column="3"
                        Content="Limpiar filtros"
                        Click="ClearFiltersButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource BandaMutedBrush}"
                        Padding="10,6"
                        IsEnabled="False" />
                </Grid>

                <!-- Resultados + detalle del archivo seleccionado -->
                <Grid
                    Grid.Row="1"
                    Margin="14,0,14,14"
                    ColumnSpacing="12">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.55*" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>

                    <!-- Lista de resultados -->
                    <Border
                        Grid.Column="0"
                        CornerRadius="14"
                        Background="{StaticResource BandaCardAltBrush}"
                        BorderBrush="{StaticResource BandaBorderBrush}"
                        BorderThickness="1">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="48" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid
                                Padding="16,0"
                                ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.1*" />
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="1.25*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="NOMBRE" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="CATEGORÍA" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="TAMAÑO" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="FECHA" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Grid.Row="1" MinHeight="330">
                                <ListView
                                    x:Name="SearchResultsList"
                                    ItemTemplate="{StaticResource SearchResultTemplate}"
                                    SelectionMode="Extended"
                                    IsMultiSelectCheckBoxEnabled="False"
                                    KeyboardAcceleratorPlacementMode="Hidden"
                                    SelectionChanged="SearchResultsList_SelectionChanged"
                                    Tapped="SearchResultsList_Tapped"
                                    DoubleTapped="SearchResultsList_DoubleTapped"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="8,0,8,8">
                                    <ListView.KeyboardAccelerators>
                                        <KeyboardAccelerator
                                            Key="A"
                                            Modifiers="Control"
                                            Invoked="SearchSelectAllAccelerator_Invoked" />
                                    </ListView.KeyboardAccelerators>

                                    <ListView.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate x:DataType="local:SearchResultGroup">
                                                    <Grid
                                                        Padding="12,12,12,7"
                                                        ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Text="{x:Bind HeaderText}"
                                                            Foreground="{StaticResource BandaTextBrush}"
                                                            FontSize="13"
                                                            FontWeight="SemiBold"
                                                            VerticalAlignment="Center" />
                                                        <Rectangle
                                                            Grid.Column="1"
                                                            Height="1"
                                                            Fill="{StaticResource BandaBorderBrush}"
                                                            VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ListView.GroupStyle>

                                    <ListView.Resources>
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{StaticResource BandaSelectionColor}" />
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{StaticResource BandaSelectionHoverColor}" />
                                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#161F292D" />
                                        <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#F5F8FA" />
                                    </ListView.Resources>

                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,2" />
                                            <Setter Property="CornerRadius" Value="10" />
                                            <Setter Property="MinHeight" Value="54" />
                                        </Style>
                                    </ListView.ItemContainerStyle>

                                </ListView>

                                <StackPanel
                                    x:Name="EmptyStatePanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="10"
                                    Visibility="Collapsed">

                                    <Border
                                        Width="46"
                                        Height="46"
                                        CornerRadius="15"
                                        Background="{StaticResource BandaAccentSoftBrush}">
                                        <TextBlock
                                            Text="⌕"
                                            Foreground="{StaticResource BandaAccentBrush}"
                                            FontSize="22"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock
                                        x:Name="EmptyStateTitle"
                                        Text="No hay elementos que coincidan"
                                        Foreground="{StaticResource BandaTextBrush}"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center" />

                                    <TextBlock
                                        x:Name="EmptyStateDescription"
                                        Text="Probá cambiando las categorías seleccionadas o el texto de búsqueda."
                                        Style="{StaticResource BandaMutedTextStyle}"
                                        FontSize="13"
                                        HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Panel de detalle -->
                    <Border
                        Grid.Column="1"
                        CornerRadius="14"
                        Background="{StaticResource BandaCardAltBrush}"
                        BorderBrush="{StaticResource BandaBorderBrush}"
                        BorderThickness="1"
                        Padding="18">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock
                                    x:Name="SearchDetailTitleText"
                                    Text="Detalle del elemento"
                                    Foreground="{StaticResource BandaTextBrush}"
                                    FontSize="18"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="SearchDetailFileNameText"
                                    Text="Seleccioná un elemento"
                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                    FontSize="13"
                                    TextWrapping="Wrap"
                                    TextTrimming="CharacterEllipsis"
                                    MaxLines="2" />
                            </StackPanel>

                            <Grid
                                Grid.Row="1"
                                Margin="0,16,0,16"
                                ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    x:Name="SearchDetailCategoryCard"
                                    Padding="12"
                                    CornerRadius="12"
                                    Background="{StaticResource BandaNavIconBrush}"
                                    BorderBrush="{StaticResource BandaBorderBrush}"
                                    BorderThickness="1">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="CATEGORÍA" Style="{StaticResource BandaMutedTextStyle}" FontSize="11" />
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="7">
                                            <Ellipse
                                                x:Name="SearchDetailCategoryDot"
                                                Width="9"
                                                Height="9"
                                                Fill="{StaticResource BandaAccentBrush}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                x:Name="SearchDetailCategoryText"
                                                Text="—"
                                                Foreground="{StaticResource BandaAccentBrush}"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Padding="12"
                                    CornerRadius="12"
                                    Background="{StaticResource BandaNavIconBrush}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="TAMAÑO" Style="{StaticResource BandaMutedTextStyle}" FontSize="11" />
                                        <TextBlock
                                            x:Name="SearchDetailSizeText"
                                            Text="—"
                                            Foreground="{StaticResource BandaTextBrush}"
                                            FontSize="14"
                                            FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid
                                Grid.Row="2"
                                RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel
                                    x:Name="SearchDetailMetadataPanel"
                                    Spacing="11">

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
