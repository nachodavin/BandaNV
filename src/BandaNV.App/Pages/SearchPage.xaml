<Page
    x:Class="BandaNV.App.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BandaNV.App.Pages"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="CategoryCardTemplate" x:DataType="local:SearchCategorySummary">
            <Button
                Tag="{x:Bind Name}"
                Click="CategoryCard_Click"
                Height="122"
                Padding="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="18">

                <Border
                    Padding="18"
                    CornerRadius="18"
                    Background="{x:Bind CardBackground}"
                    BorderBrush="{x:Bind CardBorderBrush}"
                    BorderThickness="1">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            Width="9"
                            Height="9"
                            CornerRadius="5"
                            Background="{StaticResource BandaAccentBrush}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Visibility="{x:Bind SelectedVisibility}" />

                        <TextBlock
                            Text="{x:Bind Name}"
                            Foreground="{StaticResource BandaMutedStrongBrush}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1" />

                        <TextBlock
                            Grid.Row="1"
                            Text="{x:Bind ExtensionsText}"
                            Foreground="{StaticResource BandaAccentBrush}"
                            FontSize="13"
                            Margin="0,5,0,0"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1" />

                        <TextBlock
                            Grid.Row="2"
                            Text="{x:Bind CountText}"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="30"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Row="3"
                            Text="archivos"
                            Style="{StaticResource BandaMutedTextStyle}"
                            FontSize="13" />
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="SearchResultTemplate" x:DataType="local:SearchFileResult">
            <Border
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid Padding="16,12" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.4*" />
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind Name}"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind ExtensionDisplay}"
                            Foreground="{StaticResource BandaMutedBrush}"
                            FontSize="11" />
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind Category}"
                        Foreground="{StaticResource BandaMutedStrongBrush}"
                        FontSize="13"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        Grid.Column="2"
                        Text="{x:Bind SizeText}"
                        Foreground="{StaticResource BandaMutedStrongBrush}"
                        FontSize="13"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Grid.Column="3"
                        Text="{x:Bind ModifiedText}"
                        Foreground="{StaticResource BandaMutedStrongBrush}"
                        FontSize="13"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Grid.Column="4"
                        Text="{x:Bind Location}"
                        Foreground="{StaticResource BandaMutedBrush}"
                        FontSize="13"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        Grid.Column="5"
                        Text="···"
                        Foreground="{StaticResource BandaMutedBrush}"
                        FontSize="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid
        Padding="34,32,34,40"
        RowSpacing="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Spacing="5">
            <TextBlock
                Text="Buscar"
                Style="{StaticResource BandaSectionTitleStyle}"
                FontSize="32" />

            <TextBlock
                Text="Encontrá y explorá los archivos organizados por BandaNV."
                Style="{StaticResource BandaMutedTextStyle}"
                FontSize="14" />
        </StackPanel>

        <!-- Carrusel de categorías: 10 por tanda, siempre en orden global -->
        <Grid
            Grid.Row="1"
            RowSpacing="6">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="PreviousCategoriesButton"
                    Grid.Column="0"
                    Click="PreviousCategoriesButton_Click"
                    Width="34"
                    Height="72"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    Background="{StaticResource BandaCardBrush}"
                    BorderBrush="{StaticResource BandaBorderBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    IsEnabled="False">
                    <TextBlock Text="‹" FontSize="26" />
                </Button>

                <Grid
                    x:Name="CategoryCardsGrid"
                    Grid.Column="1"
                    ColumnSpacing="8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />

                <Button
                    x:Name="NextCategoriesButton"
                    Grid.Column="2"
                    Click="NextCategoriesButton_Click"
                    Width="34"
                    Height="72"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    Background="{StaticResource BandaCardBrush}"
                    BorderBrush="{StaticResource BandaBorderBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    IsEnabled="False">
                    <TextBlock Text="›" FontSize="26" />
                </Button>
            </Grid>

            <!-- Indicador por tandas: ● ○ ○ -->
            <StackPanel
                x:Name="CategoryPageDots"
                Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="7"
                Visibility="Collapsed" />
        </Grid>

        <!-- Herramientas de búsqueda -->
        <Grid
            Grid.Row="2"
            ColumnSpacing="12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="SearchBox"
                Grid.Column="0"
                PlaceholderText="Buscar por nombre, extensión o categoría..."
                TextChanged="SearchBox_TextChanged"
                FontSize="14"
                Padding="14,10"
                MinHeight="44" />

            <Border
                Grid.Column="1"
                Padding="14,0"
                CornerRadius="12"
                Background="{StaticResource BandaCardBrush}"
                BorderBrush="{StaticResource BandaBorderBrush}"
                BorderThickness="1"
                VerticalAlignment="Stretch">

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="5"
                    VerticalAlignment="Center">
                    <TextBlock
                        x:Name="SearchResultCountText"
                        Text="0"
                        Foreground="{StaticResource BandaTextBrush}"
                        FontWeight="SemiBold" />
                    <TextBlock
                        Text="archivos"
                        Style="{StaticResource BandaMutedTextStyle}" />
                </StackPanel>
            </Border>

            <Button
                Grid.Column="2"
                Content="Filtros"
                Padding="16,10"
                MinHeight="44"
                CornerRadius="12" />

            <ComboBox
                Grid.Column="3"
                MinWidth="170"
                MinHeight="44"
                PlaceholderText="Ordenar por">
                <ComboBoxItem Content="Nombre" />
                <ComboBoxItem Content="Fecha" />
                <ComboBoxItem Content="Tamaño" />
                <ComboBoxItem Content="Categoría" />
            </ComboBox>
        </Grid>

        <!-- Tabla principal de resultados -->
        <Border
            Grid.Row="3"
            Style="{StaticResource BandaCardStyle}"
            Padding="0"
            MinHeight="400">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Chips / filtros activos -->
                <Grid
                    Padding="18,14"
                    ColumnSpacing="8">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="AllCategoriesChip"
                        Grid.Column="0"
                        Padding="12,6"
                        CornerRadius="14"
                        Background="{StaticResource BandaAccentSoftBrush}">
                        <TextBlock
                            Text="Todas"
                            Foreground="{StaticResource BandaAccentBrush}"
                            FontSize="13"
                            FontWeight="SemiBold" />
                    </Border>

                    <Border
                        x:Name="ActiveCategoriesChip"
                        Grid.Column="1"
                        Padding="12,6"
                        CornerRadius="14"
                        Background="{StaticResource BandaAccentSoftBrush}"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="ActiveCategoriesText"
                            Text=""
                            Foreground="{StaticResource BandaAccentBrush}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            MaxWidth="560"
                            TextTrimming="CharacterEllipsis" />
                    </Border>

                    <TextBlock
                        x:Name="NoFiltersText"
                        Grid.Column="2"
                        Text="Sin filtros"
                        Foreground="{StaticResource BandaMutedStrongBrush}"
                        FontSize="13"
                        VerticalAlignment="Center"
                        Margin="2,0,0,0" />

                    <Button
                        x:Name="ClearFiltersButton"
                        Grid.Column="3"
                        Content="Limpiar filtros"
                        Click="ClearFiltersButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource BandaMutedBrush}"
                        Padding="10,6"
                        IsEnabled="False" />
                </Grid>

                <!-- Encabezado de tabla -->
                <Border
                    Grid.Row="1"
                    Margin="14,0,14,14"
                    CornerRadius="14"
                    Background="{StaticResource BandaCardAltBrush}"
                    BorderBrush="{StaticResource BandaBorderBrush}"
                    BorderThickness="1">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid
                            Padding="16,0"
                            ColumnSpacing="16"
                            VerticalAlignment="Stretch">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.4*" />
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="NOMBRE" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="CATEGORÍA" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="TAMAÑO" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="FECHA" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="UBICACIÓN" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="" />
                        </Grid>

                        <Grid
                            Grid.Row="1"
                            MinHeight="330">

                            <ScrollViewer
                                x:Name="SearchResultsScrollViewer"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl
                                    x:Name="SearchResultsList"
                                    ItemTemplate="{StaticResource SearchResultTemplate}"
                                    HorizontalContentAlignment="Stretch" />
                            </ScrollViewer>

                            <StackPanel
                                x:Name="EmptyStatePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                Visibility="Collapsed">

                                <Border
                                    Width="46"
                                    Height="46"
                                    CornerRadius="15"
                                    Background="{StaticResource BandaAccentSoftBrush}">
                                    <TextBlock
                                        Text="⌕"
                                        Foreground="{StaticResource BandaAccentBrush}"
                                        FontSize="22"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>

                                <TextBlock
                                    x:Name="EmptyStateTitle"
                                    Text="No hay archivos que coincidan"
                                    Foreground="{StaticResource BandaTextBrush}"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center" />

                                <TextBlock
                                    x:Name="EmptyStateDescription"
                                    Text="Probá cambiando las categorías seleccionadas o el texto de búsqueda."
                                    Style="{StaticResource BandaMutedTextStyle}"
                                    FontSize="13"
                                    HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Pie de tabla -->
                <Grid
                    Grid.Row="2"
                    Padding="18,0,18,16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="SearchResultsFooterText"
                        Text="0 resultados"
                        Style="{StaticResource BandaMutedTextStyle}"
                        FontSize="13"
                        VerticalAlignment="Center" />

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button Content="‹" Width="34" Height="32" Padding="0" IsEnabled="False" />
                        <TextBlock Text="1 de 1" Style="{StaticResource BandaMutedTextStyle}" VerticalAlignment="Center" />
                        <Button Content="›" Width="34" Height="32" Padding="0" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
