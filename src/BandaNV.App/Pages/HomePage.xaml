<Page
    x:Class="BandaNV.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BandaBackgroundBrush}">

    <ScrollViewer>
        <Grid
            Padding="48,36,48,56"
            MaxWidth="1680"
            HorizontalAlignment="Stretch">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <StackPanel Spacing="6">
                <TextBlock
                    Text="Inicio"
                    Style="{StaticResource BandaSectionTitleStyle}"
                    FontSize="30" />

                <TextBlock
                    Text="Resumen general de BandaNV."
                    Style="{StaticResource BandaMutedTextStyle}"
                    FontSize="14" />
            </StackPanel>

            <!-- Estado actual -->
            <Border
                Grid.Row="1"
                Style="{StaticResource BandaCardStyle}"
                Margin="0,28,0,0"
                Padding="22,18">

                <Grid ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock
                            Text="CARPETA ACTUAL"
                            Foreground="{StaticResource BandaAccentBrush}"
                            FontSize="11"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Text="Sin carpeta configurada"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="18"
                            FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock
                            Text="ESTADO"
                            Style="{StaticResource BandaMutedTextStyle}"
                            FontSize="11" />

                        <TextBlock
                            Text="Configuración pendiente"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="16"
                            FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="6">
                        <TextBlock
                            Text="ÚLTIMA ORGANIZACIÓN"
                            Style="{StaticResource BandaMutedTextStyle}"
                            FontSize="11" />

                        <TextBlock
                            Text="—"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="16"
                            FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Métricas principales -->
            <Grid
                Grid.Row="2"
                Margin="0,18,0,0"
                ColumnSpacing="14">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource BandaCardStyle}" Padding="22">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="ARCHIVOS PENDIENTES"
                            Style="{StaticResource BandaMutedTextStyle}"
                            FontSize="11" />

                        <TextBlock
                            Text="—"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="38"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Text="Esperando configuración"
                            Style="{StaticResource BandaMutedTextStyle}"
                            FontSize="12" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource BandaCardStyle}" Padding="22">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="ARCHIVOS ORGANIZADOS TOTALES"
                            Style="{StaticResource BandaMutedTextStyle}"
                            FontSize="11" />

                        <TextBlock
                            Text="—"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="38"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Text="Acumulado histórico"
                            Style="{StaticResource BandaMutedTextStyle}"
                            FontSize="12" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource BandaCardStyle}" Padding="22">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="TAMAÑO TOTAL MOVIDO"
                            Style="{StaticResource BandaMutedTextStyle}"
                            FontSize="11" />

                        <TextBlock
                            Text="—"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="38"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Text="Acumulado histórico"
                            Style="{StaticResource BandaMutedTextStyle}"
                            FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Métricas secundarias -->
            <Grid
                Grid.Row="3"
                Margin="0,14,0,0"
                ColumnSpacing="14">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource BandaCardStyle}" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="Categorías activas"
                            Style="{StaticResource BandaMutedTextStyle}"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Column="1"
                            Text="—"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="22"
                            FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource BandaCardStyle}" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="Última ejecución"
                            Style="{StaticResource BandaMutedTextStyle}"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Column="1"
                            Text="— archivos"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="18"
                            FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource BandaCardStyle}" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="Actividad registrada"
                            Style="{StaticResource BandaMutedTextStyle}"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Column="1"
                            Text="—"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="18"
                            FontWeight="SemiBold" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Información histórica -->
            <Grid
                Grid.Row="4"
                Margin="0,18,0,0"
                ColumnSpacing="18">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource BandaCardStyle}" Padding="24">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="Uso por categoría"
                                Foreground="{StaticResource BandaTextBrush}"
                                FontSize="20"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Text="Distribución histórica de los archivos organizados."
                                Style="{StaticResource BandaMutedTextStyle}"
                                FontSize="12" />
                        </StackPanel>

                        <StackPanel Spacing="14">
                            <StackPanel Spacing="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Imágenes" Foreground="{StaticResource BandaTextBrush}" />
                                    <TextBlock Grid.Column="1" Text="—" Style="{StaticResource BandaMutedTextStyle}" />
                                </Grid>
                                <ProgressBar Value="0" Maximum="100" Height="5" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Documentos" Foreground="{StaticResource BandaTextBrush}" />
                                    <TextBlock Grid.Column="1" Text="—" Style="{StaticResource BandaMutedTextStyle}" />
                                </Grid>
                                <ProgressBar Value="0" Maximum="100" Height="5" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Videos" Foreground="{StaticResource BandaTextBrush}" />
                                    <TextBlock Grid.Column="1" Text="—" Style="{StaticResource BandaMutedTextStyle}" />
                                </Grid>
                                <ProgressBar Value="0" Maximum="100" Height="5" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource BandaCardStyle}" Padding="24">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="Actividad reciente"
                                Foreground="{StaticResource BandaTextBrush}"
                                FontSize="20"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Text="Últimos movimientos registrados por BandaNV."
                                Style="{StaticResource BandaMutedTextStyle}"
                                FontSize="12" />
                        </StackPanel>

                        <StackPanel Spacing="12">
                            <TextBlock
                                Text="Todavía no hay actividad cargada en v2.0."
                                Style="{StaticResource BandaMutedTextStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
