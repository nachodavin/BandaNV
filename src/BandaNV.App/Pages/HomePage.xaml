<Page
    x:Class="BandaNV.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid x:Name="PageRoot">
        <ScrollViewer
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalContentAlignment="Stretch"
            VerticalScrollBarVisibility="Auto">

            <Grid HorizontalAlignment="Stretch">
                <Grid
                    Padding="34,32,34,48"
                    HorizontalAlignment="Stretch"
                    RowSpacing="16">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Encabezado -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="5">
                            <TextBlock
                                Text="Inicio"
                                Style="{StaticResource BandaSectionTitleStyle}"
                                FontSize="32" />

                            <TextBlock
                                Text="Resumen general de tu organización."
                                Style="{StaticResource BandaMutedTextStyle}"
                                FontSize="14" />
                        </StackPanel>

                        <Border
                            Grid.Column="1"
                            Padding="12,7"
                            CornerRadius="16"
                            Background="{StaticResource BandaCardAltBrush}"
                            BorderBrush="{StaticResource BandaBorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource BandaAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="BandaNV v2.0" Foreground="{StaticResource BandaMutedStrongBrush}" FontSize="14" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Estado general -->
                    <Border
                        Grid.Row="1"
                        Style="{StaticResource BandaCardStyle}"
                        Padding="24,20">

                        <Grid ColumnSpacing="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock
                                    Text="CARPETA ACTUAL"
                                    Foreground="{StaticResource BandaAccentBrush}"
                                    FontSize="13"
                                    FontWeight="SemiBold" />

                                <TextBlock
                                    x:Name="HomeSourceFolderText"
                                    Text="Cargando..."
                                    Foreground="{StaticResource BandaTextBrush}"
                                    FontSize="19"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind HomeSourceFolderText.Text, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock
                                    Text="ESTADO"
                                    Style="{StaticResource BandaMutedTextStyle}"
                                    FontSize="13" />

                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse x:Name="HomeStatusDot" Width="7" Height="7" Fill="{StaticResource BandaSecondaryAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock
                                        x:Name="HomeStatusText"
                                        Text="Comprobando..."
                                        Foreground="{StaticResource BandaTextBrush}"
                                        FontSize="15"
                                        FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="6">
                                <TextBlock
                                    Text="ÚLTIMA ORGANIZACIÓN"
                                    Style="{StaticResource BandaMutedTextStyle}"
                                    FontSize="13" />

                                <TextBlock
                                    x:Name="HomeLastOrganizationHeaderText"
                                    Text="—"
                                    Foreground="{StaticResource BandaTextBrush}"
                                    FontSize="15"
                                    FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Métricas principales -->
                    <Grid Grid.Row="2" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Style="{StaticResource BandaMetricCardStyle}"
                            Background="{StaticResource BandaAccentCardBrush}"
                            BorderBrush="{StaticResource BandaBorderStrongBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ARCHIVOS PENDIENTES" Foreground="{StaticResource BandaMutedStrongBrush}" FontSize="13" />
                                    <Border Grid.Column="1" Width="34" Height="34" CornerRadius="11" Background="{StaticResource BandaAccentSoftBrush}">
                                        <SymbolIcon Symbol="Folder" Foreground="{StaticResource BandaAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <TextBlock
                                    x:Name="HomePendingFilesText"
                                    Grid.Row="1"
                                    Text="—"
                                    Foreground="{StaticResource BandaTextBrush}"
                                    FontSize="42"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    x:Name="HomePendingDetailText"
                                    Grid.Row="2"
                                    Text="Analizando origen..."
                                    Style="{StaticResource BandaMutedTextStyle}"
                                    FontSize="14" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource BandaMetricCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ARCHIVOS ORGANIZADOS TOTALES" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" />
                                    <Border Grid.Column="1" Width="34" Height="34" CornerRadius="11" Background="{StaticResource BandaNavIconBrush}">
                                        <SymbolIcon Symbol="Accept" Foreground="{StaticResource BandaAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <TextBlock
                                    x:Name="HomeTotalOrganizedText"
                                    Grid.Row="1"
                                    Text="0"
                                    Foreground="{StaticResource BandaTextBrush}"
                                    FontSize="42"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    Grid.Row="2"
                                    Text="Movimientos de Organización"
                                    Style="{StaticResource BandaMutedTextStyle}"
                                    FontSize="14" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource BandaMetricCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="TAMAÑO TOTAL MOVIDO" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" />
                                    <Border Grid.Column="1" Width="34" Height="34" CornerRadius="11" Background="{StaticResource BandaNavIconBrush}">
                                        <SymbolIcon Symbol="Save" Foreground="{StaticResource BandaSecondaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <TextBlock
                                    x:Name="HomeTotalMovedSizeText"
                                    Grid.Row="1"
                                    Text="0 B"
                                    Foreground="{StaticResource BandaTextBrush}"
                                    FontSize="42"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    Grid.Row="2"
                                    Text="Movido por Organización"
                                    Style="{StaticResource BandaMutedTextStyle}"
                                    FontSize="14" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Métricas secundarias -->
                    <Grid Grid.Row="3" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource BandaCardStyle}" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Categorías activas" Style="{StaticResource BandaMutedTextStyle}" />
                                    <TextBlock Text="Configuradas actualmente" Foreground="{StaticResource BandaMutedBrush}" FontSize="13" />
                                </StackPanel>
                                <TextBlock x:Name="HomeCategoriesCountText" Grid.Column="1" Text="0" Foreground="{StaticResource BandaTextBrush}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource BandaCardStyle}" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Organizados última ejecución" Style="{StaticResource BandaMutedTextStyle}" />
                                    <TextBlock Text="Último movimiento completo" Foreground="{StaticResource BandaMutedBrush}" FontSize="13" />
                                </StackPanel>
                                <TextBlock x:Name="HomeLastExecutionFilesText" Grid.Column="1" Text="—" Foreground="{StaticResource BandaTextBrush}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource BandaCardStyle}" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Última organización" Style="{StaticResource BandaMutedTextStyle}" />
                                    <TextBlock Text="Fecha y hora" Foreground="{StaticResource BandaMutedBrush}" FontSize="13" />
                                </StackPanel>
                                <TextBlock x:Name="HomeLastExecutionDateText" Grid.Column="1" Text="—" Foreground="{StaticResource BandaTextBrush}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Zona analítica -->
                    <Grid Grid.Row="4" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource BandaCardStyle}" Padding="24">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Actividad de organización" Foreground="{StaticResource BandaTextBrush}" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Text="Evolución de archivos organizados con el tiempo." Style="{StaticResource BandaMutedTextStyle}" FontSize="14" />
                                    </StackPanel>

                                    <Border Grid.Column="1" Padding="10,5" CornerRadius="14" Background="{StaticResource BandaNavIconBrush}" VerticalAlignment="Top">
                                        <TextBlock Text="Histórico" Foreground="{StaticResource BandaMutedStrongBrush}" FontSize="13" />
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1" MinHeight="210" Margin="0,22,0,0">
                                    <Border
                                        CornerRadius="14"
                                        Background="{StaticResource BandaAccentFaintBrush}"
                                        BorderBrush="{StaticResource BandaBorderBrush}"
                                        BorderThickness="1">

                                        <StackPanel
                                            x:Name="HomeActivityPanel"
                                            Margin="18"
                                            VerticalAlignment="Center"
                                            Spacing="10" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1" RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource BandaCardStyle}" Padding="22">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Uso por categoría" Foreground="{StaticResource BandaTextBrush}" FontSize="19" FontWeight="SemiBold" />
                                        <TextBlock Text="Distribución histórica." Style="{StaticResource BandaMutedTextStyle}" FontSize="14" />
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="HomeCategoryUsagePanel"
                                        Spacing="11" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource BandaCardStyle}" Padding="22">
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Actividad reciente" Foreground="{StaticResource BandaTextBrush}" FontSize="19" FontWeight="SemiBold" />
                                        <TextBlock Text="Últimos movimientos registrados." Style="{StaticResource BandaMutedTextStyle}" FontSize="14" />
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="HomeRecentActivityPanel"
                                        MinHeight="92"
                                        Spacing="8" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
