<Page
    x:Class="BandaNV.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Page.Resources>
        <SolidColorBrush x:Key="HomeWarningBrush" Color="#F2B85B" />
        <SolidColorBrush x:Key="HomeWarningSoftBrush" Color="#24F2B85B" />

        <Style x:Key="HomeMetricIconBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{StaticResource BandaNavIconBrush}" />
        </Style>
    </Page.Resources>

    <Grid x:Name="PageRoot">
        <ScrollViewer
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalContentAlignment="Stretch"
            VerticalScrollBarVisibility="Auto">

            <Grid HorizontalAlignment="Stretch">
                <Grid
                    Padding="34,32,34,48"
                    HorizontalAlignment="Stretch"
                    RowSpacing="16">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Encabezado -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="5">
                            <TextBlock
                                Text="Inicio"
                                Style="{StaticResource BandaSectionTitleStyle}"
                                FontSize="32" />

                            <TextBlock
                                Text="Resumen general de tu organización."
                                Style="{StaticResource BandaMutedTextStyle}"
                                FontSize="14" />
                        </StackPanel>

                        <Border
                            Grid.Column="1"
                            Padding="12,7"
                            CornerRadius="16"
                            Background="{StaticResource BandaCardAltBrush}"
                            BorderBrush="{StaticResource BandaBorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource BandaAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="BandaNV v2.0" Foreground="{StaticResource BandaMutedStrongBrush}" FontSize="14" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Estado general: se mantiene igual -->
                    <Border
                        Grid.Row="1"
                        Style="{StaticResource BandaCardStyle}"
                        Padding="24,20">

                        <Grid ColumnSpacing="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock
                                    Text="CARPETA ACTUAL"
                                    Foreground="{StaticResource BandaAccentBrush}"
                                    FontSize="13"
                                    FontWeight="SemiBold" />

                                <TextBlock
                                    x:Name="HomeSourceFolderText"
                                    Text="Cargando..."
                                    Foreground="{StaticResource BandaTextBrush}"
                                    FontSize="19"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock
                                    Text="ESTADO"
                                    Style="{StaticResource BandaMutedTextStyle}"
                                    FontSize="13" />

                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse
                                        x:Name="HomeStatusDot"
                                        Width="7"
                                        Height="7"
                                        Fill="{StaticResource BandaSecondaryAccentBrush}"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        x:Name="HomeStatusText"
                                        Text="Comprobando..."
                                        Foreground="{StaticResource BandaTextBrush}"
                                        FontSize="15"
                                        FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="6">
                                <TextBlock
                                    Text="ÚLTIMA ORGANIZACIÓN"
                                    Style="{StaticResource BandaMutedTextStyle}"
                                    FontSize="13" />

                                <TextBlock
                                    x:Name="HomeLastOrganizationHeaderText"
                                    Text="—"
                                    Foreground="{StaticResource BandaTextBrush}"
                                    FontSize="15"
                                    FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Tres métricas útiles -->
                    <Grid Grid.Row="2" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Style="{StaticResource BandaMetricCardStyle}"
                            Background="{StaticResource BandaAccentCardBrush}"
                            BorderBrush="{StaticResource BandaBorderStrongBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="ARCHIVOS PENDIENTES"
                                        Foreground="{StaticResource BandaMutedStrongBrush}"
                                        FontSize="13" />
                                    <Border
                                        Grid.Column="1"
                                        Style="{StaticResource HomeMetricIconBadgeStyle}">
                                        <SymbolIcon
                                            Symbol="Folder"
                                            Foreground="{StaticResource BandaAccentBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <TextBlock
                                    x:Name="HomePendingFilesText"
                                    Grid.Row="1"
                                    Text="—"
                                    Foreground="{StaticResource BandaTextBrush}"
                                    FontSize="42"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    x:Name="HomePendingDetailText"
                                    Grid.Row="2"
                                    Text="Analizando origen..."
                                    Style="{StaticResource BandaMutedTextStyle}"
                                    FontSize="14" />
                            </Grid>
                        </Border>

                        <Border
                            x:Name="HomeUnassignedCard"
                            Grid.Column="1"
                            Style="{StaticResource BandaMetricCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="HomeUnassignedTitleText"
                                        Text="ARCHIVOS SIN ASIGNAR"
                                        Foreground="{StaticResource BandaMutedStrongBrush}"
                                        FontSize="13" />
                                    <Border
                                        x:Name="HomeUnassignedIconBorder"
                                        Grid.Column="1"
                                        Style="{StaticResource HomeMetricIconBadgeStyle}">
                                        <TextBlock
                                            x:Name="HomeUnassignedIconText"
                                            Text="?"
                                            Foreground="{StaticResource BandaAccentBrush}"
                                            FontSize="17"
                                            FontWeight="SemiBold"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <TextBlock
                                    x:Name="HomeUnassignedFilesText"
                                    Grid.Row="1"
                                    Text="—"
                                    Foreground="{StaticResource BandaTextBrush}"
                                    FontSize="42"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    x:Name="HomeUnassignedDetailText"
                                    Grid.Row="2"
                                    Text="Sin analizar"
                                    Style="{StaticResource BandaMutedTextStyle}"
                                    FontSize="14" />
                            </Grid>
                        </Border>

                        <Border
                            Grid.Column="2"
                            Style="{StaticResource BandaMetricCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="TOTAL EJECUCIONES"
                                        Style="{StaticResource BandaMutedTextStyle}"
                                        FontSize="13" />
                                    <Border
                                        Grid.Column="1"
                                        Style="{StaticResource HomeMetricIconBadgeStyle}">
                                        <SymbolIcon
                                            Symbol="Clock"
                                            Foreground="{StaticResource BandaSecondaryAccentBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <TextBlock
                                    x:Name="HomeTotalExecutionsText"
                                    Grid.Row="1"
                                    Text="0"
                                    Foreground="{StaticResource BandaTextBrush}"
                                    FontSize="42"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    x:Name="HomeTotalExecutionsDetailText"
                                    Grid.Row="2"
                                    Text="Acciones de organizar registradas"
                                    Style="{StaticResource BandaMutedTextStyle}"
                                    FontSize="14" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Estado actual de la biblioteca organizada -->
                    <Grid Grid.Row="3" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.45*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Dona interactiva -->
                        <Border
                            Grid.Column="0"
                            Style="{StaticResource BandaCardStyle}"
                            Padding="24">
                            <Grid RowSpacing="18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Text="Uso por categoría"
                                        Foreground="{StaticResource BandaTextBrush}"
                                        FontSize="20"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="Distribución actual según la cantidad de archivos organizados."
                                        Style="{StaticResource BandaMutedTextStyle}"
                                        FontSize="14" />
                                </StackPanel>

                                <Grid
                                    Grid.Row="1"
                                    MinHeight="620"
                                    ColumnSpacing="34">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="590" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid
                                        Width="550"
                                        Height="550"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <Ellipse
                                            Width="430"
                                            Height="430"
                                            Stroke="{StaticResource BandaBorderStrongBrush}"
                                            StrokeThickness="56"
                                            Opacity="0.55"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />

                                        <Canvas
                                            x:Name="HomeDonutCanvas"
                                            Width="550"
                                            Height="550"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />

                                        <StackPanel
                                            Width="286"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="5">
                                            <TextBlock
                                                x:Name="HomeDonutCenterCategoryText"
                                                Text="TODAS LAS CATEGORÍAS"
                                                Foreground="{StaticResource BandaMutedStrongBrush}"
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                x:Name="HomeDonutCenterCountText"
                                                Text="0"
                                                Foreground="{StaticResource BandaTextBrush}"
                                                FontSize="58"
                                                FontWeight="SemiBold"
                                                TextAlignment="Center" />

                                            <TextBlock
                                                x:Name="HomeDonutCenterFilesLabelText"
                                                Text="Archivos organizados"
                                                Foreground="{StaticResource BandaMutedBrush}"
                                                FontSize="16"
                                                TextAlignment="Center" />

                                            <TextBlock
                                                x:Name="HomeDonutCenterSizeText"
                                                Text=""
                                                Foreground="{StaticResource BandaMutedStrongBrush}"
                                                FontSize="14"
                                                TextAlignment="Center"
                                                Visibility="Collapsed"
                                                Margin="0,5,0,0" />

                                            <TextBlock
                                                x:Name="HomeDonutCenterUsageText"
                                                Text=""
                                                Foreground="{StaticResource BandaAccentBrush}"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                TextAlignment="Center"
                                                Visibility="Collapsed" />
                                        </StackPanel>
                                    </Grid>

                                    <ScrollViewer
                                        Grid.Column="1"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalAlignment="Center">
                                        <StackPanel
                                            x:Name="HomeDonutLegendPanel"
                                            Margin="0,4,10,4"
                                            Spacing="7"
                                            HorizontalAlignment="Left" />
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Métricas del gráfico -->
                        <Grid
                            Grid.Column="1"
                            RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Style="{StaticResource BandaMetricCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        Text="TAMAÑO TOTAL"
                                        Style="{StaticResource BandaMutedTextStyle}"
                                        FontSize="13" />
                                    <TextBlock
                                        x:Name="HomeCurrentTotalSizeText"
                                        Text="0 B"
                                        Foreground="{StaticResource BandaTextBrush}"
                                        FontSize="40"
                                        FontWeight="SemiBold"
                                        Margin="0,20,0,0" />
                                    <TextBlock
                                        Text="Espacio ocupado actualmente"
                                        Style="{StaticResource BandaMutedTextStyle}"
                                        FontSize="13" />
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Row="1"
                                Style="{StaticResource BandaMetricCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        Text="ARCHIVOS ORGANIZADOS"
                                        Style="{StaticResource BandaMutedTextStyle}"
                                        FontSize="13" />
                                    <TextBlock
                                        x:Name="HomeCurrentOrganizedFilesText"
                                        Text="0"
                                        Foreground="{StaticResource BandaTextBrush}"
                                        FontSize="40"
                                        FontWeight="SemiBold"
                                        Margin="0,20,0,0" />
                                    <TextBlock
                                        Text="Archivos actualmente organizados"
                                        Style="{StaticResource BandaMutedTextStyle}"
                                        FontSize="13" />
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Row="2"
                                Style="{StaticResource BandaMetricCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        Text="CATEGORÍAS EN USO"
                                        Style="{StaticResource BandaMutedTextStyle}"
                                        FontSize="13" />
                                    <TextBlock
                                        x:Name="HomeCategoriesInUseText"
                                        Text="0 / 0"
                                        Foreground="{StaticResource BandaTextBrush}"
                                        FontSize="40"
                                        FontWeight="SemiBold"
                                        Margin="0,20,0,0" />
                                    <TextBlock
                                        Text="Categorías con archivos"
                                        Style="{StaticResource BandaMutedTextStyle}"
                                        FontSize="13" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>