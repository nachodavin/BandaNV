<Page
    x:Class="BandaNV.App.Pages.CategoriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BandaBackgroundBrush}">

    <Grid Padding="40,32,40,48">
        <StackPanel Spacing="18">
            <StackPanel Spacing="6">
                <TextBlock Text="Categorías" Style="{StaticResource BandaSectionTitleStyle}" />
                <TextBlock Text="Administrá nombres, orden y extensiones sin esconderlas dentro de Configuración." Style="{StaticResource BandaMutedTextStyle}" />
            </StackPanel>

            <Border Style="{StaticResource BandaCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Categorías de BandaNV" Foreground="{StaticResource BandaTextBrush}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="La siguiente etapa conecta las categorías actuales de v1.0 y permite editarlas desde esta sección." Style="{StaticResource BandaMutedTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
