<Page
    x:Class="BandaNV.App.Pages.CategoriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BandaNV.App.Pages"
    Background="Transparent">

    <Page.Resources>
        <SolidColorBrush x:Key="CategoriesWarningBrush" Color="#F2B85B" />
        <SolidColorBrush x:Key="CategoriesWarningSoftBrush" Color="#24F2B85B" />
    </Page.Resources>

    <Grid>
        <Grid
            Padding="34,32,34,40"
            RowSpacing="16">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <StackPanel Spacing="5">
                <TextBlock
                    Text="Categorías"
                    Style="{StaticResource BandaSectionTitleStyle}"
                    FontSize="32" />
                <TextBlock
                    Text="Administrá cómo BandaNV clasifica y organiza tus archivos."
                    Style="{StaticResource BandaMutedTextStyle}"
                    FontSize="14" />
            </StackPanel>

            <!-- Métricas -->
            <Grid
                Grid.Row="1"
                ColumnSpacing="12">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource BandaCardStyle}" Padding="18" MinHeight="104">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="TOTAL CATEGORÍAS" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" />
                        <TextBlock
                            x:Name="TotalCategoriesText"
                            Grid.Row="1"
                            Text="0"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="30"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Text="Reglas activas" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource BandaCardStyle}" Padding="18" MinHeight="104">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="EXTENSIONES ASIGNADAS" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" />
                        <TextBlock
                            x:Name="TotalExtensionsText"
                            Grid.Row="1"
                            Text="0"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="30"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Text="Clasificadas" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource BandaCardStyle}" Padding="18" MinHeight="104">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="ARCHIVOS ORGANIZADOS" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" />
                        <TextBlock
                            x:Name="TotalCategoryFilesText"
                            Grid.Row="1"
                            Text="0"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="30"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Text="En estas categorías" Style="{StaticResource BandaMutedTextStyle}" FontSize="13" />
                    </Grid>
                </Border>

                <Border
                    x:Name="CategoriesUnassignedCard"
                    Grid.Column="3"
                    Style="{StaticResource BandaCardStyle}"
                    Padding="18"
                    MinHeight="104">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                x:Name="CategoriesUnassignedTitleText"
                                Text="ARCHIVOS SIN ASIGNAR"
                                Foreground="{StaticResource BandaMutedStrongBrush}"
                                FontSize="13" />

                            <Border
                                x:Name="CategoriesUnassignedIconBorder"
                                Grid.Column="1"
                                Width="30"
                                Height="30"
                                CornerRadius="10"
                                Background="{StaticResource BandaNavIconBrush}">
                                <TextBlock
                                    x:Name="CategoriesUnassignedIconText"
                                    Text="?"
                                    Foreground="{StaticResource BandaAccentBrush}"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <TextBlock
                            x:Name="UnassignedFilesText"
                            Grid.Row="1"
                            Text="—"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="30"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />

                        <TextBlock
                            x:Name="CategoriesUnassignedDetailText"
                            Grid.Row="2"
                            Text="Analizando origen..."
                            Foreground="{StaticResource BandaMutedBrush}"
                            FontSize="13" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Herramientas -->
            <Grid
                Grid.Row="2"
                ColumnSpacing="12">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="CategorySearchBox"
                    Grid.Column="0"
                    PlaceholderText="Buscar categoría o extensión..."
                    TextChanged="CategorySearchBox_TextChanged"
                    FontSize="14"
                    Padding="14,10"
                    MinHeight="44" />

                <Button
                    x:Name="NewCategoryButton"
                    Grid.Column="1"
                    Content="+ Nueva categoría"
                    Click="NewCategoryButton_Click"
                    Style="{StaticResource BandaPopupPrimaryButtonStyle}"
                    MinHeight="44"
                    MinWidth="160">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource BandaActionBaseColor}" />
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource BandaActionHoverColor}" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource BandaActionPressedColor}" />
                                <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource BandaActionForegroundColor}" />
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource BandaActionForegroundColor}" />
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource BandaActionForegroundColor}" />
                                <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource BandaActionBaseColor}" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource BandaActionHoverColor}" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource BandaActionPressedColor}" />
                            </Button.Resources>
                        </Button>
            </Grid>

            <!-- Grid visual de categorías -->
            <Grid
                Grid.Row="3"
                RowSpacing="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid MinHeight="430">
                    <GridView
                        x:Name="CategoryList"
                        ItemsSource="{x:Bind VisibleCategories, Mode=OneWay}"
                        SelectionMode="None"
                        CanDragItems="False"
                        CanReorderItems="False"
                        AllowDrop="False"
                        SizeChanged="CategoryList_SizeChanged"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Padding="0">

                        <GridView.Resources>
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#F5F8FA" />
                        </GridView.Resources>

                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>

                        <!-- El reordenamiento usa animación propia; evitamos el
                             refresh/fade automático del GridView al mover items. -->
                        <GridView.ItemContainerTransitions>
                            <TransitionCollection />
                        </GridView.ItemContainerTransitions>

                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,12,12" />
                                <Setter Property="MinHeight" Value="188" />
                            </Style>
                        </GridView.ItemContainerStyle>

                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:CategoryAdminItem">
                                <Border
                                    Tag="{x:Bind Id}"
                                    MinHeight="188"
                                    Padding="20,20,20,18"
                                    CornerRadius="18"
                                    Background="{x:Bind ColorSoftBrush}"
                                    BorderBrush="{x:Bind ColorBrush}"
                                    BorderThickness="1"
                                    PointerPressed="CategoryCard_PointerPressed"
                                    PointerMoved="CategoryCard_PointerMoved"
                                    PointerReleased="CategoryCard_PointerReleased"
                                    PointerCanceled="CategoryCard_PointerCanceled"
                                    PointerCaptureLost="CategoryCard_PointerCaptureLost">

                                    <Grid RowSpacing="7">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid ColumnSpacing="9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Text="{x:Bind OrderText, Mode=OneWay}"
                                                Foreground="{x:Bind ColorBrush}"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="Arrastrá la card para cambiar el orden" />

                                            <Ellipse
                                                Grid.Column="1"
                                                Width="9"
                                                Height="9"
                                                Fill="{x:Bind ColorBrush}"
                                                VerticalAlignment="Center" />

                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{x:Bind Name}"
                                                Foreground="{StaticResource BandaMutedStrongBrush}"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                VerticalAlignment="Center"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="1" />

                                            <Button
                                                Grid.Column="3"
                                                Tag="{x:Bind Id}"
                                                Content="⋯"
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                Margin="4,-6,-6,0"
                                                CornerRadius="9"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{x:Bind ColorBrush}"
                                                FontSize="16"
                                                VerticalAlignment="Top"
                                                ToolTipService.ToolTip="Más acciones">

                                                <Button.Flyout>
                                                    <Flyout
                                                        Placement="BottomEdgeAlignedRight"
                                                        FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                                                        <Border
                                                            Width="230"
                                                            Padding="8"
                                                            CornerRadius="14"
                                                            Background="{StaticResource BandaPopupSurfaceBrush}"
                                                            BorderBrush="{StaticResource BandaBorderStrongBrush}"
                                                            BorderThickness="1">
                                                            <StackPanel Spacing="2">
                                                                <Button
                                                                    Tag="{x:Bind Id}"
                                                                    Content="Editar categoría"
                                                                    Click="EditCategoryButton_Click"
                                                                    Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                                <Button
                                                                    Tag="{x:Bind Id}"
                                                                    Content="Gestionar extensiones"
                                                                    Click="ManageExtensionsButton_Click"
                                                                    Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                                <Button
                                                                    Tag="{x:Bind Id}"
                                                                    Content="Duplicar categoría"
                                                                    Click="DuplicateCategoryButton_Click"
                                                                    Style="{StaticResource BandaPopupOptionButtonStyle}" />
                                                                <Border
                                                                    Height="1"
                                                                    Margin="6,4"
                                                                    Background="{StaticResource BandaBorderBrush}" />
                                                                <Button
                                                                    Tag="{x:Bind Id}"
                                                                    Content="Eliminar categoría"
                                                                    Click="DeleteCategoryButton_Click"
                                                                    Style="{StaticResource BandaPopupOptionButtonStyle}"
                                                                    Foreground="{StaticResource BandaDangerBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>

                                        <TextBlock
                                            Grid.Row="1"
                                            Text="{x:Bind ExtensionsDisplayText}"
                                            Foreground="{x:Bind ColorBrush}"
                                            FontSize="13"
                                            Margin="0,10,0,0"
                                            TextTrimming="CharacterEllipsis"
                                            MaxLines="1" />

                                        <TextBlock
                                            Grid.Row="2"
                                            Text="{x:Bind FileCountText}"
                                            Foreground="{StaticResource BandaTextBrush}"
                                            FontSize="32"
                                            FontWeight="SemiBold"
                                            Margin="0,12,0,0"
                                            VerticalAlignment="Center" />

                                        <TextBlock
                                            Grid.Row="3"
                                            Text="Archivos"
                                            Style="{StaticResource BandaMutedTextStyle}"
                                            FontSize="13"
                                            Margin="0,4,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- Hueco visual de destino: las demás cards se reacomodan alrededor. -->
                    <Canvas
                        x:Name="CategoryDragVisualLayer"
                        Canvas.ZIndex="20"
                        IsHitTestVisible="False">

                        <Border
                            x:Name="CategoryDropPlaceholder"
                            Visibility="Collapsed"
                            CornerRadius="18"
                            BorderThickness="2"
                            Opacity="0.42" />
                    </Canvas>

                    <StackPanel
                        x:Name="CategoriesEmptyStatePanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="Collapsed">
                        <TextBlock
                            Text="No hay categorías que coincidan"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="15"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="Probá cambiando el texto de búsqueda."
                            Style="{StaticResource BandaMutedTextStyle}"
                            FontSize="13"
                            HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid
                    Grid.Row="1"
                    ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="CategoryFooterCountText"
                        Text="0 categorías"
                        Style="{StaticResource BandaMutedTextStyle}"
                        FontSize="13"
                        VerticalAlignment="Center" />

                    <TextBlock
                        x:Name="CategoryStatusText"
                        Grid.Column="1"
                        Text="Arrastrá las cards para cambiar el orden global."
                        Foreground="{StaticResource BandaMutedBrush}"
                        FontSize="12"
                        TextAlignment="Right"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Editor de categoría -->
        <Grid
            x:Name="CategoryEditorOverlay"
            Canvas.ZIndex="100"
            Visibility="Collapsed">

            <Border
                Background="{StaticResource BandaPopupBackdropBrush}"
                Tapped="CategoryEditorBackdrop_Tapped" />

            <Border
                Width="620"
                Style="{StaticResource BandaPopupCardStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <Grid RowSpacing="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="46"
                            Height="46"
                            CornerRadius="14"
                            Background="{StaticResource BandaAccentSoftBrush}">
                            <TextBlock
                                x:Name="CategoryEditorIconText"
                                Text="+"
                                Foreground="{StaticResource BandaAccentBrush}"
                                FontSize="20"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="CategoryEditorTitleText"
                                Text="Nueva categoría"
                                Foreground="{StaticResource BandaTextBrush}"
                                FontSize="22"
                                FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="CategoryEditorSubtitleText"
                                Text="Definí el nombre y las extensiones que va a reconocer BandaNV."
                                Foreground="{StaticResource BandaMutedBrush}"
                                FontSize="13"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            Content="×"
                            Click="CloseCategoryEditorButton_Click"
                            Style="{StaticResource BandaPopupCloseButtonStyle}"
                            VerticalAlignment="Top">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Escape" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Padding="16"
                        CornerRadius="16"
                        Background="{StaticResource BandaCardBrush}"
                        BorderBrush="{StaticResource BandaBorderBrush}"
                        BorderThickness="1">

                        <StackPanel Spacing="16">
                            <StackPanel Spacing="7">
                                <TextBlock Text="NOMBRE" Style="{StaticResource BandaLabelTextStyle}" FontSize="11" />
                                <TextBox
                                    x:Name="CategoryEditorNameTextBox"
                                    PlaceholderText="Ej. IMAGES"
                                    Background="{StaticResource BandaPopupSurfaceBrush}"
                                    BorderBrush="{StaticResource BandaBorderBrush}"
                                    BorderThickness="1" />
                            </StackPanel>

                            <StackPanel
                                x:Name="CategoryEditorColorSection"
                                Spacing="7">
                                <TextBlock
                                    Text="COLOR DE CATEGORÍA"
                                    Style="{StaticResource BandaLabelTextStyle}"
                                    FontSize="11" />

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        x:Name="CategoryEditorColorPreview"
                                        Width="38"
                                        Height="38"
                                        CornerRadius="11"
                                        BorderBrush="{StaticResource BandaBorderStrongBrush}"
                                        BorderThickness="1" />

                                    <TextBlock
                                        x:Name="CategoryEditorColorHexText"
                                        Grid.Column="1"
                                        Text="#4FE0C6"
                                        Foreground="{StaticResource BandaTextBrush}"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center" />

                                    <Button
                                        Grid.Column="2"
                                        Content="Cambiar"
                                        Style="{StaticResource BandaPopupSecondaryButtonStyle}">
                                        <Button.Flyout>
                                            <Flyout
                                                Placement="BottomEdgeAlignedLeft"
                                                FlyoutPresenterStyle="{StaticResource BandaPopupFlyoutPresenterStyle}">
                                                <Border
                                                    Style="{StaticResource BandaPopupCardStyle}"
                                                    Width="360"
                                                    Padding="20">
                                                    <StackPanel Spacing="12">
                                                        <TextBlock
                                                            Text="Elegir color"
                                                            Foreground="{StaticResource BandaTextBrush}"
                                                            FontSize="17"
                                                            FontWeight="SemiBold" />
                                                        <TextBlock
                                                            Text="Este color identifica la categoría en toda la app."
                                                            Foreground="{StaticResource BandaMutedBrush}"
                                                            FontSize="12"
                                                            TextWrapping="Wrap" />
                                                        <ColorPicker
                                                            x:Name="CategoryColorPicker"
                                                            IsAlphaEnabled="False"
                                                            ColorChanged="CategoryColorPicker_ColorChanged" />
                                                    </StackPanel>
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel
                                x:Name="CategoryEditorFolderSection"
                                Spacing="7"
                                Visibility="Collapsed">
                                <TextBlock
                                    Text="CARPETA RESULTANTE"
                                    Style="{StaticResource BandaLabelTextStyle}"
                                    FontSize="11" />
                                <Border
                                    Padding="11,9"
                                    CornerRadius="11"
                                    Background="{StaticResource BandaPopupSurfaceBrush}"
                                    BorderBrush="{StaticResource BandaBorderBrush}"
                                    BorderThickness="1">
                                    <TextBlock
                                        x:Name="CategoryEditorFolderText"
                                        Text=""
                                        Foreground="{StaticResource BandaMutedStrongBrush}"
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="2" />
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="7">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="EXTENSIONES" Style="{StaticResource BandaLabelTextStyle}" FontSize="11" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="Se guardan automáticamente en minúscula."
                                        Style="{StaticResource BandaMutedTextStyle}"
                                        FontSize="11"
                                        HorizontalAlignment="Right" />
                                </Grid>

                                <Border
                                    Padding="10"
                                    CornerRadius="12"
                                    Background="{StaticResource BandaPopupSurfaceBrush}"
                                    BorderBrush="{StaticResource BandaBorderBrush}"
                                    BorderThickness="1">
                                    <ScrollViewer
                                        HorizontalScrollMode="Auto"
                                        HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollMode="Disabled"
                                        VerticalScrollBarVisibility="Disabled">
                                        <StackPanel
                                            x:Name="CategoryEditorExtensionsPanel"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            MinHeight="34" />
                                    </ScrollViewer>
                                </Border>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox
                                        x:Name="CategoryExtensionInputTextBox"
                                        PlaceholderText=".ext o ext"
                                        Background="{StaticResource BandaPopupSurfaceBrush}"
                                        BorderBrush="{StaticResource BandaBorderBrush}"
                                        BorderThickness="1" />

                                    <Button
                                        Grid.Column="1"
                                        Content="Agregar"
                                        Click="AddCategoryExtensionButton_Click"
                                        Style="{StaticResource BandaPopupSecondaryButtonStyle}" />
                                </Grid>
                            </StackPanel>

                            <TextBlock
                                x:Name="CategoryEditorValidationText"
                                Text=""
                                Foreground="{StaticResource BandaDangerBrush}"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="1"
                            Content="Cancelar"
                            Click="CloseCategoryEditorButton_Click"
                            Style="{StaticResource BandaPopupSecondaryButtonStyle}" />

                        <Button
                            x:Name="SaveCategoryEditorButton"
                            Grid.Column="2"
                            Content="Guardar categoría"
                            Click="SaveCategoryEditorButton_Click"
                            Style="{StaticResource BandaPopupPrimaryButtonStyle}">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Enter" />
                            </Button.KeyboardAccelerators>
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource BandaActionBaseColor}" />
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource BandaActionHoverColor}" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource BandaActionPressedColor}" />
                                <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource BandaActionForegroundColor}" />
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource BandaActionForegroundColor}" />
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource BandaActionForegroundColor}" />
                                <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource BandaActionBaseColor}" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource BandaActionHoverColor}" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource BandaActionPressedColor}" />
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Confirmación de eliminación -->
        <Grid
            x:Name="DeleteCategoryOverlay"
            Canvas.ZIndex="110"
            Visibility="Collapsed">

            <Border
                Background="{StaticResource BandaPopupBackdropBrush}"
                Tapped="DeleteCategoryBackdrop_Tapped" />

            <Border
                Width="560"
                Style="{StaticResource BandaPopupCardStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <Grid RowSpacing="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="46"
                            Height="46"
                            CornerRadius="14"
                            Background="{StaticResource BandaDangerSoftBrush}">
                            <TextBlock
                                Text="!"
                                Foreground="{StaticResource BandaDangerBrush}"
                                FontSize="20"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock
                                Text="Eliminar categoría"
                                Foreground="{StaticResource BandaTextBrush}"
                                FontSize="22"
                                FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="DeleteCategorySubtitleText"
                                Text=""
                                Foreground="{StaticResource BandaMutedBrush}"
                                FontSize="13"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            Content="×"
                            Click="CloseDeleteCategoryButton_Click"
                            Style="{StaticResource BandaPopupCloseButtonStyle}"
                            VerticalAlignment="Top">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Escape" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Padding="16"
                        CornerRadius="16"
                        Background="{StaticResource BandaCardBrush}"
                        BorderBrush="{StaticResource BandaBorderBrush}"
                        BorderThickness="1">
                        <TextBlock
                            x:Name="DeleteCategoryBodyText"
                            Text=""
                            Foreground="{StaticResource BandaMutedStrongBrush}"
                            FontSize="13"
                            TextWrapping="Wrap" />
                    </Border>

                    <Grid Grid.Row="2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="1"
                            Content="Cancelar"
                            Click="CloseDeleteCategoryButton_Click"
                            Style="{StaticResource BandaPopupSecondaryButtonStyle}" />

                        <Button
                            Grid.Column="2"
                            Content="Eliminar categoría"
                            Click="ConfirmDeleteCategoryButton_Click"
                            Style="{StaticResource BandaPopupDangerButtonStyle}">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Enter" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>