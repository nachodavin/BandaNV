<Window
    x:Class="BandaNV.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Grid
        x:Name="RootLayout"
        Background="{StaticResource BandaBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="226" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar propio de BandaNV -->
        <Border
            Grid.Column="0"
            Background="{StaticResource BandaSidebarBrush}"
            BorderBrush="{StaticResource BandaBorderBrush}"
            BorderThickness="0,0,1,0">

            <Grid Padding="16,18,16,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="4,2,4,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="38"
                        Height="38"
                        CornerRadius="12"
                        Background="{StaticResource BandaAccentSoftBrush}">
                        <TextBlock
                            Text="B"
                            Foreground="{StaticResource BandaAccentBrush}"
                            FontSize="18"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
                        <TextBlock
                            Text="BandaNV"
                            Foreground="{StaticResource BandaTextBrush}"
                            FontSize="18"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="v2.0.1"
                            Foreground="{StaticResource BandaAccentBrush}"
                            FontSize="12"
                            FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1">
                    <Button
                        x:Name="HomeButton"
                        Tag="home"
                        Click="NavigationButton_Click"
                        Style="{StaticResource BandaNavButtonStyle}"
                        Background="{StaticResource BandaNavActiveBrush}"
                        Foreground="{StaticResource BandaTextBrush}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource BandaNavIconBrush}">
                                <SymbolIcon Symbol="Home" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Inicio" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button
                        x:Name="OrganizeButton"
                        Tag="organize"
                        Click="NavigationButton_Click"
                        Style="{StaticResource BandaNavButtonStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource BandaNavIconBrush}">
                                <SymbolIcon Symbol="Play" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Organizar" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button
                        x:Name="SearchButton"
                        Tag="search"
                        Click="NavigationButton_Click"
                        Style="{StaticResource BandaNavButtonStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource BandaNavIconBrush}">
                                <SymbolIcon Symbol="Find" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Buscar" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button
                        x:Name="HistoryButton"
                        Tag="history"
                        Click="NavigationButton_Click"
                        Style="{StaticResource BandaNavButtonStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource BandaNavIconBrush}">
                                <SymbolIcon Symbol="Clock" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Historial" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button
                        x:Name="CategoriesButton"
                        Tag="categories"
                        Click="NavigationButton_Click"
                        Style="{StaticResource BandaNavButtonStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource BandaNavIconBrush}">
                                <SymbolIcon Symbol="List" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Categorías" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <!-- Estado rápido del actualizador. Solo aparece cuando
                         GitHub Releases informa una versión estable más nueva. -->
                    <Button
                        x:Name="QuickUpdateButton"
                        Click="QuickUpdateButton_Click"
                        Visibility="Collapsed"
                        Margin="0,0,0,10"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="14">

                        <Border
                            Padding="12,11"
                            CornerRadius="14"
                            Background="{StaticResource BandaAccentFaintBrush}"
                            BorderBrush="{StaticResource BandaBorderStrongBrush}"
                            BorderThickness="1">

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="30"
                                    Height="30"
                                    CornerRadius="10"
                                    Background="{StaticResource BandaAccentSoftBrush}">
                                    <TextBlock
                                        Text="↻"
                                        Foreground="{StaticResource BandaAccentBrush}"
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="QuickUpdateTitle"
                                        Text="Nueva versión"
                                        Foreground="{StaticResource BandaTextBrush}"
                                        FontSize="12"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        x:Name="QuickUpdateSubtitle"
                                        Text="Disponible: v2.0.1"
                                        Foreground="{StaticResource BandaMutedBrush}"
                                        FontSize="11" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="›"
                                    Foreground="{StaticResource BandaAccentBrush}"
                                    FontSize="20"
                                    VerticalAlignment="Center"
                                    Margin="4,0,0,0" />
                            </Grid>
                        </Border>
                    </Button>

                    <Button
                        x:Name="SettingsButton"
                        Tag="settings"
                        Click="NavigationButton_Click"
                        Style="{StaticResource BandaNavButtonStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource BandaNavIconBrush}">
                                <SymbolIcon Symbol="Setting" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Configuración" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Fondo tonal plano: la profundidad ahora viene de superficies y bordes,
             no de degradados o glows ambientales. -->

        <!-- Área principal -->
        <Grid Grid.Column="1">
            <Frame x:Name="ContentFrame" />
        </Grid>

        <!-- Actualización disponible / progreso -->
        <Grid
            x:Name="UpdateModalOverlay"
            Grid.ColumnSpan="2"
            Canvas.ZIndex="200"
            Visibility="Collapsed">

            <Border
                Background="{StaticResource BandaPopupBackdropBrush}"
                Tapped="UpdateModalBackdrop_Tapped" />

            <Border
                Width="680"
                MaxHeight="720"
                Style="{StaticResource BandaPopupCardStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <Grid RowSpacing="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="46"
                            Height="46"
                            CornerRadius="14"
                            Background="{StaticResource BandaAccentSoftBrush}">
                            <TextBlock
                                Text="↻"
                                Foreground="{StaticResource BandaAccentBrush}"
                                FontSize="20"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="UpdateModalTitleText"
                                Text="Actualización disponible"
                                Foreground="{StaticResource BandaTextBrush}"
                                FontSize="22"
                                FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="UpdateModalSubtitleText"
                                Text="Hay una nueva versión de BandaNV lista para instalar."
                                Foreground="{StaticResource BandaMutedBrush}"
                                FontSize="13"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            x:Name="UpdateModalCloseButton"
                            Grid.Column="2"
                            Content="×"
                            Click="UpdateModalCloseButton_Click"
                            Style="{StaticResource BandaPopupCloseButtonStyle}"
                            VerticalAlignment="Top" />
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        ColumnSpacing="12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Padding="14"
                            CornerRadius="14"
                            Background="{StaticResource BandaCardBrush}"
                            BorderBrush="{StaticResource BandaBorderBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Text="VERSIÓN INSTALADA"
                                    Style="{StaticResource BandaLabelTextStyle}"
                                    FontSize="10" />
                                <TextBlock
                                    x:Name="UpdateInstalledVersionText"
                                    Text="v2.0"
                                    Foreground="{StaticResource BandaTextBrush}"
                                    FontSize="18"
                                    FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Padding="14"
                            CornerRadius="14"
                            Background="{StaticResource BandaAccentFaintBrush}"
                            BorderBrush="{StaticResource BandaBorderStrongBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Text="VERSIÓN DISPONIBLE"
                                    Style="{StaticResource BandaLabelTextStyle}"
                                    FontSize="10" />
                                <TextBlock
                                    x:Name="UpdateAvailableVersionText"
                                    Text="v2.0.1"
                                    Foreground="{StaticResource BandaAccentBrush}"
                                    FontSize="18"
                                    FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border
                        x:Name="UpdateNotesPanel"
                        Grid.Row="2"
                        Padding="16"
                        CornerRadius="16"
                        Background="{StaticResource BandaCardBrush}"
                        BorderBrush="{StaticResource BandaBorderBrush}"
                        BorderThickness="1">

                        <StackPanel Spacing="10">
                            <TextBlock
                                Text="NOVEDADES"
                                Style="{StaticResource BandaLabelTextStyle}"
                                FontSize="11" />

                            <ScrollViewer
                                MaxHeight="260"
                                VerticalScrollMode="Auto"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Disabled"
                                HorizontalScrollBarVisibility="Disabled">
                                <TextBlock
                                    x:Name="UpdateReleaseNotesText"
                                    Text=""
                                    Foreground="{StaticResource BandaMutedStrongBrush}"
                                    FontSize="13"
                                    LineHeight="20"
                                    TextWrapping="Wrap" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="UpdateProgressPanel"
                        Grid.Row="3"
                        Padding="16"
                        CornerRadius="16"
                        Background="{StaticResource BandaCardBrush}"
                        BorderBrush="{StaticResource BandaBorderBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed">

                        <StackPanel Spacing="10">
                            <TextBlock
                                x:Name="UpdateProgressStateText"
                                Text="Preparando descarga..."
                                Foreground="{StaticResource BandaMutedStrongBrush}"
                                FontSize="13"
                                TextWrapping="Wrap" />

                            <ProgressBar
                                x:Name="UpdateProgressBar"
                                Minimum="0"
                                Maximum="100"
                                Value="0"
                                Height="6"
                                Foreground="{StaticResource BandaAccentBrush}" />
                        </StackPanel>
                    </Border>

                    <Grid
                        Grid.Row="4"
                        ColumnSpacing="10">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">

                            <ToggleSwitch
                                x:Name="UpdateStartupNoticeToggle"
                                IsOn="True"
                                Toggled="UpdateStartupNoticeToggle_Toggled"
                                VerticalAlignment="Center" />

                            <TextBlock
                                Text="Mostrar aviso al iniciar"
                                Foreground="{StaticResource BandaMutedStrongBrush}"
                                FontSize="12"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <Button
                            x:Name="UpdateModalSecondaryButton"
                            Grid.Column="1"
                            Content="Más tarde"
                            Click="UpdateModalSecondaryButton_Click"
                            Style="{StaticResource BandaPopupSecondaryButtonStyle}" />

                        <Button
                            x:Name="UpdateModalPrimaryButton"
                            Grid.Column="2"
                            Content="Actualizar"
                            Click="UpdateModalPrimaryButton_Click"
                            Style="{StaticResource BandaPopupPrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
