<Application
    x:Class="BandaNV.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- BandaNV v2.0 visual system
                 Primario = atmósfera/superficies.
                 Secundario = interacción/selección. -->
            <SolidColorBrush x:Key="BandaPrimaryColorBrush" Color="#123A34" />
            <SolidColorBrush x:Key="BandaSecondaryColorBrush" Color="#4FE0C6" />

            <!-- Superficies tonales derivadas del primario; sin degradados globales. -->
            <SolidColorBrush x:Key="BandaBackgroundBrush" Color="#080E10" />
            <SolidColorBrush x:Key="BandaAppBackgroundGradient" Color="#080E10" />
            <SolidColorBrush x:Key="BandaSidebarBrush" Color="#0A1214" />
            <SolidColorBrush x:Key="BandaSidebarGradientBrush" Color="#0A1214" />
            <SolidColorBrush x:Key="BandaCardBrush" Color="#111A1B" />
            <SolidColorBrush x:Key="BandaCardAltBrush" Color="#142020" />
            <SolidColorBrush x:Key="BandaSurfaceBrush" Color="#111A1B" />
            <SolidColorBrush x:Key="BandaSurfaceAltBrush" Color="#142020" />
            <SolidColorBrush x:Key="BandaNavIconBrush" Color="#182424" />
            <SolidColorBrush x:Key="BandaPopupSurfaceBrush" Color="#0E1718" />
            <SolidColorBrush x:Key="BandaBorderBrush" Color="#35474446" />
            <SolidColorBrush x:Key="BandaBorderStrongBrush" Color="#5A536461" />

            <!-- El secundario concentra acciones, selección y estados activos. -->
            <SolidColorBrush x:Key="BandaAccentBrush" Color="#4FE0C6" />
            <SolidColorBrush x:Key="BandaAccentSoftBrush" Color="#244FE0C6" />
            <SolidColorBrush x:Key="BandaAccentFaintBrush" Color="#124FE0C6" />
            <SolidColorBrush x:Key="BandaSecondaryAccentBrush" Color="#67E7D2" />
            <SolidColorBrush x:Key="BandaNavActiveBrush" Color="#224FE0C6" />
            <SolidColorBrush x:Key="BandaAccentGradientBrush" Color="#4FE0C6" />
            <SolidColorBrush x:Key="BandaAccentCardBrush" Color="#172B28" />

            <!-- Estados de interacción derivados del secundario. -->
            <SolidColorBrush x:Key="BandaActionHoverBrush" Color="#67E7D2" />
            <SolidColorBrush x:Key="BandaActionPressedBrush" Color="#39B9A7" />
            <SolidColorBrush x:Key="BandaActionForegroundBrush" Color="#07110F" />

            <!-- Colores escalares para controles que crean brushes locales.
                 Al navegar a una página nueva toman los valores secundarios actuales. -->
            <Color x:Key="BandaActionBaseColor">#FF4FE0C6</Color>
            <Color x:Key="BandaActionHoverColor">#FF67E7D2</Color>
            <Color x:Key="BandaActionPressedColor">#FF39B9A7</Color>
            <Color x:Key="BandaActionForegroundColor">#FF07110F</Color>
            <Color x:Key="BandaSelectionColor">#244FE0C6</Color>
            <Color x:Key="BandaSelectionHoverColor">#304FE0C6</Color>

            <SolidColorBrush x:Key="BandaActionDisabledBackgroundBrush" Color="#151D262F" />
            <SolidColorBrush x:Key="BandaActionDisabledForegroundBrush" Color="#65747D" />
            <SolidColorBrush x:Key="BandaActionDisabledBorderBrush" Color="#35424E59" />

            <!-- ToggleSwitch: ON siempre usa el color secundario. -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#4FE0C6" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#67E7D2" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#39B9A7" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#4FE0C6" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#67E7D2" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#39B9A7" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#07110F" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#07110F" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#07110F" />

            <SolidColorBrush x:Key="BandaTextBrush" Color="#F5F8FA" />
            <SolidColorBrush x:Key="BandaMutedBrush" Color="#93A1AA" />
            <SolidColorBrush x:Key="BandaMutedStrongBrush" Color="#C1CBD1" />

            <!-- Semánticos: independientes de la personalización. -->
            <SolidColorBrush x:Key="BandaPopupBackdropBrush" Color="#B3080C11" />
            <SolidColorBrush x:Key="BandaDangerBrush" Color="#FF7B7B" />
            <SolidColorBrush x:Key="BandaDangerSoftBrush" Color="#24FF7B7B" />

            <!--
                Estándar global para cualquier popup/submenú nuevo.
                Usar BandaPopupCardStyle + backdrop para modales y
                BandaSelectorButtonStyle + BandaPopupFlyoutPresenterStyle para selectores.
            -->
            <Style x:Key="BandaPopupFlyoutPresenterStyle" TargetType="FlyoutPresenter">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="16" />
            </Style>

            <!-- Menú contextual estilo Explorador: hover secundario y texto negro. -->
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{StaticResource BandaActionHoverColor}" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{StaticResource BandaActionPressedColor}" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#07110F" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#07110F" />

            <Style x:Key="BandaContextMenuPresenterStyle" TargetType="MenuFlyoutPresenter">
                <Setter Property="Padding" Value="6" />
                <Setter Property="MinWidth" Value="232" />
                <Setter Property="Background" Value="{StaticResource BandaPopupSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BandaBorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>

            <Style x:Key="BandaContextMenuItemStyle" TargetType="MenuFlyoutItem">
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource BandaTextBrush}" />
                <Setter Property="CornerRadius" Value="9" />
            </Style>

            <Style x:Key="BandaPopupOptionButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource BandaTextBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="BandaSelectorButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="Background" Value="{StaticResource BandaCardAltBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BandaBorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource BandaTextBrush}" />
            </Style>

            <Style x:Key="BandaCompactSelectorButtonStyle" TargetType="Button">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{StaticResource BandaCardAltBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BandaBorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource BandaTextBrush}" />
            </Style>

            <Style x:Key="BandaPopupCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="26" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="Background" Value="{StaticResource BandaPopupSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BandaBorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="BandaPopupCloseButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Background" Value="{StaticResource BandaCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BandaBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource BandaMutedStrongBrush}" />
                <Setter Property="FontSize" Value="20" />
            </Style>

            <Style x:Key="BandaPopupPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="18,9" />
                <Setter Property="MinWidth" Value="118" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="Background" Value="{StaticResource BandaAccentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource BandaActionForegroundBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="BandaPopupSecondaryButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="16,9" />
                <Setter Property="MinWidth" Value="92" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="Background" Value="{StaticResource BandaCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BandaBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource BandaTextBrush}" />
            </Style>

            <Style x:Key="BandaPopupGhostButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource BandaBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource BandaMutedStrongBrush}" />
            </Style>

            <Style x:Key="BandaPopupDangerButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="18,9" />
                <Setter Property="MinWidth" Value="105" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="Background" Value="{StaticResource BandaDangerBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#160909" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="BandaCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BandaCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BandaBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="22" />
            </Style>

            <Style x:Key="BandaMetricCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BandaCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BandaBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="22" />
                <Setter Property="MinHeight" Value="142" />
            </Style>

            <Style x:Key="BandaNavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource BandaMutedStrongBrush}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="MinHeight" Value="50" />
                <Setter Property="Margin" Value="0,3" />
            </Style>

            <Style x:Key="BandaSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BandaTextBrush}" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- Escala tipográfica base: legibilidad primero, especialmente en pantallas 1440p/4K. -->
            <Style x:Key="BandaBodyTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BandaTextBrush}" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="BandaSecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BandaMutedStrongBrush}" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="BandaLabelTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BandaMutedBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="BandaMutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BandaMutedBrush}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
