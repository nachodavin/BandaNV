<Application
    x:Class="BandaNV.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- BandaNV v2.0 visual system -->
            <SolidColorBrush x:Key="BandaBackgroundBrush" Color="#090D12" />

            <!-- Gradient / translucent surfaces -->
            <SolidColorBrush x:Key="BandaSidebarBrush" Color="#E80A1015" />
            <SolidColorBrush x:Key="BandaCardBrush" Color="#C912191F" />
            <SolidColorBrush x:Key="BandaCardAltBrush" Color="#B8152224" />
            <SolidColorBrush x:Key="BandaSurfaceBrush" Color="#C912191F" />
            <SolidColorBrush x:Key="BandaSurfaceAltBrush" Color="#B8152224" />
            <SolidColorBrush x:Key="BandaBorderBrush" Color="#35424E59" />
            <SolidColorBrush x:Key="BandaBorderStrongBrush" Color="#5A4B5A66" />
            <SolidColorBrush x:Key="BandaAccentBrush" Color="#4FE0C6" />
            <SolidColorBrush x:Key="BandaAccentSoftBrush" Color="#244FE0C6" />
            <SolidColorBrush x:Key="BandaAccentFaintBrush" Color="#124FE0C6" />
            <SolidColorBrush x:Key="BandaSecondaryAccentBrush" Color="#53A9FF" />
            <SolidColorBrush x:Key="BandaTextBrush" Color="#F5F8FA" />
            <SolidColorBrush x:Key="BandaMutedBrush" Color="#93A1AA" />
            <SolidColorBrush x:Key="BandaMutedStrongBrush" Color="#C1CBD1" />
            <SolidColorBrush x:Key="BandaNavActiveBrush" Color="#224FE0C6" />
            <SolidColorBrush x:Key="BandaNavIconBrush" Color="#151D262F" />

            <LinearGradientBrush x:Key="BandaAppBackgroundGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#060A0E" Offset="0" />
                <GradientStop Color="#091015" Offset="0.28" />
                <GradientStop Color="#0D1B1D" Offset="0.52" />
                <GradientStop Color="#123A34" Offset="0.72" />
                <GradientStop Color="#091316" Offset="0.88" />
                <GradientStop Color="#05080B" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="BandaSidebarGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F20A0F14" Offset="0" />
                <GradientStop Color="#E50B1518" Offset="0.62" />
                <GradientStop Color="#D90C1C1C" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="BandaGlowGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#004FE0C6" Offset="0" />
                <GradientStop Color="#704FE0C6" Offset="0.48" />
                <GradientStop Color="#254FE0C6" Offset="0.74" />
                <GradientStop Color="#004FE0C6" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="BandaAccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#4FE0C6" Offset="0" />
                <GradientStop Color="#39B9A7" Offset="0.62" />
                <GradientStop Color="#1E7A70" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="BandaAccentCardBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2B4FE0C6" Offset="0" />
                <GradientStop Color="#F0161D25" Offset="0.56" />
                <GradientStop Color="#E7121720" Offset="1" />
            </LinearGradientBrush>

            <Style x:Key="BandaCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BandaCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BandaBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="22" />
            </Style>

            <Style x:Key="BandaMetricCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BandaCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BandaBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="22" />
                <Setter Property="MinHeight" Value="142" />
            </Style>

            <Style x:Key="BandaNavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource BandaMutedStrongBrush}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="MinHeight" Value="50" />
                <Setter Property="Margin" Value="0,3" />
            </Style>

            <Style x:Key="BandaSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BandaTextBrush}" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- Escala tipográfica base: legibilidad primero, especialmente en pantallas 1440p/4K. -->
            <Style x:Key="BandaBodyTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BandaTextBrush}" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="BandaSecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BandaMutedStrongBrush}" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="BandaLabelTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BandaMutedBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="BandaMutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BandaMutedBrush}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
