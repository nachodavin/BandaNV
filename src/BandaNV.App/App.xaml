<Application
    x:Class="BandaNV.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="BandaBackgroundBrush" Color="#101417" />
            <SolidColorBrush x:Key="BandaSurfaceBrush" Color="#171D21" />
            <SolidColorBrush x:Key="BandaSurfaceAltBrush" Color="#1D252A" />
            <SolidColorBrush x:Key="BandaBorderBrush" Color="#2C373D" />
            <SolidColorBrush x:Key="BandaAccentBrush" Color="#48D6C0" />
            <SolidColorBrush x:Key="BandaTextBrush" Color="#F4F7F8" />
            <SolidColorBrush x:Key="BandaMutedBrush" Color="#9AA8AF" />

            <Style x:Key="BandaCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BandaSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BandaBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="BandaSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BandaTextBrush}" />
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="BandaMutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BandaMutedBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
